<Window x:Class="ACPAMS.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ACPAMS.ViewModels"
        mc:Ignorable="d"
        Title="AI-CAMS Workstation &amp; Database Setup Wizard"
        Width="820"
        Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:SetupWizardViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#0F172A"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#475569"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#2563EB"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#16A34A"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#DC2626"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEE2E2"/>

        <Style x:Key="Input.Field" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input.Password" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Secondary" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Card -->
    <Border Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Medium}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title / Header Bar -->
                <RowDefinition Height="Auto"/> <!-- Steps Progress Bar -->
                <RowDefinition Height="*"/>    <!-- Step Content (Step 1 or 2) -->
                <RowDefinition Height="Auto"/> <!-- Navigation / Footer Bar -->
            </Grid.RowDefinitions>

            <!-- ── Top Title Bar ────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="#0F172A"
                    CornerRadius="10,10,0,0"
                    Padding="20,14"
                    MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Accent.Primary}" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                            <TextBlock Text="⚙" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AI-CAMS Workstation &amp; Database Setup"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="15"/>
                            <TextBlock Text="Initial deployment &amp; institutional policy configuration wizard"
                                       Foreground="#94A3B8"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding CancelCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#94A3B8"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Padding="8,4"
                            Content="✕">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Step Breadcrumbs / Progress ──────────────────────────── -->
            <Border Grid.Row="1" Background="{StaticResource Bg.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="24,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Step 1 Indicator -->
                        <Border CornerRadius="12" Padding="12,5" Margin="0,0,16,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="1" FontWeight="Bold" FontSize="12" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Database &amp; Workstation Role" FontWeight="SemiBold" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="→" Foreground="{StaticResource Text.Muted}" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <!-- Step 2 Indicator -->
                        <Border CornerRadius="12" Padding="12,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="2" FontWeight="Bold" FontSize="12" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Policies &amp; Academic Compliance" FontWeight="SemiBold" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Main Content Area ────────────────────────────────────── -->
            <Grid Grid.Row="2" Margin="24,16">

                <!-- ════════ STEP 1: DATABASE & ROLE CONFIGURATION ════════ -->
                <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Role Selection -->
                        <RowDefinition Height="Auto"/> <!-- Connection Fields -->
                        <RowDefinition Height="*"/>    <!-- Diagnostics Feedback -->
                    </Grid.RowDefinitions>

                    <!-- Workstation Role Selector -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Select Workstation Role" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text.Primary}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Role 1: Instructor Host -->
                            <RadioButton Grid.Column="0"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding IsInstructorHost, Mode=TwoWay}"
                                         Command="{Binding SelectHostRoleCommand}"
                                         Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card"
                                                Background="#FFFFFF"
                                                BorderBrush="{StaticResource Border.Medium}"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🖥" FontSize="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Instructor Host / Server" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Runs SQL Server locally for this testing room. Hosts exam databases and proctoring logs."
                                                           FontSize="11" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Role 2: Student Client Workstation -->
                            <RadioButton Grid.Column="2"
                                         GroupName="RoleGroup"
                                         IsChecked="{Binding IsStudentClient, Mode=TwoWay}"
                                         Command="{Binding SelectClientRoleCommand}"
                                         Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card"
                                                Background="#FFFFFF"
                                                BorderBrush="{StaticResource Border.Medium}"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎓" FontSize="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Student Workstation (Client)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Connects to the instructor's host computer over the local laboratory Wi-Fi / LAN."
                                                           FontSize="11" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </Grid>
                    </StackPanel>

                    <!-- Connection Parameters -->
                    <Border Grid.Row="1" Background="{StaticResource Bg.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Server and Database -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SQL Server Host / IP Address" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Field}"/>
                                    <TextBlock Text="e.g. localhost\SQLEXPRESS or 192.168.1.100\SQLEXPRESS" FontSize="10" Foreground="{StaticResource Text.Muted}" Margin="2,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Database Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Field}"/>
                                    <TextBlock Text="Default: aicams" FontSize="10" Foreground="{StaticResource Text.Muted}" Margin="2,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Authentication Mode -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="Windows Authentication"
                                                 IsChecked="{Binding IsWindowsAuth, Mode=TwoWay}"
                                                 FontSize="12" Foreground="{StaticResource Text.Primary}" Margin="0,0,16,0"/>
                                    <RadioButton Content="SQL Server Authentication"
                                                 IsChecked="{Binding IsSqlAuth, Mode=OneWay}"
                                                 FontSize="12" Foreground="{StaticResource Text.Primary}"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2"
                                          IsChecked="{Binding TrustServerCertificate, Mode=TwoWay}"
                                          Content="Trust Server Certificate (Recommended for lab networks)"
                                          FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Row 3: SQL Credentials (if SQL Auth) -->
                            <Grid Grid.Row="2" Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SQL Username" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Field}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SQL Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged" Style="{StaticResource Input.Password}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 2: Diagnostics & Feedback -->
                    <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="8" Padding="14,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTestSuccess}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Status.SuccessBg}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasTested}" Value="True"/>
                                            <Condition Binding="{Binding IsTestSuccess}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TestResultMessage}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTestSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasTested}" Value="True"/>
                                                        <Condition Binding="{Binding IsTestSuccess}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding TroubleshootingHint}"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding TroubleshootingHint, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="Click 'Test Connection' to verify SQL Server reachability before continuing."
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           Visibility="{Binding HasTested, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTested}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource Btn.Secondary}"
                                    Height="36"
                                    Padding="14,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Test Connection"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>


                <!-- ════════ STEP 2: POLICIES & ACADEMIC COMPLIANCE ════════ -->
                <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title / Intro -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Policy Cards -->
                        <RowDefinition Height="Auto"/> <!-- Checkboxes -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="AI-CAMS Operational Policies &amp; Academic Compliance"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="Please review and accept the following operational guidelines before deploying this workstation."
                                   FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Scrollable Policy Content -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Bg.Base}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">

                                <!-- Policy 1: Vision Monitoring -->
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                                <TextBlock Text="📷 Policy 1" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Accent.Primary}"/>
                                            </Border>
                                            <TextBlock Text="Vision Monitoring &amp; Privacy Safeguards" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="AI-CAMS utilizes real-time webcam frame processing strictly for behavioral monitoring (face detection, gaze tracking, and presence logging) during active exam sessions. No continuous video feed is saved to cloud servers. Only lightweight facial landmark metrics and timestamped anomaly snapshots are stored on the institutional host server for instructor verification."
                                                   FontSize="12"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Policy 2: Kiosk-Mode Lockdown -->
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                                <TextBlock Text="🔒 Policy 2" FontWeight="Bold" FontSize="11" Foreground="#B45309"/>
                                            </Border>
                                            <TextBlock Text="Kiosk-Mode Lockdown &amp; OS Controls" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="During active testing, AI-CAMS enforces system-level lockdown by suppressing task-switching shortcuts (including Alt+Tab, Alt+F4, and Windows Key) and disabling clipboard operations. By proceeding, you authorize the application to execute low-level keyboard hooks on this workstation."
                                                   FontSize="12"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Policy 3: Local Network & AI Transmission -->
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#DCFCE7" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                                <TextBlock Text="🌐 Policy 3" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Status.Success}"/>
                                            </Border>
                                            <TextBlock Text="Local Network &amp; AI Data Transmission" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="All exam attempts and student records remain on the local laboratory host database. Outbound internet connectivity is used solely for secure, encrypted requests to the cloud AI evaluation model for grading assistance. Final academic judgment and grade overrides remain solely under the instructor's discretion."
                                                   FontSize="12"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Acceptance Checkboxes -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Mandatory Compliance Acceptances:" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Text.Primary}"/>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding AcceptAllPoliciesCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource Accent.Primary}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Content="✓ Toggle / Accept All"/>
                        </Grid>

                        <CheckBox IsChecked="{Binding IsCameraPolicyAccepted, Mode=TwoWay}"
                                  Margin="0,0,0,6"
                                  Cursor="Hand">
                            <TextBlock Text="I accept the Camera &amp; Computer Vision Privacy Policy."
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding IsKioskPolicyAccepted, Mode=TwoWay}"
                                  Margin="0,0,0,6"
                                  Cursor="Hand">
                            <TextBlock Text="I authorize Kiosk-mode OS restrictions and low-level keyboard hooks on this computer."
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding IsGradingPolicyAccepted, Mode=TwoWay}"
                                  Cursor="Hand">
                            <TextBlock Text="I acknowledge that final assessment scores and overrides remain solely with the instructor."
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ── Bottom Navigation / Action Bar ──────────────────────── -->
            <Border Grid.Row="3"
                    Background="{StaticResource Bg.Base}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back Button (on Step 2) or Cancel (on Step 1) -->
                    <Button Grid.Column="0"
                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}"
                            Command="{Binding GoToStep1Command}"
                            Style="{StaticResource Btn.Secondary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="←" Margin="0,0,6,0"/>
                            <TextBlock Text="Back to Database Settings"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="0"
                            Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource Btn.Secondary}"
                            Content="Cancel &amp; Exit"/>

                    <!-- Middle: Status / Progress Text -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent.Primary}"/>
                    </StackPanel>

                    <!-- Right: Next Step (on Step 1) or Save & Launch (on Step 2) -->
                    <Button Grid.Column="2"
                            Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}"
                            Command="{Binding GoToStep2Command}"
                            Style="{StaticResource Btn.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next: Review Policies"/>
                            <TextBlock Text=" →" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}"
                            Command="{Binding SaveAndLaunchCommand}"
                            Style="{StaticResource Btn.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" Margin="0,0,6,0"/>
                            <TextBlock Text="Save &amp; Launch AI-CAMS"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

