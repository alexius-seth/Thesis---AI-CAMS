<Window x:Class="ACPAMS.Views.Faculty.ArchivedExamPickerModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reuse Questions from Archived Exam"
        Width="920"
        Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#0F172A"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#475569"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="#1976D2"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Secondary" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#475569"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.SmallAction" TargetType="Button">
            <Setter Property="Background"      Value="#EFF6FF"/>
            <Setter Property="Foreground"      Value="#1976D2"/>
            <Setter Property="BorderBrush"     Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Close" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer card container with shadow -->
    <Border Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A"
                              Opacity="0.22"
                              BlurRadius="28"
                              ShadowDepth="8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="24,16,18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Border Background="{StaticResource Accent.PrimaryBg}"
                                    CornerRadius="6"
                                    Padding="6,3"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Accent.Primary}"/>
                            </Border>
                            <TextBlock Text="Reuse Questions from Archived Exam"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Browse previous archived assessments, selectively pick questions and rubrics to clone, and modify them in draft mode."
                                   FontSize="12"
                                   Foreground="{StaticResource Text.Muted}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Click="OnCloseClicked"
                            Style="{StaticResource Btn.Close}"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource Text.Muted}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT BODY (SPLIT VIEW) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: ARCHIVED EXAMS LIST -->
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Row="0" Padding="14,12,14,10" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
                            <TextBox x:Name="SearchExamsBox"
                                     TextChanged="SearchExamsBox_TextChanged"
                                     Height="34"
                                     FontSize="12"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource Border.Medium}"
                                     BorderThickness="1"
                                     Background="White"
                                     Tag="Search by course or exam name..."/>
                        </Border>

                        <!-- Exam Cards List -->
                        <ListBox Grid.Row="1"
                                 x:Name="ArchivedExamsListBox"
                                 SelectionChanged="ArchivedExamsListBox_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="White"
                                                        BorderBrush="{StaticResource Border.Subtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,10"
                                                        Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CourseCode}"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource Accent.Primary}"/>
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource Status.WarningBg}"
                                                    CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="ARCHIVED" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource Status.Warning}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding ExamName}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SectionScheduleDisplay}"
                                                   FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Questions.Count, StringFormat='{}{0} questions available'}"
                                                   FontSize="11" Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- RIGHT PANE: QUESTION PICKER & METADATA -->
                <Grid Grid.Column="1">
                    <!-- Placeholder when no exam selected -->
                    <Border x:Name="NoSelectionPlaceholder"
                            Background="White"
                            Visibility="Visible"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="44"
                                       Foreground="{StaticResource Border.Medium}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Select an Archived Exam"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Choose an assessment from the left panel to browse its questions."
                                       FontSize="12" Foreground="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Details & Questions View -->
                    <Grid x:Name="ExamDetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cloned Exam Academic Metadata Controls -->
                        <Border Grid.Row="0"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Padding="20,12">
                            <StackPanel>
                                <TextBlock Text="CLONED ASSESSMENT METADATA"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource Text.Muted}"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="New Exam Code" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NewExamCodeBox" Height="32" FontSize="12" Padding="8,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Target Section" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NewSectionBox" Height="32" FontSize="12" Padding="8,0" VerticalContentAlignment="Center" Text="BSCS 3-B"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Class Schedule" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NewScheduleBox" Height="32" FontSize="12" Padding="8,0" VerticalContentAlignment="Center" Text="TTH 1:00PM - 3:00PM"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Academic Year" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NewAcademicYearBox" Height="32" FontSize="12" Padding="8,0" VerticalContentAlignment="Center" Text="2026-2027"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Semester" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="NewSemesterBox" Height="32" FontSize="12" VerticalContentAlignment="Center" SelectedIndex="0">
                                            <ComboBoxItem Content="1st Semester"/>
                                            <ComboBoxItem Content="2nd Semester"/>
                                            <ComboBoxItem Content="Summer"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Question Selection Bar -->
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Padding="20,10"
                                Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Select Questions to Clone"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource Text.Primary}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="SelectionCountText"
                                               Text="(0 selected)"
                                               FontSize="12" Foreground="{StaticResource Text.Muted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SelectAllBtn"
                                            Click="SelectAll_Click"
                                            Content="Select All"
                                            Style="{StaticResource Btn.SmallAction}"
                                            Margin="0,0,6,0"/>
                                    <Button x:Name="DeselectAllBtn"
                                            Click="DeselectAll_Click"
                                            Content="Deselect All"
                                            Style="{StaticResource Btn.SmallAction}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Questions List -->
                        <ScrollViewer Grid.Row="2"
                                      Padding="20,12"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="QuestionsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="{StaticResource Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Checkbox -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Click="QuestionCheckBox_Click"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"/>

                                                <!-- Question Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding QuestionTypeDisplay}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource Text.Secondary}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource Accent.PrimaryBg}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Points, StringFormat='{}{0} pts'}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource Accent.Primary}"/>
                                                        </Border>
                                                        <Border Background="#F5F3FF" CornerRadius="4" Padding="6,2"
                                                                Visibility="{Binding HasRubric, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Rubric Included"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="#7C3AED"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Text}"
                                                               FontSize="12" Foreground="{StaticResource Text.Primary}"
                                                               TextWrapping="Wrap" MaxHeight="40"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Order Tag -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding OrderIndex, StringFormat='#{0}'}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text.Muted}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Padding="24,14"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterSummaryText"
                               Text="Select questions to clone into draft mode."
                               FontSize="12" Foreground="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Click="OnCloseClicked"
                                Content="Cancel"
                                Style="{StaticResource Btn.Secondary}"
                                Margin="0,0,10,0"/>
                        <Button x:Name="CloneBtn"
                                Click="CloneBtn_Click"
                                Content="Clone &amp; Edit Questions"
                                Style="{StaticResource Btn.Primary}"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

