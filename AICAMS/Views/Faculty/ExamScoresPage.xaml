<UserControl x:Class="ACPAMS.Views.Faculty.ExamScoresPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- DESIGN TOKENS — this page keeps its own local copy, same as every
             other page in this project; do not assume styles here exist
             elsewhere, or vice versa. -->
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <Style x:Key="Btn.Outlined" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Small" TargetType="Button" BasedOn="{StaticResource Btn.Outlined}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MaxHeight="320"/>
        </Grid.RowDefinitions>

        <!-- Back button -->
        <Button Grid.Row="0" Style="{StaticResource Btn.Outlined}"
                Content="← Back" Click="BackButton_Click"
                HorizontalAlignment="Left" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,4">
            <TextBlock Text="EXAM SCORES" Style="{StaticResource T.SectionLabel}"/>
            <TextBlock x:Name="ExamTitleText" Text="—"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource Text.Primary}"
                       Margin="0,4,0,20"/>
        </StackPanel>

        <!-- KPI summary row -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Total Test Takers" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TotalTestTakersValue" Text="0" Style="{StaticResource T.KpiNumber}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Average Score" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="AverageScoreValue" Text="—" Style="{StaticResource T.KpiNumber}"/>
                    <TextBlock x:Name="AverageScoreSub" Text="No finalized scores yet"
                               FontSize="11" Foreground="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="UnfinalizedCard" Grid.Column="4" Style="{StaticResource Card}" Padding="18,14"
                    BorderBrush="{StaticResource Status.Warning}">
                <StackPanel>
                    <TextBlock Text="Not Yet Finalized" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="UnfinalizedValue" Text="0"
                               Style="{StaticResource T.KpiNumber}"
                               Foreground="{StaticResource Status.Warning}"/>
                    <TextBlock Text="Click a row's Review button to finish grading"
                               FontSize="11" Foreground="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Scores table -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Bg.TableHeader}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1" Padding="16,10">
                    <TextBlock Text="STUDENT SCORES" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Text.Secondary}"/>
                </Border>

                <DataGrid x:Name="ScoresGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          Background="{StaticResource Bg.Surface}"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          RowHeight="44"
                          FontSize="13"
                          AlternationCount="2">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource Bg.Surface}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FAFBFC"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Bg.TableHeader}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource Bg.TableHeader}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <!-- Student name — always column 0 -->
                        <DataGridTextColumn Header="STUDENT" Binding="{Binding StudentName}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Section columns get inserted here at runtime, between
                             Student (index 0) and Total (index below) -->

                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalScoreText}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalScoreText}" Value="Pending">
                                            <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="STATUS / ACTION" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Background="{StaticResource Status.SuccessBg}"
                                                BorderBrush="{StaticResource Status.Success}"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="8,3" HorizontalAlignment="Left"
                                                Visibility="{Binding IsFinalized, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Finalized" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Status.Success}"/>
                                        </Border>
                                        <Button Content="Review in Grading"
                                                Click="ReviewInGrading_Click"
                                                Tag="{Binding AttemptId}"
                                                HorizontalAlignment="Left">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Small}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFinalized}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Answer detail panel — appears when a student row is clicked.
             Collapsed by default; shows a hint instead until then. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Bg.TableHeader}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1" Padding="16,10">
                    <TextBlock x:Name="AnswerDetailHeaderText"
                               Text="ANSWER DETAIL — click a student row above to view their full answers"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Text.Secondary}"/>
                </Border>

                <ScrollViewer Grid.Row="1" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AnswerDetailList" Margin="16,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent.Primary}">
                                                <Run Text="Q"/><Run Text="{Binding QuestionNumber}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding QuestionType}"
                                                       FontSize="11" Foreground="{StaticResource Text.Muted}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding QuestionText}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                                        <TextBlock FontSize="12" Foreground="{StaticResource Text.Secondary}"
                                                   TextWrapping="Wrap" Margin="0,0,0,3">
                                            <Run Text="Student answer: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding StudentAnswerText}"/>
                                        </TextBlock>

                                        <TextBlock FontSize="12" Foreground="{StaticResource Status.Success}"
                                                   TextWrapping="Wrap" Margin="0,0,0,3"
                                                   Visibility="{Binding IsObjective, Converter={StaticResource BoolToVis}}">
                                            <Run Text="Correct answer: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding CorrectAnswerText}"/>
                                        </TextBlock>

                                        <TextBlock FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Text.Primary}">
                                            <Run Text="Points: "/>
                                            <Run Text="{Binding ObtainedPoints}"/><Run Text=" / "/><Run Text="{Binding MaxPoints}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>
