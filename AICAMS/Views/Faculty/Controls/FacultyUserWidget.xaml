<UserControl x:Class="ACPAMS.Views.Faculty.Controls.FacultyUserWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Text.Primary"   Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"     Color="#94A3B8"/>
        <SolidColorBrush x:Key="Border.Subtle"  Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Accent.Primary" Color="#1976D2"/>

        <Style x:Key="Btn.Icon" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Subtle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="16,12"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal">
            <!-- Avatar / Fallback Initials Circle -->
            <Border Width="34" Height="34"
                    CornerRadius="17"
                    Background="#E2E8F0"
                    Margin="0,0,6,0"
                    ClipToBounds="True">
                <Grid>
                    <!-- Photo Brush when available -->
                    <Border x:Name="SidebarAvatarImageBorder" CornerRadius="17">
                        <Border.Background>
                            <ImageBrush x:Name="SidebarAvatarBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <!-- Fallback Initials -->
                    <TextBlock x:Name="SidebarInitialsText"
                               Text="IN"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Settings Button -->
            <Button Style="{StaticResource Btn.Icon}" Margin="0,0,4,0" Click="OpenSettings_Click" ToolTip="Faculty Settings">
                <TextBlock Text="&#xE713;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{StaticResource Text.Secondary}"/>
            </Button>

            <!-- Notification Bell & Flyout -->
            <Grid>
                <Button x:Name="BellButton"
                        Style="{StaticResource Btn.Icon}"
                        Click="BellButton_Click"
                        ToolTip="Notifications">
                    <TextBlock Text="&#xEA8F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource Text.Secondary}"/>
                </Button>
                <Border x:Name="BellBadge"
                        Width="18" Height="18" CornerRadius="9"
                        Background="#E53E3E"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-4,-4,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="BellBadgeCount"
                               Text="0"
                               FontSize="9" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Notification Flyout Popup -->
                <Popup x:Name="NotificationPopup"
                       PlacementTarget="{Binding ElementName=BellButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Width="360" MaxHeight="450"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,8,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.15"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="Notifications" FontWeight="Bold" FontSize="13" Foreground="#1A202C" VerticalAlignment="Center"/>
                                    <Button Content="Mark all as read"
                                            Style="{StaticResource Btn.Subtle}"
                                            FontSize="11"
                                            Padding="8,4"
                                            HorizontalAlignment="Right"
                                            Click="MarkAllNotificationsAsRead_Click"/>
                                </DockPanel>
                            </Border>

                            <!-- List of Notifications -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                                <StackPanel x:Name="NotificationItemsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

