<Window x:Class="ACPAMS.Views.Faculty.PublishConfirmModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publish Exam"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- DESIGN TOKENS -->
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Overlay.Bg"       Color="#1A202C"/>

        <Style x:Key="Input.Field" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="Black"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#CBD5E1"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,10"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"               Value="False"/>
            <Setter Property="IsEnabled"                Value="True"/>
            <Setter Property="Focusable"                Value="True"/>
            <Setter Property="CaretBrush"               Value="#1976D2"/>
        </Style>

        <Style x:Key="Input.ComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="Black"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#CBD5E1"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- BUTTONS -->
        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="#1976D2"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Close" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Copy" TargetType="Button">
            <Setter Property="Background"      Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer card container with shadow -->
    <Border Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A"
                              Opacity="0.22"
                              BlurRadius="28"
                              ShadowDepth="8"/>
        </Border.Effect>

        <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- HEADER -->
                <Border BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="28,20,20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{StaticResource Accent.PrimaryBg}"
                                        CornerRadius="6"
                                        Padding="7,3"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72D;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource Accent.Primary}"/>
                                </Border>
                                <TextBlock Text="Finalize &amp; Publish Exam"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource Text.Primary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Please review and complete the academic information before publishing."
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Close -->
                        <Button Grid.Column="1"
                                x:Name="CloseBtn"
                                Click="OnCloseModalClicked"
                                Style="{StaticResource Btn.Close}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Text.Muted}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- FORM BODY -->
                <StackPanel Margin="28,18,28,0">

                    <!-- Row 1: Course Code + Time Limit -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <!-- Course Code -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Course Code"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="CourseCodeBox"
                                     FontSize="13"
                                     Foreground="Black"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Padding="12,10"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     Text="CCS415"/>
                        </StackPanel>

                        <!-- Time Limit -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Time Limit"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="TimeLimitBox"
                                         FontSize="13"
                                         Foreground="Black"
                                         Background="White"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         Padding="12,10"
                                         Height="40"
                                         VerticalContentAlignment="Center"
                                         Text="60"
                                         TextAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="{StaticResource Bg.Base}"
                                        BorderBrush="{StaticResource Border.Medium}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,6,6,0"
                                        Padding="10,0" Margin="-1,0,0,0">
                                    <TextBlock Text="min"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Generated Exam Code -->
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Generated Exam Code"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="GeneratedCodeBox"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Background="#EFF6FF"
                                         BorderBrush="#1976D2"
                                         BorderThickness="1"
                                         Padding="12,10"
                                         Height="40"
                                         VerticalContentAlignment="Center"
                                         IsReadOnly="True"
                                         Focusable="False"
                                         Text="Enter a course code to generate exam code"/>
                                <Border Grid.Column="1"
                                        Background="{StaticResource Accent.Primary}"
                                        CornerRadius="0,5,5,0"
                                        Margin="-1,1,1,1"
                                        Padding="10,0">
                                    <TextBlock Text="Read-only"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Copy button -->
                            <Button Grid.Column="2"
                                    x:Name="CopyBtn"
                                    Click="OnCopyExamCodeClicked"
                                    Style="{StaticResource Btn.Copy}"
                                    ToolTip="Copy exam code to clipboard">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="White"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Generation note -->
                    <Grid Margin="0,4,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,1,6,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Text="Exam code is automatically generated based on the course code."/>
                    </Grid>

                    <!-- Row 3: Exam Name -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Exam Name"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ExamNameBox"
                                 FontSize="13"
                                 Foreground="Black"
                                 Background="White"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 Text="Object-Oriented Programming Finals"/>
                    </StackPanel>

                    <!-- Row 4: Academic Year & Semester -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Academic Year -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Academic Year"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="AcademicYearBox"
                                     FontSize="13"
                                     Foreground="Black"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Padding="12,10"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     Text="2026-2027"/>
                        </StackPanel>

                        <!-- Semester -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Semester"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="SemesterComboBox"
                                      Style="{StaticResource Input.ComboBox}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="1st Semester"/>
                                <ComboBoxItem Content="2nd Semester"/>
                                <ComboBoxItem Content="Summer"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Row 5: Section & Class Schedule -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Section -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Section"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="SectionBox"
                                     FontSize="13"
                                     Foreground="Black"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Padding="12,10"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     Text="BSCS 3-A"/>
                        </StackPanel>

                        <!-- Class Schedule -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Class Schedule"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="ClassScheduleBox"
                                     FontSize="13"
                                     Foreground="Black"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Padding="12,10"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     Text="MWF 10:30AM - 12:00PM"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 5b: Scheduled Start & End Time -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Scheduled Start Time -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Scheduled Start (Date &amp; Time)"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="ScheduledStartDatePicker"
                                            Height="40"
                                            VerticalContentAlignment="Center"
                                            BorderBrush="#CBD5E1"/>
                                <TextBox Grid.Column="2"
                                         x:Name="ScheduledStartTimeBox"
                                         FontSize="12"
                                         Foreground="Black"
                                         Background="White"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         Padding="6,0"
                                         Height="40"
                                         VerticalContentAlignment="Center"
                                         Text="09:00"
                                         ToolTip="Start Time in 24h format (e.g. 09:00 or 14:30)"/>
                            </Grid>
                        </StackPanel>

                        <!-- Scheduled End Time -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Scheduled End (Date &amp; Time)"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="ScheduledEndDatePicker"
                                            Height="40"
                                            VerticalContentAlignment="Center"
                                            BorderBrush="#CBD5E1"/>
                                <TextBox Grid.Column="2"
                                         x:Name="ScheduledEndTimeBox"
                                         FontSize="12"
                                         Foreground="Black"
                                         Background="White"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         Padding="6,0"
                                         Height="40"
                                         VerticalContentAlignment="Center"
                                         Text="11:00"
                                         ToolTip="End Time in 24h format (e.g. 11:00 or 16:30)"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Row 5c: Auto-Archive Policy -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Auto-Archive Policy"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="AutoArchivePolicyComboBox"
                                  Style="{StaticResource Input.ComboBox}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="1 Hour after scheduled end (Recommended)"/>
                            <ComboBoxItem Content="2 Hours after scheduled end"/>
                            <ComboBoxItem Content="End of the Day (11:59 PM)"/>
                            <ComboBoxItem Content="Manual Archive Only (Do not auto-archive)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 6: Randomize Question Order -->
                    <Border Background="{StaticResource Bg.Base}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Randomize Question Order"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="Shuffle question sequence uniquely for each student attempt"
                                           FontSize="11" Foreground="{StaticResource Text.Muted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      x:Name="RandomizeQuestionsCheckBox"
                                      VerticalAlignment="Center"
                                      Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Row 7: Flexible Access Control (Whitelist & Approval Queue) -->
                    <Border Background="{StaticResource Bg.Base}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Require Teacher Approval for Off-Schedule Students"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="Enforces whitelist and real-time proctor approval queue for irregular students"
                                           FontSize="11" Foreground="{StaticResource Text.Muted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      x:Name="RequiresApprovalCheckBox"
                                      VerticalAlignment="Center"
                                      Cursor="Hand"/>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- FOOTER -->
                <Border BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="28,16">
                    <Button x:Name="PublishBtn"
                            Click="OnFinishAndPublishClicked"
                            Style="{StaticResource Btn.Primary}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72D;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="White"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Finish and Publish Exam"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
