<UserControl x:Class="ACPAMS.Views.Faculty.StudentInformationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <Style x:Key="Btn.TabLink" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="4,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,40">

            <Button Click="BackButton_Click"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,14"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Back"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Student" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,0,0,8"/>

            <!-- Mini tab strip — Information (this page) / Performance Report -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Information" Style="{StaticResource Btn.TabLink}"
                        Foreground="{StaticResource Accent.Primary}"
                        BorderBrush="{StaticResource Accent.Primary}"
                        Margin="0,0,20,0" IsEnabled="False"/>
                <Button Content="Performance Report" Style="{StaticResource Btn.TabLink}"
                        Click="GoToPerformanceReport_Click"/>
            </StackPanel>

            <!-- STUDENT PROFILE -->
            <TextBlock Text="STUDENT PROFILE" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="#EFF6FF" Margin="0,0,16,0">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{StaticResource Accent.Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StudentNameText" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock x:Name="ProgramText" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource Bg.TableHeader}"
                                    BorderBrush="{StaticResource Border.Medium}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock x:Name="StudentIdText" FontSize="11"
                                           Foreground="{StaticResource Text.Secondary}"/>
                            </Border>
                            <Border Background="{StaticResource Bg.TableHeader}"
                                    BorderBrush="{StaticResource Border.Medium}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="SectionText" FontSize="11"
                                           Foreground="{StaticResource Text.Secondary}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Student Lifecycle Status Badge -->
                        <Border x:Name="StudentStatusBadge"
                                BorderThickness="1" CornerRadius="12"
                                Padding="10,4" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StudentStatusBadgeText" Text="Active" FontSize="11" FontWeight="SemiBold"/>
                        </Border>

                        <Border x:Name="StandingBadge"
                                BorderThickness="1" CornerRadius="12"
                                Padding="10,4" Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StandingBadgeText" FontSize="11" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Reset Password Button -->
                        <Button x:Name="ResetPasswordBtn"
                                Content="Reset Password"
                                FontSize="12" FontWeight="SemiBold"
                                Background="#EFF6FF" Foreground="#1976D2"
                                BorderBrush="#BFDBFE" BorderThickness="1"
                                Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="ResetPasswordBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Remove / Deactivate Action Button -->
                        <Button x:Name="DeactivateStudentBtn"
                                Content="Remove / Deactivate"
                                FontSize="12" FontWeight="SemiBold"
                                Background="#FEF2F2" Foreground="#C62828"
                                BorderBrush="#FECACA" BorderThickness="1"
                                Padding="12,6" Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="DeactivateStudentBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HISTORICAL PERFORMANCE OVERVIEW -->
            <TextBlock Text="HISTORICAL PERFORMANCE OVERVIEW" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Aggregate Stats" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}" Margin="0,0,0,14"/>

                        <TextBlock Text="TOTAL ASSESSMENTS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Muted}"/>
                        <TextBlock x:Name="TotalAssessmentsValue" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}" Margin="0,2,0,2"/>
                        <TextBlock Text="Taken this academic term" FontSize="10"
                                   Foreground="{StaticResource Text.Muted}" Margin="0,0,0,14"/>

                        <TextBlock Text="OVERALL AVERAGE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Muted}"/>
                        <TextBlock x:Name="OverallAverageValue" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Accent.Primary}" Margin="0,2,0,2"/>
                        <TextBlock Text="Across all graded submissions" FontSize="10"
                                   Foreground="{StaticResource Text.Muted}" Margin="0,0,0,14"/>

                        <TextBlock Text="ACADEMIC STANDING" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                        <TextBlock Text="Based on overall average (thresholds pending policy confirmation)"
                                   FontSize="9" Foreground="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Border x:Name="StandingBadge2" BorderThickness="1" CornerRadius="10"
                                Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock x:Name="StandingBadge2Text" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Performance Trend" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource Bg.TableHeader}"
                                    BorderBrush="{StaticResource Border.Medium}" BorderThickness="1"
                                    CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock x:Name="TrendCountBadge" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Secondary}"/>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Height="160">
                            <Canvas x:Name="TrendCanvas" ClipToBounds="True"/>
                            <TextBlock x:Name="TrendEmptyHint"
                                       Text="Not enough graded assessments yet to show a trend."
                                       FontSize="12" Foreground="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RECORD OF ASSESSMENTS TAKEN -->
            <TextBlock Text="RECORD OF ASSESSMENTS TAKEN" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Border Background="{StaticResource Bg.TableHeader}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ASSESSMENT NAME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Grid.Column="1" Text="DATE TAKEN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Grid.Column="2" Text="TYPE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Grid.Column="3" Text="FINAL GRADE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Grid.Column="4" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="AssessmentRowsPanel"/>

                    <TextBlock x:Name="AssessmentsEmptyHint"
                               Text="No assessments taken yet."
                               FontSize="12" Foreground="{StaticResource Text.Muted}"
                               Padding="16" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
