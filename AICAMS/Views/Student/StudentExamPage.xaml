<UserControl x:Class="ACPAMS.Views.Student.StudentExamPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F5F7"
      FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Canvas"        Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Nav.Active.Bg"    Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Nav.Active.Strip" Color="#1976D2"/>

        <!-- Nav section header button -->
        <Style x:Key="Btn.NavSection" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="14,10"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav question item — inactive -->
        <Style x:Key="Btn.NavItem" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="28,7,14,7"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav question item — active -->
        <Style x:Key="Btn.NavItem.Active" TargetType="Button"
               BasedOn="{StaticResource Btn.NavItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource Nav.Active.Bg}"
                                BorderBrush="{StaticResource Nav.Active.Strip}"
                                BorderThickness="3,0,0,0"
                                Padding="25,7,14,7">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Submit Exam button -->
        <Style x:Key="Btn.Submit" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Status.Danger}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Previous / Next nav buttons -->
        <Style x:Key="Btn.NavArrow" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="Foreground"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Padding"         Value="20,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monitoring alert dismiss button -->
        <Style x:Key="Btn.AlertAction" TargetType="Button">
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Review Toggle Button Style -->
        <Style x:Key="Btn.ReviewToggle" TargetType="ToggleButton">
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#64748B"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FEF3C7"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#F59E0B"/>
                                <Setter Property="Foreground" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Palette Indicators Template -->
        <DataTemplate x:Key="QuestionPaletteItemTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="16" Height="16" Margin="0,0,8,0">
                    <Ellipse x:Name="DotIndicator" Width="8" Height="8"
                             Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FlagIndicator" Text="⚑" FontSize="11" FontWeight="Bold"
                               Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
                <TextBlock Text="{Binding DisplayNumber, StringFormat={}Question {0}}" FontSize="12"
                           Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFlaggedForReview}" Value="True">
                    <Setter TargetName="FlagIndicator" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="DotIndicator" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAnswered}" Value="True"/>
                        <Condition Binding="{Binding IsFlaggedForReview}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="DotIndicator" Property="Fill" Value="#10B981"/>
                    <Setter TargetName="DotIndicator" Property="Stroke" Value="#10B981"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/FINAL LOGO.ico" Width="28" Height="28" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="AI-CAMS" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Exam title — back-end binds exam name and course code -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="ExamTitleText"
                               Text="FINALS EXAM"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ExamSubtitleText"
                               Text="Loading..."
                               FontSize="11" Foreground="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Timer -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="TimerBorder"
                            Background="{StaticResource Status.DangerBg}"
                            BorderBrush="{StaticResource Status.Danger}"
                            BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{StaticResource Status.Danger}"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimerText"
                                       Text="60:00"
                                       FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource Status.Danger}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.20*"/>
                <ColumnDefinition Width="0.60*"/>
                <ColumnDefinition Width="0.20*"/>
            </Grid.ColumnDefinitions>

            <!-- PANE 1: NAVIGATION -->
            <Border Grid.Column="0"
                    Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,8">

                            <!-- Progress bar -->
                            <Border Margin="14,0,14,12"
                                    Background="{StaticResource Bg.Base}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="Progress" FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                        <TextBlock x:Name="ProgressText"
                                                   Text="0 / 0" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource Accent.Primary}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border x:Name="ProgressBarTrack" Height="5" CornerRadius="3"
                                            Background="{StaticResource Border.Subtle}"
                                            SizeChanged="ProgressBarTrack_SizeChanged">
                                        <Border x:Name="ProgressBar"
                                                HorizontalAlignment="Left"
                                                Width="0" CornerRadius="3"
                                                Background="{StaticResource Accent.Primary}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Nav items — back-end populates NavItemsPanel dynamically -->
                            <StackPanel x:Name="NavItemsPanel"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Submit Exam -->
                    <Border Grid.Row="1" Padding="14,12"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource Btn.Submit}"
                                HorizontalAlignment="Stretch"
                                Click="SubmitBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Foreground="White"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Submit Exam" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- PANE 2: ACTIVE CANVAS -->
            <Border Grid.Column="1"
                    Background="{StaticResource Bg.Canvas}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- VISUAL PRIVACY GUIDANCE CALLOUT -->
                    <Border Grid.Row="0"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="0,0,0,1"
                            Padding="16,9">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#2563EB" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Privacy Notice: Do not write your name, student number, or personal details in your answer or code comments. Submissions are graded anonymously."
                                       FontSize="11" Foreground="#1E40AF" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- SECTION INSTRUCTIONS CALLOUT -->
                    <Border x:Name="SectionInstructionsCard"
                            Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="16,8"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#64748B" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SectionInstructionsText"
                                       FontStyle="Italic" FontSize="12" Foreground="#475569"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- QUESTION HEADER & MARK FOR REVIEW BAR -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Bg.Surface}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="20,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource Bg.Base}"
                                        BorderBrush="#64748B"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                                        Margin="0,0,8,0">
                                    <TextBlock x:Name="QuestionTypeBadge" Text="Question" FontSize="10" FontWeight="Bold"
                                               Foreground="#64748B"/>
                                </Border>
                                <Border Background="{StaticResource Accent.PrimaryBg}"
                                        BorderBrush="{StaticResource Accent.Primary}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="QuestionPointsBadge" Text="1 pt" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Accent.Primary}"/>
                                </Border>
                                <TextBlock x:Name="QuestionIndexBadge" Text="Question 1 of 1"
                                           FontSize="11" Foreground="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <ToggleButton x:Name="MarkForReviewBtn"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource Btn.ReviewToggle}"
                                          IsChecked="{Binding CurrentQuestion.IsFlaggedForReview, Mode=TwoWay}"
                                          Click="MarkForReviewBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚑" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="#F59E0B" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="Mark for Review" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <!-- Canvas host -->
                    <ContentControl Grid.Row="3" x:Name="ExamCanvasHost"/>

                    <!-- Previous / Next bar -->
                    <Border Grid.Row="4"
                            Background="{StaticResource Bg.Surface}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,1,0,0" Padding="24,12">
                        <Grid>
                            <Button x:Name="PreviousBtn"
                                    Style="{StaticResource Btn.NavArrow}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False"
                                    Click="PreviousBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource Accent.Primary}"
                                               Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Previous" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NextBtn"
                                    Style="{StaticResource Btn.NavArrow}"
                                    HorizontalAlignment="Right"
                                    Click="NextBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Next" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource Accent.Primary}"
                                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- PANE 3: MONITORING -->
            <Border Grid.Column="2"
                    Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,12,10,12">

                        <Border x:Name="CameraHostBorder"
                                ClipToBounds="True"
                                Background="#0F172A" BorderBrush="#1E293B"
                                BorderThickness="1" CornerRadius="6"
                                Height="140" Margin="0,0,0,8"
                                MouseWheel="CameraHost_MouseWheel"
                                MouseDown="CameraHost_MouseDown"
                                MouseMove="CameraHost_MouseMove"
                                MouseUp="CameraHost_MouseUp">
                            <Grid>
                                <!-- Live webcam feed -->
                                <Image x:Name="WebcamFeed" Stretch="UniformToFill"
                                       RenderTransformOrigin="0.5,0.5"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CameraScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                            <TranslateTransform x:Name="CameraTranslateTransform" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>

                                <!-- Placeholder shown when webcam not active -->
                                <StackPanel x:Name="WebcamPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                       FontSize="20" Foreground="#334155"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Live Feed" FontSize="10" Foreground="#475569"
                       HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- LIVE badge -->
                                <Border Background="#EF4444" CornerRadius="3" Padding="5,2"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="6,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="White"
                         Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <!-- Overlay Controls: Zoom HUD & Reset Button -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" CornerRadius="4" Background="#80000000" Padding="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="-" Click="ZoomOut_Click" Width="20" Height="20" Margin="1"
                                                Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" FontSize="10" Padding="0"/>
                                        <TextBlock x:Name="ZoomPercentText" Text="100%"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"
                                                   Margin="4,0"
                                                   FontWeight="SemiBold"
                                                   FontSize="9"/>
                                        <Button Content="+" Click="ZoomIn_Click" Width="20" Height="20" Margin="1"
                                                Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" FontSize="10" Padding="0"/>
                                        <Button Content="Reset" Click="ResetZoom_Click" Margin="2,1,1,1" Padding="4,1"
                                                Foreground="White" Background="#33FFFFFF" BorderThickness="0" Cursor="Hand" FontSize="9"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Monitoring status -->
                        <Border Background="{StaticResource Bg.Base}"
        BorderBrush="{StaticResource Border.Subtle}"
        BorderThickness="1" CornerRadius="6"
        Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="MONITORING" FontSize="9" FontWeight="Bold"
                                    Foreground="{StaticResource Text.Muted}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse x:Name="WebcamStatusDot" Width="6" Height="6"
                                         Fill="{StaticResource Status.Warning}"
                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="WebcamStatusText" Text="Webcam initializing..."
                                         FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse x:Name="ClipboardStatusDot" Width="6" Height="6"
                                        Fill="{StaticResource Status.Warning}"
                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ClipboardStatusText" Text="Clipboard monitoring..."
                                         FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse x:Name="AltTabStatusDot" Width="6" Height="6"
                                        Fill="{StaticResource Status.Warning}"
                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AltTabStatusText" Text="Alt+Tab monitoring..."
                                        FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse x:Name="EyeStatusDot" Width="6" Height="6"
                                        Fill="{StaticResource Status.Warning}"
                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EyeStatusText" Text="Eyes: Detecting..."
                                        FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="GazeStatusDot" Width="6" Height="6"
                                        Fill="{StaticResource Status.Warning}"
                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GazeStatusText" Text="Gaze: Detecting..."
                                        FontSize="10" Foreground="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Bg.Base}"
        BorderBrush="{StaticResource Border.Subtle}"
        BorderThickness="1" CornerRadius="6"
        Padding="10,8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="RISK SCORE" FontSize="9" FontWeight="Bold"
                   Foreground="{StaticResource Text.Muted}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="CheatingScoreText" Text="Risk Score: 0.0 / 100"
                   FontSize="10" Foreground="{StaticResource Text.Secondary}"
                   Margin="0,0,0,4"/>
                                <Border x:Name="ScoreBarContainer" Height="6" CornerRadius="3"
        Background="{StaticResource Border.Subtle}">
                                    <Border x:Name="CheatingScoreBar"
            HorizontalAlignment="Left"
            Width="0" Height="6" CornerRadius="3"
            Background="{StaticResource Status.Success}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AlertCard"
                                Background="{StaticResource Status.WarningBg}"
                                BorderBrush="{StaticResource Status.Warning}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" Foreground="{StaticResource Status.Warning}"
                                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AlertTitle"
                                               Text="Warning" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Status.Warning}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="AlertMessage"
                                           Text="Please refrain from cheating. Your activity is being monitored."
                                           FontSize="10" Foreground="{StaticResource Status.Warning}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource Btn.AlertAction}"
                                        Background="Transparent"
                                        Foreground="{StaticResource Accent.Primary}"
                                        HorizontalAlignment="Stretch"
                                        Click="AlertDismiss_Click">
                                    <Border BorderBrush="{StaticResource Accent.Primary}"
                                            BorderThickness="1" CornerRadius="4" Padding="0,5">
                                        <TextBlock Text="Understood" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent.Primary}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Alert card -->

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════════
             KIOSK PROCTOR WARNING MODAL OVERLAY
        ═══════════════════════════════════════════ -->
        <Grid x:Name="KioskWarningOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="2500"
              Background="#D9000000"
              Visibility="Collapsed">
            <Border Background="#FFFFFF"
                    BorderBrush="{StaticResource Status.Danger}"
                    BorderThickness="2"
                    CornerRadius="12"
                    MaxWidth="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="32"
                    Margin="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Warning Header -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border Background="{StaticResource Status.DangerBg}" CornerRadius="24" Width="48" Height="48" Margin="0,0,14,0">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="{StaticResource Status.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PROCTOR WARNING" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Status.Danger}"/>
                            <TextBlock Text="Live Exam Integrity Notification" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Warning Message Box -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <TextBlock x:Name="KioskWarningMessageText"
                                   Text="Tab switching detected. Return to the exam immediately."
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Status.Danger}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="20"/>
                    </Border>

                    <TextBlock Text="This warning was dispatched live by your proctor and recorded in the audit log. Failure to comply may lead to disciplinary action or exam termination."
                               FontSize="11" Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Acknowledge Button -->
                    <Button x:Name="AcknowledgeWarningBtn"
                            Background="{StaticResource Status.Danger}"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="13"
                            Padding="24,12"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Click="AcknowledgeWarning_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="I Understand — Return to Exam" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════
             PRIVACY WARNING PRE-SUBMISSION MODAL OVERLAY
        ═══════════════════════════════════════════ -->
        <Grid x:Name="PrivacyWarningOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="2400"
              Background="#D9000000"
              Visibility="Collapsed">
            <Border Background="#FFFFFF"
                    BorderBrush="#F59E0B"
                    BorderThickness="2"
                    CornerRadius="12"
                    MaxWidth="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="30"
                    Margin="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Warning Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#FEF3C7" CornerRadius="20" Width="42" Height="42" Margin="0,0,12,0">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Potential Personal Information Detected" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Anonymous Grading Verification" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Message Body -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                        <TextBlock Text="Potential personal information detected (such as a name, student ID, or email). Please confirm that your response does not contain personal identifiers before proceeding."
                                   FontSize="12" Foreground="#92400E" TextWrapping="Wrap" LineHeight="18"/>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PrivacyReviewBtn"
                                Style="{StaticResource Btn.NavArrow}"
                                Content="Review Answer"
                                Padding="16,8"
                                Margin="0,0,10,0"
                                Click="PrivacyReviewBtn_Click"/>
                        <Button x:Name="PrivacyProceedBtn"
                                Background="#D97706"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="12"
                                BorderThickness="0"
                                Padding="16,8"
                                Cursor="Hand"
                                Click="PrivacyProceedBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Proceed Anyway"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
