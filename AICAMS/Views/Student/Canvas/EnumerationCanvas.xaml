<UserControl x:Class="ACPAMS.Views.Student.Canvas.EnumerationCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="QType.Enum"       Color="#B45309"/>
        <SolidColorBrush x:Key="QType.EnumBg"     Color="#FEF3C7"/>

        <Style x:Key="Input.EnumItem" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,20">

            <!-- Question header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Background="{StaticResource QType.EnumBg}"
                        BorderBrush="{StaticResource QType.Enum}"
                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="TypeBadgeText" Text="Enumeration" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource QType.Enum}"/>
                </Border>
                <Border Background="{StaticResource Accent.PrimaryBg}"
                        BorderBrush="{StaticResource Accent.Primary}"
                        BorderThickness="1" CornerRadius="4" Padding="8,3">
                    <TextBlock x:Name="PointsText" Text="10 pts" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Accent.Primary}"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="QuestionNumberText" Text="Question 1 of 3"
                       FontSize="11" Foreground="{StaticResource Text.Muted}"
                       Margin="0,0,0,10"/>

            <Border Height="1" Background="{StaticResource Border.Subtle}"
                    Margin="0,0,0,16"/>

            <!-- Question text -->
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap" Margin="0,0,0,8"
                       FontSize="16" LineHeight="26"
                       Foreground="{StaticResource Text.Primary}"/>
            <TextBlock x:Name="QuestionSubtext" FontSize="11" Foreground="{StaticResource Text.Muted}"
                       Margin="0,0,0,24"
                       Text="List them in any order."/>

            <!-- Enumeration items -->
            <TextBlock Text="YOUR ANSWERS"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource Text.Muted}"
                       Margin="0,0,0,14"/>

            <StackPanel x:Name="AnswersContainer"/>

            <Button x:Name="AddAnswerBtn" Content="+ Add another item"
                    HorizontalAlignment="Left" Margin="0,4,0,0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource Accent.Primary}"
                    FontWeight="SemiBold" Cursor="Hand"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
