<Window x:Class="ACPAMS.Views.Auth.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password Required"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>

        <Style x:Key="Input.Password" TargetType="PasswordBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Secondary" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Modal Card -->
    <Border Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}"
            BorderThickness="1" CornerRadius="12"
            Width="440"
            VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel Margin="28,24,28,24">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="38" Height="38" CornerRadius="8"
                        Background="#FEF3C7" Margin="0,0,12,0">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" Foreground="#D97706"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Change Temporary Password"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}"/>
                    <TextBlock Text="Your password was recently reset by faculty. Please set a new password to continue."
                               FontSize="12" Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="For security, enter a permanent password to access your account and exams."
                       FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <!-- Error Banner -->
            <Border x:Name="ErrorCard" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ErrorMessageText" FontSize="12" Foreground="#DC2626"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- New Password -->
            <TextBlock Text="New Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
            <Border Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Border.Medium}"
                    BorderThickness="1" CornerRadius="6" Height="40" Margin="0,0,0,14">
                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource Input.Password}"/>
            </Border>

            <!-- Confirm New Password -->
            <TextBlock Text="Confirm New Password" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
            <Border Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Border.Medium}"
                    BorderThickness="1" CornerRadius="6" Height="40" Margin="0,0,0,18">
                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource Input.Password}"/>
            </Border>

            <!-- Action Buttons -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelBtn" Grid.Column="0" Content="Cancel"
                        Style="{StaticResource Btn.Secondary}" Click="CancelBtn_Click"/>

                <Button x:Name="ConfirmBtn" Grid.Column="2" Content="Confirm"
                        Style="{StaticResource Btn.Primary}" Click="ConfirmBtn_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>

