# ====================================================================
# Git Ignore Configuration for AI-CAMS
# ====================================================================

# Build & Publish Outputs
bin/
obj/
publish/
publish-*/
publish-selfcontained/
installer-output/
*.user
*.suo
*.vsidx
.vs/
*.log

# Installers & Redistributables (Should be hosted on GitHub Releases, not git tree)
AICAMS_Installation/*.exe
AICAMS_Installation/Prerequisites/*.exe
AICAMS_Installation/Output/
*.exe
*.dll
*.msi
*.zip

# Database & Storage
*.mdf
*.ldf
*.db
*.opendb

# Secrets & Environment Files (Defense in Depth)
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.*.local.json
secrets.json
*.pfx
*.key

# Runtime Rubric Attachments
RubricAttachments/

# Codebase Analysis Cache
graphify-out

# Portable Compiler & Runtime Binaries (setup via setup-portable-tools.ps1)
[Tt]ools/
AICAMS/Tools/
