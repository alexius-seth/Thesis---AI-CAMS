<Window x:Class="ACPAMS.Views.Faculty.PublishConfirmModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publish Exam"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ═══════════════════════════
             DESIGN TOKENS
        ═══════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Overlay.Bg"       Color="#1A202C"/>

        <!-- ═══════════════════════════
             SIMPLE INPUT STYLE - NO COMPLEX TRIGGERS
        ═══════════════════════════ -->
        <Style x:Key="Input.Field" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="Black"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#CBD5E1"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,10"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"               Value="False"/>
            <Setter Property="IsEnabled"                Value="True"/>
            <Setter Property="Focusable"                Value="True"/>
            <Setter Property="CaretBrush"               Value="#1976D2"/>
        </Style>

        <!-- Generated code field — read-only -->
        <Style x:Key="Input.GeneratedCode" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Foreground"               Value="#1976D2"/>
            <Setter Property="Background"               Value="#EFF6FF"/>
            <Setter Property="BorderBrush"              Value="#1976D2"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,10"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="Focusable"                Value="False"/>
        </Style>

        <!-- ═══════════════════════════
             BUTTONS
        ═══════════════════════════ -->
        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="#1976D2"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Copy to clipboard icon button -->
        <Style x:Key="Btn.Copy" TargetType="Button">
            <Setter Property="Background"      Value="#1976D2"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="44"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button -->
        <Style x:Key="Btn.Close" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════
         SCRIM + MODAL
    ═══════════════════════════════════════ -->
    <Grid>

        <!-- Scrim overlay -->
        <Border Background="{StaticResource Overlay.Bg}" Opacity="0.5"/>

        <!-- Modal card -->
        <Border Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="10"
                Width="480"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="#1A202C" Opacity="0.20"
                                  BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>

            <StackPanel>

                <!-- ══════════════════
                     MODAL HEADER
                ══════════════════ -->
                <Border BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="28,20,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Publish icon badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="{StaticResource Accent.PrimaryBg}"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="&#xE72D;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{StaticResource Accent.Primary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Just a few more steps!"
                                               FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="Please fill in the remaining information to publish this exam."
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Close -->
                        <Button Grid.Column="1"
                                x:Name="CloseBtn"
                                Style="{StaticResource Btn.Close}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Text.Muted}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ══════════════════
                     FORM BODY - SIMPLIFIED TEXTBOXES
                ══════════════════ -->
                <StackPanel Margin="28,22,28,0">

                    <!-- Row 1: Course Code + Time Limit -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <!-- Course Code -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Course Code"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="CourseCodeBox"
                                     Width="Auto"
                                     FontSize="13"
                                     Foreground="Black"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Padding="12,10"
                                     Height="40"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="False"
                                     IsEnabled="True"
                                     Focusable="True"
                                     Text="CCS415"/>
                        </StackPanel>

                        <!-- Time Limit -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Time Limit"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="TimeLimitBox"
                                         FontSize="13"
                                         Foreground="Black"
                                         Background="White"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         Padding="12,10"
                                         Height="40"
                                         VerticalContentAlignment="Center"
                                         IsReadOnly="False"
                                         IsEnabled="True"
                                         Focusable="True"
                                         Text="60"
                                         TextAlignment="Center"/>
                                <!-- "min" unit label inside a trailing tag -->
                                <Border Grid.Column="1"
                                        Background="{StaticResource Bg.Base}"
                                        BorderBrush="{StaticResource Border.Medium}"
                                        BorderThickness="0,1,1,1"
                                        CornerRadius="0,6,6,0"
                                        Padding="10,0" Margin="-1,0,0,0">
                                    <TextBlock Text="min"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Generated Exam Code -->
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Generated Exam Code"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Code field -->
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="GeneratedCodeBox"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="#1976D2"
                                         Background="#EFF6FF"
                                         BorderBrush="#1976D2"
                                         BorderThickness="1"
                                         Padding="12,10"
                                         Height="40"
                                         VerticalContentAlignment="Center"
                                         IsReadOnly="True"
                                         Focusable="False"
                                         Text="Enter a course code to generate exam code"/>
                                <!-- Read-only badge inside the field -->
                                <Border Grid.Column="1"
                                        Background="{StaticResource Accent.Primary}"
                                        CornerRadius="0,5,5,0"
                                        Margin="-1,1,1,1"
                                        Padding="10,0">
                                    <TextBlock Text="Read-only"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Copy button -->
                            <Button Grid.Column="2"
                                    x:Name="CopyBtn"
                                    Style="{StaticResource Btn.Copy}"
                                    ToolTip="Copy exam code to clipboard">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="White"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Generation note -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap">
                            <Run Text="Once the Course Code has been entered, the exam code will be generated. Please be patient."/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Row 3: Exam Name -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Exam Name"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ExamNameBox"
                                 FontSize="13"
                                 Foreground="Black"
                                 Background="White"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="False"
                                 IsEnabled="True"
                                 Focusable="True"
                                 Text="Object-Oriented Programming Finals"/>
                    </StackPanel>

                    <!-- Row 4: Randomize Question Order -->
                    <Border Background="{StaticResource Bg.Base}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Randomize Question Order"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="Shuffle question sequence uniquely for each student attempt"
                                           FontSize="11" Foreground="{StaticResource Text.Muted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      x:Name="RandomizeQuestionsCheckBox"
                                      VerticalAlignment="Center"
                                      Cursor="Hand"/>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ══════════════════
                     FOOTER
                ══════════════════ -->
                <Border BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="28,16">
                    <Button x:Name="PublishBtn"
                            Style="{StaticResource Btn.Primary}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72D;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="White"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Finish and Publish Exam"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>