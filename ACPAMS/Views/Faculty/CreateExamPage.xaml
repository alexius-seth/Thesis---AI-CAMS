                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource Btn.AnswerToggle}"
                                                Margin="0,0,8,0" Width="30">
                                            <TextBlock Text="C" FontSize="12" FontWeight="Bold"/>
                                        </Button>
                                        <TextBox Grid.Column="1" Style="{StaticResource Input.AnswerOption}"
                                                 Height="34" AcceptsReturn="False" Text="protected"/>
                                        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}"
                                                Margin="8,0,0,0" VerticalAlignment="Center" Padding="6,4">
                                            <TextBlock Text="Mark correct" FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}"/>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource Btn.AnswerToggle}"
                                                Margin="0,0,8,0" Width="30">
                                            <TextBlock Text="D" FontSize="12" FontWeight="Bold"/>
                                        </Button>
                                        <TextBox Grid.Column="1" Style="{StaticResource Input.AnswerOption}"
                                                 Height="34" AcceptsReturn="False" Text="public"/>
                                        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}"
                                                Margin="8,0,0,0" VerticalAlignment="Center" Padding="6,4">
                                            <TextBlock Text="Mark correct" FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}"/>
                                        </Button>
                                    </Grid>
                                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{StaticResource Accent.Primary}"
                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add option" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent.Primary}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Q4: TRUE OR FALSE -->
                    <Border Style="{StaticResource Card}">
                        <Border BorderBrush="{StaticResource QType.TrueOrFalse}"
                                BorderThickness="4,0,0,0" CornerRadius="0,8,8,0">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="0,0,0,1" Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Question 4" Style="{StaticResource T.QuestionNumber}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Background="#F0FDFA" BorderBrush="#0F766E"
                                                    BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="True or False" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="#0F766E"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Points:" FontSize="13"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Style="{StaticResource Input.Points}" Text="2"/>
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="6,4" Margin="8,0,0,0">
                                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16" Foreground="{StaticResource Text.Muted}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="18,16">
                                    <TextBlock Style="{StaticResource T.FieldLabel}" Text="Statement"/>
                                    <TextBox Style="{StaticResource Input.Text}" Height="60"
                                             Text="In Java, a static method can access instance variables of a class directly without creating an object."
                                             Margin="0,0,0,16"/>
                                    <TextBlock Style="{StaticResource T.FieldLabel}" Text="Correct Answer"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource Bg.Base}"
                                                BorderBrush="{StaticResource Border.Medium}"
                                                BorderThickness="1" CornerRadius="6"
                                                Padding="28,10" Margin="0,0,10,0" Cursor="Hand">
                                            <TextBlock Text="True" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text.Secondary}"/>
                                        </Border>
                                        <Border Background="{StaticResource Status.SuccessBg}"
                                                BorderBrush="{StaticResource Status.Success}"
                                                BorderThickness="2" CornerRadius="6"
                                                Padding="20,10" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓ " FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource Status.Success}"/>
                                                <TextBlock Text="False" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource Status.Success}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Q5: ESSAY -->
                    <Border Style="{StaticResource Card}">
                        <Border BorderBrush="{StaticResource QType.Essay}"
                                BorderThickness="4,0,0,0" CornerRadius="0,8,8,0">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="0,0,0,1" Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Question 5" Style="{StaticResource T.QuestionNumber}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Background="{StaticResource AI.Bg}"
                                                    BorderBrush="{StaticResource AI.Border}"
                                                    BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="Essay" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AI.Text}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Points:" FontSize="13"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Style="{StaticResource Input.Points}" Text="20"/>
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="6,4" Margin="8,0,0,0">
                                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16" Foreground="{StaticResource Text.Muted}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="18,16">
                                    <TextBlock Style="{StaticResource T.FieldLabel}" Text="Essay Prompt"/>
                                    <TextBox Style="{StaticResource Input.Text}" Height="80"
                                             Text="Explain the concept of polymorphism in Object-Oriented Programming. Describe at least two real-world scenarios where it improves code design and maintainability."
                                             Margin="0,0,0,16"/>
                                    <TextBlock Style="{StaticResource T.FieldLabel}" Text="Word Limit (optional)"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBox Style="{StaticResource Input.AnswerOption}"
                                                 Width="72" Height="34" AcceptsReturn="False"
                                                 Text="150" TextAlignment="Center"/>
                                        <TextBlock Text="to" FontSize="13"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBox Style="{StaticResource Input.AnswerOption}"
                                                 Width="72" Height="34" AcceptsReturn="False"
                                                 Text="500" TextAlignment="Center"/>
                                        <TextBlock Text="words" FontSize="13"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Border Background="{StaticResource AI.Bg}"
                                            BorderBrush="{StaticResource AI.Border}"
                                            BorderThickness="1" CornerRadius="6" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" Foreground="{StaticResource AI.Border}"
                                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="AI Essay Rubric"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource AI.Text}"/>
                                                </StackPanel>
                                                <TextBlock Text="Define grading criteria the AI uses to evaluate essay responses."
                                                           FontSize="11" Foreground="{StaticResource AI.Text}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource Btn.AIRubric}"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11" Foreground="{StaticResource AI.Border}"
                                                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Configure AI Rubric" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Q6: ENUMERATION -->
                    <Border Style="{StaticResource Card}">
                        <Border BorderBrush="{StaticResource QType.Enumeration}"
                                BorderThickness="4,0,0,0" CornerRadius="0,8,8,0">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="0,0,0,1" Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Question 6" Style="{StaticResource T.QuestionNumber}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Background="{StaticResource Status.WarningBg}"
                                                    BorderBrush="{StaticResource Status.Warning}"
                                                    BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="Enumeration" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Status.Warning}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Points:" FontSize="13"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Style="{StaticResource Input.Points}" Text="10"/>
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="6,4" Margin="8,0,0,0">
                                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16" Foreground="{StaticResource Text.Muted}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="18,16">
                                    <TextBlock Style="{StaticResource T.FieldLabel}" Text="Question"/>
                                    <TextBox Style="{StaticResource Input.Text}" Height="60"
                                             Text="Enumerate the four pillars of Object-Oriented Programming."
                                             Margin="0,0,0,4"/>
                                    <TextBlock Text="Students list items in order — each response is auto-numbered."
                                               FontSize="11" Foreground="{StaticResource Text.Muted}"
                                               Margin="0,0,0,16"/>
                                    <TextBlock Style="{StaticResource T.FieldLabel}"
                                               Text="Accepted Answers  (in order, one per line)"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                                Background="{StaticResource Accent.PrimaryBg}"
                                                BorderBrush="{StaticResource Accent.Primary}"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="1" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox Grid.Column="1" Style="{StaticResource Input.AnswerOption}"
                                                 Height="34" AcceptsReturn="False" Text="Encapsulation"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                                Background="{StaticResource Accent.PrimaryBg}"
                                                BorderBrush="{StaticResource Accent.Primary}"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="2" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox Grid.Column="1" Style="{StaticResource Input.AnswerOption}"
                                                 Height="34" AcceptsReturn="False" Text="Inheritance"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                                Background="{StaticResource Accent.PrimaryBg}"
                                                BorderBrush="{StaticResource Accent.Primary}"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="3" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox Grid.Column="1" Style="{StaticResource Input.AnswerOption}"
                                                 Height="34" AcceptsReturn="False" Text="Polymorphism"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                                Background="{StaticResource Accent.PrimaryBg}"
                                                BorderBrush="{StaticResource Accent.Primary}"
                                                BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="4" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox Grid.Column="1" Style="{StaticResource Input.AnswerOption}"
                                                 Height="34" AcceptsReturn="False" Text="Abstraction"/>
                                    </Grid>
                                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{StaticResource Accent.Primary}"
                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add answer item" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent.Primary}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Add New Question bar -->
            <Border Grid.Row="2" Padding="28,14"
                    Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0">
                <Button Style="{StaticResource Btn.AddQuestion}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add New Question" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

        </Grid>

    </Grid>
</Window>
