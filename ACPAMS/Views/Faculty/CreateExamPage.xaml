<UserControl x:Class="ACPAMS.Views.Faculty.CreateExamPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F4F5F7"
        FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Canvas"        Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Bg.Code"          Color="#1E293B"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="AI.Text"          Color="#5B21B6"/>
        <SolidColorBrush x:Key="AI.Bg"            Color="#F5F3FF"/>
        <SolidColorBrush x:Key="AI.Border"        Color="#7C3AED"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="QType.Identification" Color="#64748B"/>
        <SolidColorBrush x:Key="QType.MultipleChoice" Color="#1976D2"/>
        <SolidColorBrush x:Key="QType.TrueOrFalse"    Color="#0F766E"/>
        <SolidColorBrush x:Key="QType.Essay"          Color="#7C3AED"/>
        <SolidColorBrush x:Key="QType.Enumeration"    Color="#B45309"/>
        <SolidColorBrush x:Key="QType.Coding"         Color="#15803D"/>

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>
        <Style x:Key="T.QuestionNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>
        <Style x:Key="T.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="T.CodeLine" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Margin"          Value="0,0,0,16"/>
        </Style>

        <Style x:Key="Btn.Nav" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="18,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn.Nav.Active" TargetType="Button" BasedOn="{StaticResource Btn.Nav}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#EFF6FF" BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource Accent.Primary}" Padding="18,11">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.SectionItem" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0,0,0,1"/>
            <Setter Property="BorderBrush"                Value="{StaticResource Border.Subtle}"/>
            <Setter Property="Padding"                    Value="14,11"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn.SectionItem.Active" TargetType="Button" BasedOn="{StaticResource Btn.SectionItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource Accent.PrimaryBg}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,0,0,1" Padding="14,11">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.QTypeItem" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0,0,0,1"/>
            <Setter Property="BorderBrush"                Value="{StaticResource Border.Subtle}"/>
            <Setter Property="Padding"                    Value="12,9"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="34,8,12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center" Margin="11,0,0,0"
                                           IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input.Text" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn"            Value="True"/>
            <Setter Property="TextWrapping"             Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input.Points" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="FontWeight"               Value="Bold"/>
            <Setter Property="Foreground"               Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Accent.PrimaryBg}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,5"/>
            <Setter Property="Width"                    Value="60"/>
            <Setter Property="TextAlignment"            Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input.AnswerOption" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Base}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Outlined" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Ghost" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.AIRubric" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AI.Bg}"/>
            <Setter Property="Foreground"      Value="{StaticResource AI.Text}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AI.Border}"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDE9FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.AddQuestion" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="48"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Icon" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.AnswerToggle" TargetType="Button">
            <Setter Property="Background"      Value="#F1F5F9"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.AnswerToggle.Correct" TargetType="Button"
               BasedOn="{StaticResource Btn.AnswerToggle}">
            <Setter Property="Background"  Value="{StaticResource Status.SuccessBg}"/>
            <Setter Property="Foreground"  Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource Bg.Base}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="89*"/>
        </Grid.ColumnDefinitions>

        <!-- PANE 1: SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,18,20,16"
                        BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" Background="#1A202C"
                                CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ACPAMS" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="Computer Studies" FontSize="10"
                                       Foreground="{StaticResource Text.Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="#E2E8F0" Margin="0,0,6,0">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource Btn.Icon}" Margin="0,0,4,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Text.Secondary}"/>
                        </Button>
                        <Grid>
                            <Button Style="{StaticResource Btn.Icon}">
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Text.Secondary}"/>
                            </Button>
                            <Border Width="16" Height="16" CornerRadius="8" Background="#E53E3E"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-4,-4,0">
                                <TextBlock Text="1" FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Margin="14,10">
                    <TextBox Style="{StaticResource SearchBox}" Height="34"/>
                </Border>
                <StackPanel DockPanel.Dock="Top" Margin="0,2,0,0">

                    <!-- Home Button -->
                    <Button Style="{StaticResource Btn.Nav}"
            Click="NavigateToHome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource Text.Secondary}"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Home" FontSize="13"
                       Foreground="{StaticResource Text.Secondary}"
                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Dashboard Button -->
                    <Button Style="{StaticResource Btn.Nav}"
            Click="NavigateToDashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF246;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource Text.Secondary}"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" FontSize="13"
                       Foreground="{StaticResource Text.Secondary}"
                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Create Exam Button (Active) -->
                    <Button Style="{StaticResource Btn.Nav.Active}"
            Click="NavigateToCreateExam">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource Accent.Primary}"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Create Exam" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent.Primary}"
                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- PANE 2: OUTLINE MANAGER -->
        <Border Grid.Column="1" Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Margin="18,16"
                        BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="CREATE EXAM MANAGER"
                                   Style="{StaticResource T.SectionLabel}" Margin="0,0,0,10"/>
                        <TextBox Style="{StaticResource Input.Text}"
                                 Text="CS101 — Final Examination"
                                 Height="36" AcceptsReturn="False"
                                 FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Margin="18,14,18,6">
                            <TextBlock Text="SECTIONS" Style="{StaticResource T.SectionLabel}"/>
                        </Border>
                        <!-- Section: Identification -->
                       
                        
                        <!--Dynamic Sections Container-->
                        <StackPanel x:Name="SectionsContainer" Margin="0,0,0,10"/>
                        
                        <!-- Add Section -->
                        <Border Margin="14,10"
        BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
                            <Button x:Name="AddSectionBtn" Click="AddSection_Click" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{StaticResource Accent.Primary}"
                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Section" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent.Primary}"
                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <!-- Type picker -->
                        <Border Margin="18,14,18,8">
                            <TextBlock Text="ADD QUESTION TYPE" Style="{StaticResource T.SectionLabel}"/>
                        </Border>
                        
                        <!--Identification-->
                        <Button x:Name="AddIdentificationBtn" Click="AddQuestionByType_Click" Tag="Identification" Style="{StaticResource Btn.QTypeItem}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                 Background="{StaticResource QType.Identification}"
                                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                  <Ellipse Width="16" Height="16" Stroke="{StaticResource Border.Medium}"
                                   Fill="Transparent" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Identification" FontSize="13"
                                     Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!--MCQ-->
                        <Button x:Name="AddMultipleChoiceBtn" Click="AddQuestionByType_Click" Tag="Multiple Choice" Style="{StaticResource Btn.QTypeItem}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                Background="{StaticResource QType.MultipleChoice}"
                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                                 <Ellipse Width="16" Height="16" Stroke="{StaticResource Border.Medium}"
                                 Fill="Transparent" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                   <TextBlock Text="Multiple Choice" FontSize="13"
                                   Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!--True or False-->
                        <Button x:Name="AddTrueFalseBtn" Click="AddQuestionByType_Click" Tag="True or False" Style="{StaticResource Btn.QTypeItem}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                Background="{StaticResource QType.TrueOrFalse}"
                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                                 <Ellipse Width="16" Height="16" Stroke="{StaticResource Border.Medium}"
                                 Fill="Transparent" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="True or False" FontSize="13"
                                   Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!--Essay-->
                        <Button x:Name="AddEssayBtn" Click="AddQuestionByType_Click" Tag="Essay" Style="{StaticResource Btn.QTypeItem}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                Background="{StaticResource QType.Essay}"
                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                                 <Ellipse Width="16" Height="16" Stroke="{StaticResource Border.Medium}"
                                 Fill="Transparent" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                   <TextBlock Text="Essay" FontSize="13"
                                   Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!--Enumeration-->
                        <Button x:Name="AddEnumerationBtn" Click="AddQuestionByType_Click" Tag="Enumeration" Style="{StaticResource Btn.QTypeItem}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                                Background="{StaticResource QType.Enumeration}"
                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                                 <Ellipse Width="16" Height="16" Stroke="{StaticResource Border.Medium}"
                                 Fill="Transparent" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                   <TextBlock Text="Enumeration" FontSize="13"
                                   Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Coding selected -->
                        <!-- Coding -->
                        <!-- Coding -->
                        <Button x:Name="AddCodingBtn" Click="AddQuestionByType_Click" Tag="Coding" Style="{StaticResource Btn.QTypeItem}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4"
                Background="{StaticResource QType.Coding}"
                Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Ellipse Width="16" Height="16" 
                 Stroke="{StaticResource Border.Medium}" 
                 Fill="Transparent" 
                 Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Coding" FontSize="13"
                   Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Margin="14,12"
                        BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0">
                    <StackPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource Btn.Outlined}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8" Content="Cancel"/>
                        <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Stretch" Click="SaveAndPublish_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                   Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save and Publish" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <!-- PANE 3: ACTIVE QUESTION CANVAS -->
        <Grid Grid.Column="2" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Canvas header -->
            <!-- Canvas header -->
<Border Grid.Row="0" Background="{StaticResource Bg.Surface}"
        BorderBrush="{StaticResource Border.Subtle}"
        BorderThickness="0,0,0,1" Padding="28,14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="ACTIVE SECTION"
                       Style="{StaticResource T.SectionLabel}" Margin="0,0,0,2"/>
            <TextBlock x:Name="ActiveSectionHeader"
                       Text="No section selected"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text.Primary}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{StaticResource Accent.PrimaryBg}"
                    BorderBrush="{StaticResource Accent.Primary}"
                    BorderThickness="1" CornerRadius="6" Padding="12,5" Margin="0,0,10,0">
                <TextBlock x:Name="TotalQuestionsDisplay" Text="Total: 0 pts" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource Accent.Primary}"/>
            </Border>
            <Border Background="{StaticResource Status.SuccessBg}"
                    BorderBrush="{StaticResource Status.Success}"
                    BorderThickness="1" CornerRadius="6" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource QType.Coding}"
                            Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ActiveTypeDisplay" Text="—" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Status.Success}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Border>

            <!-- Scrollable question list -->
            <!--DITO PASTE-->
            <!-- Scrollable question list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Background="{StaticResource Bg.Canvas}">
                <StackPanel x:Name="QuestionsContainer" Margin="28,24,28,16" />
            </ScrollViewer>

            <!-- Add New Question bar -->
            <Border Grid.Row="2" Padding="28,14"
            Background="{StaticResource Bg.Surface}"
            BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,1,0,0">
                <Button x:Name="AddQuestionBtn" Click="AddNewQuestion_Click" Style="{StaticResource Btn.AddQuestion}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                       <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                       <TextBlock Text="Add New Question" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

        </Grid>

    </Grid>
</UserControl>
