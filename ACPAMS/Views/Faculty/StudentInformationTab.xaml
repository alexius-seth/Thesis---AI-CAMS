<UserControl x:Class="ACPAMS.Views.Faculty.StudentInformationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Chart.Blue"       Color="#1976D2"/>
        <SolidColorBrush x:Key="Chart.BgBlue"     Color="#DBEAFE"/>
        <SolidColorBrush x:Key="Chart.GridLine"   Color="#F1F5F9"/>

        <!-- ═══════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════ -->

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell.Muted" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════
             CARD SURFACES
        ═══════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <!-- Profile header card — blue left stripe -->
        <Style x:Key="Card.Profile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="24,20"/>
        </Style>

        <!-- Stat card — subtle left stripe -->
        <Style x:Key="Card.Stat" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="22,20"/>
        </Style>

        <!-- ═══════════════════════════════
             BADGES
        ═══════════════════════════════ -->
        <Style x:Key="Badge.Success" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.SuccessBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Danger" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.DangerBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Danger}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Warning" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.WarningBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Blue" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Accent.PrimaryBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <!-- ═══════════════════════════════
             TABLE ROW
        ═══════════════════════════════ -->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>

        <!-- ═══════════════════════════════
             SEARCH BOX
        ═══════════════════════════════ -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="36,10,14,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button — inactive -->
        <Style x:Key="Btn.Tab" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Padding"         Value="4,10"/>
            <Setter Property="Margin"          Value="0,0,28,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource Border.Medium}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button — active -->
        <Style x:Key="Btn.Tab.Active" TargetType="Button" BasedOn="{StaticResource Btn.Tab}">
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"  Value="{StaticResource Accent.Primary}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         PAGE BODY
    ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Search + page title + tab bar -->
            <RowDefinition Height="*"/>      <!-- Scrollable content -->
        </Grid.RowDefinitions>

        <!-- ── PAGE HEADER AREA ── -->
        <Border Grid.Row="0"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- Search bar -->
                <Border Padding="32,14,32,12"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <TextBox Style="{StaticResource SearchBox}"
                             Height="40"/>
                </Border>

                <!-- Page title + tab bar -->
                <Grid Margin="32,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page title -->
                    <TextBlock Grid.Row="0"
                               Text="Student"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,16,0,12"/>

                    <!-- Tab row -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal">
                        <!-- Information — active -->
                        <Button Style="{StaticResource Btn.Tab.Active}"
                                Content="Information"/>

                        <!-- Performance Report with badge -->
                        <Button Style="{StaticResource Btn.Tab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Performance Report"
                                           VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" CornerRadius="9"
                                        Background="{StaticResource Accent.PrimaryBg}"
                                        BorderBrush="{StaticResource Accent.Primary}"
                                        BorderThickness="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="4"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Accent.Primary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </Border>

        <!-- ── SCROLLABLE CONTENT ── -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,32,40">

                <!-- ─────────────────────────────────────────
                     SECTION 1 — STUDENT PROFILE HEADER
                ───────────────────────────────────────── -->
                <TextBlock Text="STUDENT PROFILE"
                           Style="{StaticResource T.SectionLabel}"
                           Margin="0,0,0,10"/>

                <Border Style="{StaticResource Card.Profile}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0"
                                Width="64" Height="64"
                                CornerRadius="32"
                                Background="{StaticResource Accent.PrimaryBg}"
                                BorderBrush="{StaticResource Accent.Primary}"
                                BorderThickness="2"
                                Margin="0,0,20,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="30"
                                       Foreground="{StaticResource Accent.Primary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Student info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Jane Doe"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Bachelor of Science in Computer Science (BSCS)  ·  3rd Year"
                                       FontSize="13"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <!-- Student ID chip -->
                                <Border Background="{StaticResource Bg.Base}"
                                        BorderBrush="{StaticResource Border.Medium}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="9,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ID: "
                                                   FontSize="12"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                        <TextBlock Text="2023-01452"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource Text.Primary}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Section chip -->
                                <Border Background="{StaticResource Bg.Base}"
                                        BorderBrush="{StaticResource Border.Medium}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="9,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Section: "
                                                   FontSize="12"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                        <TextBlock Text="CS3A"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.Primary}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Standing badge (top-right) -->
                        <Border Grid.Column="2"
                                Style="{StaticResource Badge.Success}"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{StaticResource Status.Success}"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Excellent Standing"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource Status.Success}"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- ─────────────────────────────────────────
                     SECTION 2 — HISTORICAL PERFORMANCE OVERVIEW
                ───────────────────────────────────────── -->
                <TextBlock Text="HISTORICAL PERFORMANCE OVERVIEW"
                           Style="{StaticResource T.SectionLabel}"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.38*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.62*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Aggregate Stats -->
                    <Border Grid.Column="0" Style="{StaticResource Card.Stat}">
                        <StackPanel>
                            <TextBlock Text="Aggregate Stats"
                                       Style="{StaticResource T.CardTitle}"
                                       Margin="0,0,0,18"/>

                            <!-- Stat row 1 -->
                            <Border BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,12"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TOTAL ASSESSMENTS"
                                                   Style="{StaticResource T.SectionLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="Taken this academic term"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="14"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource Text.Primary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Stat row 2 -->
                            <Border BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,12"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="OVERALL AVERAGE"
                                                   Style="{StaticResource T.SectionLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="Across all graded submissions"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="88.5%"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource Accent.Primary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Stat row 3 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ACADEMIC STANDING"
                                               Style="{StaticResource T.SectionLabel}"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="Based on overall average"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource Badge.Success}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Excellent"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource Status.Success}"/>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- RIGHT: Performance Trend chart -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="Performance Trend"
                                           Style="{StaticResource T.CardTitle}"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Badge.Blue}"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="14 Assessments"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent.Primary}"/>
                                </Border>
                            </StackPanel>

                            <!-- Chart area -->
                            <Grid Height="160">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>   <!-- Y-axis labels -->
                                    <ColumnDefinition Width="*"/>    <!-- Chart plot -->
                                </Grid.ColumnDefinitions>

                                <!-- Y-axis labels -->
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Stretch">
                                    <TextBlock Text="100"
                                               FontSize="10"
                                               Foreground="{StaticResource Text.Muted}"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Text="75"
                                               FontSize="10"
                                               Foreground="{StaticResource Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="0,28,0,0"/>
                                    <TextBlock Text="50"
                                               FontSize="10"
                                               Foreground="{StaticResource Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="0,28,0,0"/>
                                    <TextBlock Text="25"
                                               FontSize="10"
                                               Foreground="{StaticResource Text.Muted}"
                                               VerticalAlignment="Bottom"
                                               Margin="0,28,0,0"/>
                                </StackPanel>

                                <!-- Chart plot area -->
                                <Canvas Grid.Column="1" x:Name="TrendCanvas">
                                    <!-- Horizontal grid lines -->
                                    <Line X1="0" Y1="0"   X2="600" Y2="0"
                                          Stroke="{StaticResource Chart.GridLine}"
                                          StrokeThickness="1"/>
                                    <Line X1="0" Y1="40"  X2="600" Y2="40"
                                          Stroke="{StaticResource Chart.GridLine}"
                                          StrokeThickness="1"/>
                                    <Line X1="0" Y1="80"  X2="600" Y2="80"
                                          Stroke="{StaticResource Chart.GridLine}"
                                          StrokeThickness="1"/>
                                    <Line X1="0" Y1="120" X2="600" Y2="120"
                                          Stroke="{StaticResource Chart.GridLine}"
                                          StrokeThickness="1"/>
                                    <Line X1="0" Y1="160" X2="600" Y2="160"
                                          Stroke="{StaticResource Border.Subtle}"
                                          StrokeThickness="1"/>

                                    <!-- Area fill under the line (polygon) -->
                                    <!-- Points map scores: 100=0, 75=40, 50=80, 0=160 -->
                                    <!-- Scores: 72,78,80,85,82,88,85,90,87,92,88,90,85,92 -->
                                    <Polygon
                                        Points="0,160 0,70  30,58  60,54  90,30  120,34  150,20  180,30  210,16  240,22  270,16  300,14  330,30  360,14  360,160"
                                        Fill="#1A1976D2"
                                        Stroke="Transparent"/>

                                    <!-- Line itself -->
                                    <Polyline
                                        Points="0,70  30,58  60,54  90,30  120,34  150,20  180,30  210,16  240,22  270,16  300,14  330,30  360,14"
                                        Stroke="{StaticResource Chart.Blue}"
                                        StrokeThickness="2"
                                        StrokeLineJoin="Round"/>

                                    <!-- Data point dots -->
                                    <Ellipse Canvas.Left="-3"  Canvas.Top="67"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="27"  Canvas.Top="55"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="57"  Canvas.Top="51"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="87"  Canvas.Top="27"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="117" Canvas.Top="31"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="147" Canvas.Top="17"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="177" Canvas.Top="27"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="207" Canvas.Top="13"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="237" Canvas.Top="19"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="267" Canvas.Top="13"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="297" Canvas.Top="11"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="327" Canvas.Top="27"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>
                                    <Ellipse Canvas.Left="357" Canvas.Top="11"  Width="7" Height="7" Fill="{StaticResource Chart.Blue}"/>

                                    <!-- X-axis labels -->
                                    <TextBlock Canvas.Left="0"   Canvas.Top="166"
                                               Text="Apr 10" FontSize="9"
                                               Foreground="{StaticResource Text.Muted}"/>
                                    <TextBlock Canvas.Left="80"  Canvas.Top="166"
                                               Text="Apr 18" FontSize="9"
                                               Foreground="{StaticResource Text.Muted}"/>
                                    <TextBlock Canvas.Left="170" Canvas.Top="166"
                                               Text="Apr 25" FontSize="9"
                                               Foreground="{StaticResource Text.Muted}"/>
                                    <TextBlock Canvas.Left="260" Canvas.Top="166"
                                               Text="May 02" FontSize="9"
                                               Foreground="{StaticResource Text.Muted}"/>
                                    <TextBlock Canvas.Left="330" Canvas.Top="166"
                                               Text="May 10" FontSize="9"
                                               Foreground="{StaticResource Text.Muted}"/>
                                </Canvas>
                            </Grid>

                        </StackPanel>
                    </Border>

                </Grid>

                <!-- ─────────────────────────────────────────
                     SECTION 3 — ASSESSMENT LEDGER
                ───────────────────────────────────────── -->
                <TextBlock Text="RECORD OF ASSESSMENTS TAKEN"
                           Style="{StaticResource T.SectionLabel}"
                           Margin="0,0,0,10"/>

                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>

                        <!-- Table header -->
                        <Border Background="{StaticResource Bg.TableHeader}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ASSESSMENT NAME"
                                           Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="1" Text="DATE TAKEN"
                                           Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="2" Text="TYPE"
                                           Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="3" Text="FINAL GRADE"
                                           Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="4" Text="STATUS"
                                           Style="{StaticResource T.TableHeader}"/>
                            </Grid>
                        </Border>

                        <!-- Row 1: CS101 Midterm — Passed -->
