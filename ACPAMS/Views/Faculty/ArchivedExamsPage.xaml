<UserControl x:Class="ACPAMS.Views.Faculty.ArchivedExamsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F4F5F7"
        FontFamily="Segoe UI"
        Loaded="ArchivedExamsPage_Loaded">

    <UserControl.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Base"           Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border.Subtle"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"     Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"      Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"    Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"        Color="#94A3B8"/>
        <SolidColorBrush x:Key="Status.Live"       Color="#2E7D32"/>
        <SolidColorBrush x:Key="Status.LiveBg"     Color="#F0FDF4"/>
        <SolidColorBrush x:Key="Status.Upcoming"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.UpcomingBg" Color="#FFFBEB"/>
        <SolidColorBrush x:Key="Status.Success"    Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg"  Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"    Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg"  Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"     Color="#DC2626"/>
        <SolidColorBrush x:Key="Status.DangerBg"   Color="#FEF2F2"/>
        <SolidColorBrush x:Key="Accent.Primary"    Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg"  Color="#EFF6FF"/>

        <!-- ═══════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════ -->

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.CardBody" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="T.Label" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.NavItem" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="Medium"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════
             CARD SURFACES
        ═══════════════════════════════ -->

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <Style x:Key="Card.Dynamic" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ═══════════════════════════════
             BUTTONS
        ═══════════════════════════════ -->

        <Style x:Key="Btn.Nav" TargetType="Button">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                  Value="14,8"/>
            <Setter Property="Margin"                   Value="6,1"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Nav.Active" TargetType="Button" BasedOn="{StaticResource Btn.Nav}">
            <Setter Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Icon" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Outlined" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Primary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Danger" TargetType="Button">
            <Setter Property="Background"      Value="#FEE2E2"/>
            <Setter Property="Foreground"      Value="#DC2626"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════
             INPUTS & CONVERTERS
        ═══════════════════════════════ -->

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════
             SIDEBAR
        ══════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Docked Log Out Button (Firmly docked to bottom edge) -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Nav}"
                        Click="LogOut_Click"
                        Margin="0,0,0,16"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#DC2626"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Log Out" FontSize="13" Foreground="#DC2626" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Brand -->
                <Border DockPanel.Dock="Top"
                        Padding="20,18,20,16"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/FINAL LOGO.ico" Width="32" Height="32" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AI-CAMS"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="Computer Studies"
                                       FontSize="10"
                                       Foreground="{StaticResource Text.Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- User widget -->
                <Border DockPanel.Dock="Top"
                        Padding="16,12"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                CornerRadius="17"
                                Background="#E2E8F0"
                                Margin="0,0,6,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource Btn.Icon}" Margin="0,0,4,0" Click="OpenSettings_Click">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource Text.Secondary}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Sidebar search -->
                <Border DockPanel.Dock="Top" Padding="14,10">
                    <TextBox Style="{StaticResource SearchBox}" Height="34"/>
                </Border>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="0,2,0,0">

                    <!-- Home Button -->
                    <Button Style="{StaticResource Btn.Nav}"
                            Click="NavigateToHome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Home" Style="{StaticResource T.NavItem}"/>
                        </StackPanel>
                    </Button>

                    <!-- Dashboard Button -->
                    <Button Style="{StaticResource Btn.Nav}"
                            Click="OpenDashboardPage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF246;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" Style="{StaticResource T.NavItem}"/>
                        </StackPanel>
                    </Button>

                    <!-- Create Exam Button -->
                    <Button Style="{StaticResource Btn.Nav}"
                            Click="OpenCreateExamPage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Create Exam" Style="{StaticResource T.NavItem}"/>
                        </StackPanel>
                    </Button>

                    <!-- Registration Code Button -->
                    <Button Style="{StaticResource Btn.Nav}"
                            Click="OpenRegistrationCodeSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Registration Code" Style="{StaticResource T.NavItem}"/>
                        </StackPanel>
                    </Button>

                    <!-- Archived Exams Button (Active) -->
                    <Button Style="{StaticResource Btn.Nav.Active}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Accent.Primary}"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Archived Exams"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent.Primary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════
             MAIN AREA
        ══════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER BAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="32,0"
                    Height="64">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ARCHIVED ASSESSMENTS"
                                   Style="{StaticResource T.SectionLabel}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Archived Exams"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource Btn.Outlined}"
                            VerticalAlignment="Center"
                            Click="NavigateToHome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Back to Active Exams" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT SCROLL -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,48">

                    <TextBlock Text="ARCHIVED EXAMS"
                               Style="{StaticResource T.SectionLabel}"
                               Margin="0,0,0,10"/>

                    <!-- Loading state -->
                    <TextBlock Text="Loading archived assessments…"
                               Style="{StaticResource T.CardBody}"
                               Margin="0,0,0,32"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" Padding="30" Margin="0,0,0,32"
                            Visibility="{Binding HasNoExams, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No archived exams found. Exams archived from the active assessments list will appear here."
                                   Style="{StaticResource T.CardBody}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Dynamic exam cards -->
                    <ItemsControl ItemsSource="{Binding Exams}"
                                  Margin="0,0,0,32">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Dynamic}"
                                        Padding="22,20" Width="340"
                                        Margin="0,0,16,16">
                                    <StackPanel>

                                        <!-- Status badge -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border Background="{StaticResource Status.WarningBg}"
                                                    BorderBrush="{StaticResource Status.Warning}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,2">
                                                <TextBlock Text="📦  ARCHIVED"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource Status.Warning}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding CourseCode}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Type"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Type}"
                                                       Style="{StaticResource T.CardBody}"
                                                       Foreground="{StaticResource Text.Primary}"/>
                                        </Grid>

                                        <!-- Total submissions -->
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Submissions"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalStudents}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource Text.Primary}"/>
                                        </Grid>

                                        <!-- Action buttons: Unarchive / Restore, View Scores, View Logs, Delete -->
                                        <WrapPanel>
                                            <Button Style="{StaticResource Btn.Primary}"
                                                    Content="Unarchive / Restore"
                                                    Command="{Binding DataContext.UnarchiveExamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"/>

                                            <Button Style="{StaticResource Btn.Outlined}"
                                                    Content="View Scores"
                                                    Command="{Binding DataContext.ViewScoresCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"
                                                    Visibility="{Binding HasAttempts, Converter={StaticResource BoolToVis}}"/>

                                            <Button Style="{StaticResource Btn.Outlined}"
                                                    Content="View Monitoring Logs"
                                                    Command="{Binding DataContext.ViewLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"/>

                                            <Button Style="{StaticResource Btn.Danger}"
                                                    Content="Delete"
                                                    Command="{Binding DataContext.DeleteExamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
