<UserControl x:Class="ACPAMS.Views.Faculty.StudentPerformanceReportTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>
        <SolidColorBrush x:Key="AI.Text"          Color="#5B21B6"/>
        <SolidColorBrush x:Key="AI.Bg"            Color="#F5F3FF"/>
        <SolidColorBrush x:Key="AI.Border"        Color="#7C3AED"/>
        <SolidColorBrush x:Key="Chart.Blue"       Color="#1976D2"/>
        <SolidColorBrush x:Key="Chart.BgBlue"     Color="#DBEAFE"/>

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <Style x:Key="Pill.AiGenerated" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource AI.Bg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AI.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="8,2"/>
        </Style>

        <Style x:Key="Btn.TabLink" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="4,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,40">

            <TextBlock Text="Student" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Text.Primary}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Information" Style="{StaticResource Btn.TabLink}"
                        Click="GoToInformation_Click" Margin="0,0,20,0"/>
                <Button Content="Performance Report" Style="{StaticResource Btn.TabLink}"
                        Foreground="{StaticResource AI.Text}"
                        BorderBrush="{StaticResource AI.Border}"
                        IsEnabled="False"/>
            </StackPanel>

            <!-- STUDENT PROFILE -->
            <TextBlock Text="STUDENT PROFILE" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="#EFF6FF" Margin="0,0,16,0">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{StaticResource Accent.Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StudentNameText" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock x:Name="ProgramText" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource Pill.AiGenerated}" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource AI.Text}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="AI Performance Report" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AI.Text}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- AI METRICS SUMMARY -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="AI METRICS SUMMARY" Style="{StaticResource T.SectionLabel}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Pill.AiGenerated}" Margin="10,0,0,0">
                    <TextBlock Text="AI Generated" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AI.Text}"/>
                </Border>
            </StackPanel>

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" BorderBrush="{StaticResource AI.Border}">
                    <StackPanel>
                        <TextBlock Text="Concept Mastery Index" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ConceptMasteryValue" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AI.Text}"/>
                        <TextBlock Text="Overall average across all graded assessments" FontSize="10"
                                   Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="AI Confidence Benchmark" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="AiConfidenceValue" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent.Primary}"/>
                        <TextBlock Text="% of AI-graded essay/coding answers not overridden" FontSize="10"
                                   Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="AI-Flagged Risk Score" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RiskScoreValue" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                        <Border x:Name="RiskLevelBadge" BorderThickness="1" CornerRadius="10" Padding="8,2"
                                HorizontalAlignment="Left" Margin="0,6,0,0">
                            <TextBlock x:Name="RiskLevelText" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- VISUAL ANALYTICS AND BEHAVIORAL INSIGHTS -->
            <TextBlock Text="VISUAL ANALYTICS &amp; BEHAVIORAL INSIGHTS" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Question-type performance — replaces the fake Logic/Syntax/
                     Design skill-tag radar with real per-type averages. -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Performance by Question Type" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <Border Style="{StaticResource Pill.AiGenerated}" Margin="8,0,0,0">
                                <TextBlock Text="Real Data" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AI.Text}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Average score across all graded questions of each type"
                                   FontSize="11" Foreground="{StaticResource Text.Muted}" Margin="0,3,0,16"/>

                        <ItemsControl x:Name="QuestionTypeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding QuestionType}"
                                                   FontSize="12" Foreground="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Height="8" CornerRadius="4"
                                                Background="{StaticResource Chart.BgBlue}" VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}"
                                                    Height="8" CornerRadius="4" Background="{StaticResource Chart.Blue}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Chart.Blue}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="QuestionTypeEmptyHint" Text="No fully-graded questions yet."
                                   FontSize="12" Foreground="{StaticResource Text.Muted}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Behavioral insights — only cards backed by real tracked
                     data. No "Keystroke Dynamics" card: this system has no
                     keystroke-biometric tracking, so nothing honest to show. -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Behavioral Insights" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <Border Style="{StaticResource Pill.AiGenerated}" Margin="8,0,0,0">
                                <TextBlock Text="From Monitoring Logs" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AI.Text}"/>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Accent.Primary}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Gaze Deviation" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock x:Name="GazeInsightText" FontSize="11" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE737;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Accent.Primary}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Window / Tab Switches" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock x:Name="WindowInsightText" FontSize="11" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Accent.Primary}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Clipboard Activity" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock x:Name="ClipboardInsightText" FontSize="11" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AI HISTORICAL EVALUATIONS LEDGER -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="AI HISTORICAL EVALUATIONS LEDGER" Style="{StaticResource T.SectionLabel}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Pill.AiGenerated}" Margin="10,0,0,0">
                    <TextBlock Text="AI Generated" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AI.Text}"/>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Border Background="{StaticResource Bg.TableHeader}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="EXAM TARGET" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Grid.Column="1" Text="SCORE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Grid.Column="2" Text="STRENGTHS / WEAKNESSES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Grid.Column="3" Text="AI SUMMARY SNIPPET" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Secondary}"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="LedgerRowsPanel"/>

                    <TextBlock x:Name="LedgerEmptyHint"
                               Text="No AI assessments generated yet. Generate one from a student's exam report."
                               FontSize="12" Foreground="{StaticResource Text.Muted}"
                               Padding="16" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
