<UserControl x:Class="ACPAMS.Views.Faculty.FacultyHomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F4F5F7"
        FontFamily="Segoe UI"
        Loaded="FacultyHomePage_Loaded">

    <UserControl.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Base"           Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border.Subtle"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"     Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"      Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"    Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"        Color="#94A3B8"/>
        <SolidColorBrush x:Key="Status.Live"       Color="#2E7D32"/>
        <SolidColorBrush x:Key="Status.LiveBg"     Color="#F0FDF4"/>
        <SolidColorBrush x:Key="Status.Upcoming"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.UpcomingBg" Color="#FFFBEB"/>
        <SolidColorBrush x:Key="Status.Success"    Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg"  Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"    Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg"  Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Accent.Primary"    Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg"  Color="#EFF6FF"/>

        <!-- ═══════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════ -->

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.CardBody" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="T.Label" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.NavItem" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="Medium"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════
             CARD SURFACES
        ═══════════════════════════════ -->

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <!-- Signature: left 3px status stripe encodes live state -->
        <Style x:Key="Card.Live" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Live}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
        </Style>

        <Style x:Key="Card.Upcoming" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Upcoming}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
        </Style>

        <!-- ═══════════════════════════════
             BADGES
        ═══════════════════════════════ -->

        <Style x:Key="Badge.Live" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.LiveBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Live}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Warning" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.WarningBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Success" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.SuccessBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <!-- ═══════════════════════════════
             BUTTONS
        ═══════════════════════════════ -->

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Outlined" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Nav" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Padding="18,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Nav.Active" TargetType="Button" BasedOn="{StaticResource Btn.Nav}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#EFF6FF"
                                BorderThickness="3,0,0,0"
                                BorderBrush="{StaticResource Accent.Primary}"
                                Padding="18,11">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.QuickNav" TargetType="Button">
            <Setter Property="Background"                 Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"                Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="Padding"                    Value="20,18"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button (sidebar) -->
        <Style x:Key="Btn.Icon" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search box -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="Foreground"              Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"              Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="34,8,12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="11,0,0,0"
                                           IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bool -> Visibility (used to switch content per exam status) -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Card whose left-stripe color reacts to the bound Status -->
        <Style x:Key="Card.Dynamic" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="live">
                    <Setter Property="BorderBrush" Value="{StaticResource Status.Live}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="pending">
                    <Setter Property="BorderBrush" Value="{StaticResource Status.Upcoming}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="done">
                    <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small neutral action button (Archive) -->
        <Style x:Key="Btn.Subtle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive action button (Delete) -->
        <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Subtle}">
            <Setter Property="Foreground"  Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table row -->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         ROOT: Sidebar (220px) | Main (*)
    ═══════════════════════════════════════════ -->
    <Grid Background="{StaticResource Bg.Base}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════
             SIDEBAR
        ══════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Brand -->
                <Border DockPanel.Dock="Top"
                        Padding="20,18,20,16"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                Background="#1A202C"
                                CornerRadius="6"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE715;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ACPAMS"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="Computer Studies"
                                       FontSize="10"
                                       Foreground="{StaticResource Text.Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- User widget -->
                <Border DockPanel.Dock="Top"
                        Padding="16,12"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34"
                                CornerRadius="17"
                                Background="#E2E8F0"
                                Margin="0,0,6,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{StaticResource Text.Secondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource Btn.Icon}" Margin="0,0,4,0">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource Text.Secondary}"/>
                        </Button>
                        <Grid>
                            <Button Style="{StaticResource Btn.Icon}">
                                <TextBlock Text="&#xEA8F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource Text.Secondary}"/>
                            </Button>
                            <Border Width="16" Height="16" CornerRadius="8"
                                    Background="#E53E3E"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-4,-4,0">
                                <TextBlock Text="1"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sidebar search -->
                <Border DockPanel.Dock="Top" Padding="14,10">
                    <TextBox Style="{StaticResource SearchBox}" Height="34"/>
                </Border>

                <!-- Navigation -->
                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="0,2,0,0">

                    <!-- Home Button -->
                    <Button Style="{StaticResource Btn.Nav.Active}"
            Click="NavigateToHome">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;"
                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource Accent.Primary}"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Home"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent.Primary}"
                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Dashboard Button -->
                    <Button Style="{StaticResource Btn.Nav}"
            Click="OpenDashboardPage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF246;"
                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource Text.Secondary}"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" Style="{StaticResource T.NavItem}"/>
                        </StackPanel>
                    </Button>

                    <!-- Create Exam Button -->
                    <Button Style="{StaticResource Btn.Nav}"
            Click="OpenCreateExamPage">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;"
                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource Text.Secondary}"
                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Create Exam" Style="{StaticResource T.NavItem}"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════
             MAIN AREA
        ══════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER BAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource Bg.Surface}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,0,1"
                    Padding="32,0"
                    Height="64">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="WELCOME, INSTRUCTOR"
                                   Style="{StaticResource T.SectionLabel}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Home / Overview"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}"/>
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource SearchBox}"
                             Height="36"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- PAGE BODY -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,28,32,40">

                    <!-- ─────────────────────────────────────
                         SECTION 1 — QUICK NAVIGATION HUB
                    ───────────────────────────────────── -->
                    <TextBlock Text="QUICK NAVIGATION HUB"
                               Style="{StaticResource T.SectionLabel}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Create Assessment -->
                        <Button Grid.Column="0" Style="{StaticResource Btn.QuickNav}"
                                Click="OpenCreateExamPage">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="8"
                                        Background="{StaticResource Accent.PrimaryBg}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE710;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{StaticResource Accent.Primary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Create New Assessment"
                                           Style="{StaticResource T.CardTitle}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Build and publish a new exam or quiz"
                                           Style="{StaticResource T.CardBody}"/>
                            </StackPanel>
                        </Button>

                        <!-- Live Monitor -->
                        <Button Grid.Column="2" Style="{StaticResource Btn.QuickNav}"
                                Click="OpenMonitoringTab">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="8"
                                        Background="{StaticResource Status.LiveBg}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE7C1;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{StaticResource Status.Live}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Go to Live Monitor"
                                           Style="{StaticResource T.CardTitle}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="View active sessions and student activity"
                                           Style="{StaticResource T.CardBody}"/>
                            </StackPanel>
                        </Button>

                        <!-- Student Reports -->
                        <Button Grid.Column="4" Style="{StaticResource Btn.QuickNav}"
                                Click="OpenStudentReportTab">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="8"
                                        Background="#F5F3FF"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="&#xE9D2;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="#7C3AED"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="View Student Reports"
                                           Style="{StaticResource T.CardTitle}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="AI metrics, behavioral insights, scores"
                                           Style="{StaticResource T.CardBody}"/>
                            </StackPanel>
                        </Button>

                    </Grid>

                    <!-- ─────────────────────────────────────
                         SECTION 2 — ACTIVE & UPCOMING ASSESSMENTS
                    ───────────────────────────────────── -->
                    <TextBlock Text="ACTIVE &amp; UPCOMING ASSESSMENTS"
                               Style="{StaticResource T.SectionLabel}"
                               Margin="0,0,0,10"/>

                    <!-- Loading state -->
                    <TextBlock Text="Loading assessments…"
                               Style="{StaticResource T.CardBody}"
                               Margin="0,0,0,32"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" Padding="30" Margin="0,0,0,32"
                            Visibility="{Binding HasNoExams, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No exams yet. Create one from the Quick Navigation Hub above."
                                   Style="{StaticResource T.CardBody}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Dynamic exam cards: LIVE / PENDING / DONE, one card per exam -->
                    <ItemsControl x:Name="ExamCardsControl"
                                  ItemsSource="{Binding Exams}"
                                  Margin="0,0,0,32">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Dynamic}"
                                        Padding="22,20" Width="340"
                                        Margin="0,0,16,16">
                                    <StackPanel>

                                        <!-- Status badge -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border Style="{StaticResource Badge.Live}"
                                                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6"
                                                             Fill="{StaticResource Status.Live}"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="LIVE NOW"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource Status.Live}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Badge.Warning}"
                                                    Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="⏳  UPCOMING"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource Status.Upcoming}"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge.Success}"
                                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="✓  COMPLETED"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource Status.Success}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding CourseCode}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Type"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Type}"
                                                       Style="{StaticResource T.CardBody}"
                                                       Foreground="{StaticResource Text.Primary}"/>
                                        </Grid>

                                        <!-- LIVE: active students -->
                                        <Grid Margin="0,0,0,20"
                                              Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Active Students"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StudentsProgressText}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource Status.Live}"/>
                                        </Grid>

                                        <!-- PENDING: exam code -->
                                        <Grid Margin="0,0,0,20"
                                              Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Exam Code"
                                                       Style="{StaticResource T.Label}"/>
                                            <Border Grid.Column="1"
                                                    Background="#F1F5F9"
                                                    BorderBrush="{StaticResource Border.Medium}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ExamCode}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           FontFamily="Consolas"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                            </Border>
                                        </Grid>

                                        <!-- DONE: total submissions -->
                                        <Grid Margin="0,0,0,20"
                                              Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Submissions"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalStudents}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource Text.Primary}"/>
                                        </Grid>

                                        <!-- Action buttons: differ per status. Commands live on the
                                             page-level FacultyHomePageViewModel (DataContext of the
                                             UserControl), so we reach up via RelativeSource; the
                                             CommandParameter is this card's own ExamStatusDto. -->
                                        <WrapPanel>
                                            <Button Style="{StaticResource Btn.Primary}"
                                                    Content="Manage Live Session"
                                                    Command="{Binding DataContext.MonitorExamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"
                                                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>

                                            <Button Style="{StaticResource Btn.Outlined}"
                                                    Content="View Dashboard"
                                                    Command="{Binding DataContext.ViewDashboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"
                                                    Visibility="{Binding IsActiveOrUpcoming, Converter={StaticResource BoolToVis}}"/>

                                            <Button Style="{StaticResource Btn.Outlined}"
                                                    Content="Edit Exam"
                                                    Command="{Binding DataContext.EditExamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"
                                                    Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"/>

                                            <Button Style="{StaticResource Btn.Outlined}"
                                                    Content="View Monitoring Logs"
                                                    Command="{Binding DataContext.ViewLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"
                                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>

                                            <Button Style="{StaticResource Btn.Subtle}"
                                                    Content="Archive"
                                                    Command="{Binding DataContext.ArchiveExamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"
                                                    Visibility="{Binding ShowArchiveDelete, Converter={StaticResource BoolToVis}}"/>

                                            <Button Style="{StaticResource Btn.Danger}"
                                                    Content="Delete"
                                                    Command="{Binding DataContext.DeleteExamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"
                                                    Visibility="{Binding ShowArchiveDelete, Converter={StaticResource BoolToVis}}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ─────────────────────────────────────
                         SECTION 3 — RECENTLY COMPLETED
                    ───────────────────────────────────── -->
                    <TextBlock Text="RECENTLY COMPLETED — NEEDS REVIEW"
                               Style="{StaticResource T.SectionLabel}"
                               Margin="0,0,0,10"/>

                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>

                            <!-- Table Header -->
                            <Border Background="#F8FAFC"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ASSESSMENT"
                                               Style="{StaticResource T.TableHeader}"/>
                                    <TextBlock Grid.Column="1" Text="AI AUTO-GRADING STATUS"
                                               Style="{StaticResource T.TableHeader}"/>
                                    <TextBlock Grid.Column="2" Text="ACTION"
                                               Style="{StaticResource T.TableHeader}"/>
                                </Grid>
                            </Border>

                            <!-- Empty state -->
                            <Border Padding="16,20"
                                    Visibility="{Binding HasNoCompletedExams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="No completed exams yet."
                                           Style="{StaticResource T.CardBody}"/>
                            </Border>

                            <!-- Rows, one per completed exam -->
                            <ItemsControl ItemsSource="{Binding CompletedExams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           Style="{StaticResource T.TableCell}"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Badge.Success}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding GradingStatusIsWarning}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Status.WarningBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Warning}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding GradingStatusText}"
                                                                   FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding GradingStatusIsWarning}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>

                                                <!-- "Finalize Grades" — primary style, only visible in that state -->
                                                <Button Grid.Column="2"
                                                        Content="{Binding ActionLabel}"
                                                        Command="{Binding DataContext.PrimaryActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Left">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActionLabel}" Value="Finalize Grades">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- "Review Submissions" / "View Report" — outlined style, visible otherwise -->
                                                <Button Grid.Column="2"
                                                        Content="{Binding ActionLabel}"
                                                        Command="{Binding DataContext.PrimaryActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Left">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Outlined}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActionLabel}" Value="Finalize Grades">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

    </Grid>
</UserControl>