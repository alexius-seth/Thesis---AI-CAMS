<UserControl x:Class="ACPAMS.Views.Faculty.Tabs.ReportsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>
        <SolidColorBrush x:Key="AI.Text"          Color="#5B21B6"/>
        <SolidColorBrush x:Key="AI.Bg"            Color="#F5F3FF"/>
        <SolidColorBrush x:Key="AI.Border"        Color="#7C3AED"/>

        <!-- Chart palette -->
        <SolidColorBrush x:Key="Chart.Blue"       Color="#1976D2"/>
        <SolidColorBrush x:Key="Chart.Purple"     Color="#7C3AED"/>
        <SolidColorBrush x:Key="Chart.Green"      Color="#15803D"/>
        <SolidColorBrush x:Key="Chart.Amber"      Color="#B45309"/>
        <SolidColorBrush x:Key="Chart.Red"        Color="#C62828"/>
        <SolidColorBrush x:Key="Chart.Teal"       Color="#0F766E"/>
        <SolidColorBrush x:Key="Chart.BgBlue"     Color="#DBEAFE"/>
        <SolidColorBrush x:Key="Chart.BgPurple"   Color="#EDE9FE"/>
        <SolidColorBrush x:Key="Chart.BgGreen"    Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Chart.BgAmber"    Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Chart.BgRed"      Color="#FEE2E2"/>

        <!-- ═══════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════ -->

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="T.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.CardSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,3,0,0"/>
        </Style>

        <Style x:Key="T.TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell.Muted" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════
             CARD SURFACES
        ═══════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <Style x:Key="Card.Kpi.Blue" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Kpi.Green" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Kpi.Purple" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource AI.Border}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Kpi.Teal" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Chart.Teal}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <!-- ═══════════════════════════════
             BADGES
        ═══════════════════════════════ -->
        <Style x:Key="Badge.Success" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.SuccessBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <Style x:Key="Badge.Warning" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.WarningBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <Style x:Key="Badge.Danger" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.DangerBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Danger}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <Style x:Key="Badge.Muted" TargetType="Border">
            <Setter Property="Background"      Value="#F1F5F9"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <!-- ═══════════════════════════════
             TABLE ROW
        ═══════════════════════════════ -->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>

        <!-- ═══════════════════════════════
             BUTTONS
        ═══════════════════════════════ -->
        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Outlined" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Student search/select dropdown style -->
        <Style x:Key="Btn.StudentSearch" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         PAGE BODY
    ═══════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <Button Click="BackButton_Click"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,14"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Back"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ─────────────────────────────────────────
                 STUDENT SELECTOR
            ───────────────────────────────────────── -->
            <Button Style="{StaticResource Btn.StudentSearch}"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               Text="Search and select a specific student to view their individual report..."
                               FontSize="13"
                               Foreground="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="&#xE70D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- ─────────────────────────────────────────
                 EXAM SELECTOR — only shown when this page was opened
                 generically (no specific exam), i.e. via the "View Student
                 Reports" quick-nav rather than a specific exam's "View
                 Report" button. Statistics stay hidden until one is chosen.
            ───────────────────────────────────────── -->
            <Border x:Name="ExamSelectorContainer"
                    Style="{StaticResource Card}"
                    Padding="20" Margin="0,0,0,24"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="SELECT AN EXAM TO VIEW ITS REPORT"
                               Style="{StaticResource T.SectionLabel}"
                               Margin="0,0,0,10"/>
                    <ComboBox x:Name="ExamSelectorCombo"
                              DisplayMemberPath="Title"
                              SelectionChanged="ExamSelectorCombo_SelectionChanged"
                              FontSize="13" Padding="10,8"
                              HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Statistics won't display until you choose a specific exam above."
                               FontSize="11" Foreground="{StaticResource Text.Muted}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="StatisticsSections" Visibility="Collapsed">

            <!-- ─────────────────────────────────────────
                 SECTION 1 — AGGREGATE CLASS METRICS
            ───────────────────────────────────────── -->
            <TextBlock Text="AGGREGATE CLASS METRICS"
                       Style="{StaticResource T.SectionLabel}"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Class Average -->
                <Border Grid.Column="0" Style="{StaticResource Card.Kpi.Blue}">
                    <StackPanel>
                        <TextBlock Text="Class Average"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="ClassAverageValue" Text="—"
                                   Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock x:Name="ClassAverageSub" Text="No graded submissions yet"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Integrity Index (rule-based from flag counts, not AI) -->
                <Border Grid.Column="2" Style="{StaticResource Card.Kpi.Green}">
                    <StackPanel>
                        <TextBlock Text="Integrity Index"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="IntegrityIndexValue" Text="—"
                                   Style="{StaticResource T.KpiNumber}"
                                   Foreground="{StaticResource Status.Success}"/>
                        <TextBlock x:Name="IntegrityIndexSub" Text="No monitoring data yet"
                                   FontSize="11"
                                   Foreground="{StaticResource Status.Success}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: AI Accuracy Rate — PENDING: requires an AI-generated baseline
                     score to compare against instructor grades, which doesn't exist yet. -->
                <Border Grid.Column="4" Style="{StaticResource Card.Kpi.Purple}">
                    <StackPanel>
                        <TextBlock Text="AI Accuracy Rate"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="—"
                                   Style="{StaticResource T.KpiNumber}"
                                   Foreground="{StaticResource AI.Text}"/>
                        <TextBlock Text="AI grading not yet integrated"
                                   FontSize="11"
                                   Foreground="{StaticResource AI.Text}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Completion -->
                <Border Grid.Column="6" Style="{StaticResource Card.Kpi.Teal}">
                    <StackPanel>
                        <TextBlock Text="Completion Rate"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="CompletionRateValue" Text="—"
                                   Style="{StaticResource T.KpiNumber}"
                                   Foreground="{StaticResource Chart.Teal}"/>
                        <TextBlock x:Name="CompletionRateSub" Text="No attempts yet"
                                   FontSize="11"
                                   Foreground="{StaticResource Chart.Teal}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ─────────────────────────────────────────
                 SECTION 2 — VISUAL INSIGHTS
            ───────────────────────────────────────── -->
            <TextBlock Text="VISUAL INSIGHTS &amp; DATA VISUALIZATION"
                       Style="{StaticResource T.SectionLabel}"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CHART 1: AI vs Human Override (Donut)
                     PENDING: needs an AI-generated baseline score to compare
                     against instructor grades. No such data exists yet, so this
                     chart is still showing its original static mock numbers. -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="AI vs. Instructor Override"
                                   Style="{StaticResource T.CardTitle}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="Grade shifts made by instructor vs. AI baseline — pending AI integration"
                                   Style="{StaticResource T.CardSubtitle}"
                                   Margin="0,0,0,16"/>

                        <!-- Donut chart simulation -->
                        <Grid Height="140" Margin="0,0,0,16">
                            <Ellipse Width="120" Height="120"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"
                                     Stroke="{StaticResource Chart.BgBlue}"
                                     StrokeThickness="20"/>
                            <!-- Simulated arc segments using rotation -->
                            <Ellipse Width="120" Height="120"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"
                                     Stroke="{StaticResource Chart.Blue}"
                                     StrokeThickness="20"
                                     StrokeDashArray="2.2 1"/>
                            <Ellipse Width="120" Height="120"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"
                                     Stroke="{StaticResource Chart.Purple}"
                                     StrokeThickness="20"
                                     StrokeDashArray="0.88 3.12">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="198"
                                                     CenterX="60"
                                                     CenterY="60"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Center label -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="88%"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource Text.Primary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Match"
                                           FontSize="10"
                                           Foreground="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Legend -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{StaticResource Chart.Blue}"
                                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="AI Score Accepted"
                                           FontSize="12"
                                           Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="88%"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Chart.Blue}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{StaticResource Chart.Purple}"
                                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Instructor Override"
                                           FontSize="12"
                                           Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="12%"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Chart.Purple}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CHART 2: Infraction Breakdown (Pie) -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Infraction Breakdown"
                                   Style="{StaticResource T.CardTitle}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="Gaze deviation, window switching, clipboard use"
                                   Style="{StaticResource T.CardSubtitle}"
                                   Margin="0,0,0,16"/>

                        <!-- Pie chart simulation using stacked arcs.
                             NOTE: the wedge proportions below are the original
                             static illustration — recomputing them precisely
                             would need real dash-array trigonometry against a
                             proper charting control. The counts (center total +
                             legend numbers) ARE real, pulled from AuditLogs. -->
                        <Grid Height="140" Margin="0,0,0,16">
                            <!-- Base circle -->
                            <Ellipse Width="120" Height="120"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource Chart.BgAmber}"/>
                            <!-- Segment 1: Gaze -->
                            <Ellipse x:Name="GazeSegment" Width="120" Height="120"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"
                                     Stroke="{StaticResource Chart.Amber}"
                                     StrokeThickness="40"
                                     StrokeDashArray="0 9.42">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="GazeSegmentRotate" Angle="-90"
                                                     CenterX="60" CenterY="60"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Segment 2: Window -->
                            <Ellipse x:Name="WindowSegment" Width="120" Height="120"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"
                                     Stroke="{StaticResource Chart.Red}"
                                     StrokeThickness="40"
                                     StrokeDashArray="0 9.42">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="WindowSegmentRotate" Angle="-90"
                                                     CenterX="60" CenterY="60"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Segment 3: Clipboard -->
                            <Ellipse x:Name="ClipboardSegment" Width="120" Height="120"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"
                                     Stroke="{StaticResource Chart.Blue}"
                                     StrokeThickness="40"
                                     StrokeDashArray="0 9.42">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="ClipboardSegmentRotate" Angle="-90"
                                                     CenterX="60" CenterY="60"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- White center hole -->
                            <Ellipse Width="56" Height="56"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource Bg.Surface}"/>
                            <TextBlock x:Name="InfractionTotalLabel" Text="0"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Legend -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{StaticResource Chart.Amber}"
                                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Gaze Deviation"
                                           FontSize="12"
                                           Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="GazeDeviationCount" Text="0"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Chart.Amber}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{StaticResource Chart.Red}"
                                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Window Switch"
                                           FontSize="12"
                                           Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="WindowSwitchCount" Text="0"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Chart.Red}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{StaticResource Chart.Blue}"
                                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clipboard / Paste"
                                           FontSize="12"
                                           Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="ClipboardCount" Text="0"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Chart.Blue}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CHART 3: Section Performance
                     Real data — average % score per section (Identification/
                     TOF/Code/etc.) across every graded student in this exam,
                     reusing ExamScoresService's per-section breakdown. Number
                     of sections varies per exam, so this is a dynamic bar
                     list (built in code-behind) rather than a fixed radar. -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Section Performance"
                                   Style="{StaticResource T.CardTitle}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="Average score per section, across all graded students"
                                   Style="{StaticResource T.CardSubtitle}"
                                   Margin="0,0,0,16"/>

                        <ItemsControl x:Name="SectionPerformanceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SectionName}"
                                                   FontSize="11" Foreground="{StaticResource Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Height="6" CornerRadius="3"
                                                Background="{StaticResource Chart.BgBlue}"
                                                VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}"
                                                    Height="6" CornerRadius="3"
                                                    Background="{StaticResource Chart.Blue}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Chart.Blue}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="SectionPerformanceEmptyHint"
                                   Text="No fully-graded sections yet."
                                   FontSize="12" Foreground="{StaticResource Text.Muted}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ─────────────────────────────────────────
                 SECTION 3 — DETAILED PERFORMANCE TABLE
            ───────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="DETAILED PERFORMANCE DATA"
                           Style="{StaticResource T.SectionLabel}"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource Bg.Surface}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="8,2" Margin="12,0,0,0">
                    <TextBlock Text="Exportable"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Secondary}"/>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>

                    <!-- Table Header -->
                    <Border Background="{StaticResource Bg.TableHeader}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="STUDENT"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="1" Text="AI SCORE (PENDING)"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="2" Text="FINAL GRADE"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="3" Text="AI CONF. (PENDING)"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="4" Text="ANOMALIES"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="5" Text="ACTION"
                                       Style="{StaticResource T.TableHeader}"/>
                        </Grid>
                    </Border>

                    <!-- Empty state -->
                    <Border x:Name="EmptyStateBanner" Padding="16,20" Visibility="Collapsed">
                        <TextBlock Text="No graded submissions yet."
                                   FontSize="13"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </Border>

                    <!-- Rows populated at runtime by ReportsTab.xaml.cs -->
                    <StackPanel x:Name="ReportRowsPanel"/>

                </StackPanel>
            </Border>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
