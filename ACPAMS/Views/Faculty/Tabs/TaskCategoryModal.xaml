<Window x:Class="ACPAMS.Views.Faculty.TaskCategoryModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Task"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ── Design tokens ── -->
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Hover"         Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.Hover"     Color="#1565C0"/>
        <SolidColorBrush x:Key="Accent.Pressed"   Color="#0D47A1"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Overlay"          Color="#1A202C"/>

        <!-- Continue button -->
        <Style x:Key="Btn.Continue" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Border.Medium}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel button -->
        <Style x:Key="Btn.Cancel" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Bg.Base}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category option card — unselected -->
        <Style x:Key="Btn.CategoryOption" TargetType="Button">
            <Setter Property="Background"                 Value="{StaticResource Bg.Base}"/>
            <Setter Property="BorderBrush"                Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness"            Value="1.5"/>
            <Setter Property="Padding"                    Value="16,14"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin"                     Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Bg.Hover}"/>
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category option card — selected -->
        <Style x:Key="Btn.CategoryOption.Selected" TargetType="Button"
               BasedOn="{StaticResource Btn.CategoryOption}">
            <Setter Property="Background"      Value="{StaticResource Accent.PrimaryBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource Accent.PrimaryBg}"
                                BorderBrush="{StaticResource Accent.Primary}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="16,14">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Scrim overlay -->
    <Grid>
        <Border Background="{StaticResource Overlay}" Opacity="0.50"/>

        <!-- Modal card -->
        <Border Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="12"
                Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#1A202C"
                                  Opacity="0.22"
                                  BlurRadius="40"
                                  ShadowDepth="10"/>
            </Border.Effect>

            <StackPanel>

                <!-- Header -->
                <StackPanel Margin="28,28,28,20">

                    <!-- Step indicator -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="{StaticResource Accent.PrimaryBg}"
                                BorderBrush="{StaticResource Accent.Primary}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3">
                            <TextBlock Text="S T E P   1   O F   3"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Accent.Primary}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Before we start..."
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Select the type of task you want to create for your students."
                               FontSize="13"
                               Foreground="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Divider -->
                <Border Height="1"
                        Background="{StaticResource Border.Subtle}"
                        Margin="0,0,0,20"/>

                <!-- Category options -->
                <StackPanel Margin="28,0,28,0">

                    <TextBlock Text="Task Category"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Secondary}"
                               Margin="0,0,0,10"/>

                    <!-- Examination -->
                    <Button x:Name="BtnExamination"
                            Style="{StaticResource Btn.CategoryOption.Selected}"
                            Tag="Examination"
                            Click="CategoryOption_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    Background="{StaticResource Accent.Primary}"
                                    CornerRadius="8"
                                    Margin="0,0,14,0">
                                <TextBlock Text="&#xE8FD;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Label + description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Examination"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent.Primary}"/>
                                <TextBlock Text="Formal graded assessment with time limit"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"/>
                            </StackPanel>

                            <!-- Selected checkmark -->
                            <Border Grid.Column="2" x:Name="ExamCheck"
                                    Width="20" Height="20"
                                    Background="{StaticResource Accent.Primary}"
                                    CornerRadius="10">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Quiz -->
                    <Button x:Name="BtnQuiz"
                            Style="{StaticResource Btn.CategoryOption}"
                            Tag="Quiz"
                            Click="CategoryOption_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    Background="{StaticResource Bg.Base}"
                                    BorderBrush="{StaticResource Border.Medium}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,14,0">
                                <TextBlock Text="&#xE9D9;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{StaticResource Text.Secondary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Quiz"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="Short, low-stakes knowledge check"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"/>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Width="20" Height="20"
                                    BorderBrush="{StaticResource Border.Medium}"
                                    BorderThickness="1.5"
                                    CornerRadius="10">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Activity -->
                    <Button x:Name="BtnActivity"
                            Style="{StaticResource Btn.CategoryOption}"
                            Tag="Activity"
                            Margin="0,0,0,0"
                            Click="CategoryOption_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    Background="{StaticResource Bg.Base}"
                                    BorderBrush="{StaticResource Border.Medium}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,14,0">
                                <TextBlock Text="&#xE7FC;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{StaticResource Text.Secondary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Activity"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="Practice exercise or lab assignment"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"/>
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Width="20" Height="20"
                                    BorderBrush="{StaticResource Border.Medium}"
                                    BorderThickness="1.5"
                                    CornerRadius="10">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                    </Button>

                </StackPanel>

                <!-- Divider -->
                <Border Height="1"
                        Background="{StaticResource Border.Subtle}"
                        Margin="0,24,0,0"/>

                <!-- Footer -->
                <Grid Margin="28,16,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource Btn.Cancel}"
                            HorizontalAlignment="Left"
                            Content="Cancel"
                            Click="CancelButton_Click"/>

                    <Button Grid.Column="1"
                            x:Name="ContinueBtn"
                            Style="{StaticResource Btn.Continue}"
                            HorizontalAlignment="Right"
                            Click="ContinueButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Continue"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
