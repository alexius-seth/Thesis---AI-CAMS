<UserControl x:Class="ACPAMS.Views.Faculty.Tabs.GradingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Bg.Code"          Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Text.Code"        Color="#1E40AF"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>
        <SolidColorBrush x:Key="AI.Bg"            Color="#F5F3FF"/>
        <SolidColorBrush x:Key="AI.Border"        Color="#7C3AED"/>
        <SolidColorBrush x:Key="AI.Text"          Color="#5B21B6"/>

        <!-- ═══════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════ -->

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="T.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.Label" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.Body" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight"   Value="20"/>
        </Style>

        <Style x:Key="T.Code" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Code}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight"   Value="20"/>
        </Style>

        <!-- ═══════════════════════════════
             CARD SURFACES
        ═══════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <!-- KPI stripe variants -->
        <Style x:Key="Card.Kpi.Blue" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Kpi.Purple" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource AI.Border}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Kpi.Amber" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Kpi.Green" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <!-- Queue item — default -->
        <Style x:Key="Card.QueueItem" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- Queue item — selected/active -->
        <Style x:Key="Card.QueueItem.Active" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Accent.PrimaryBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding"         Value="13,14"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- ═══════════════════════════════
             BADGES
        ═══════════════════════════════ -->
        <Style x:Key="Badge.Pending" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.WarningBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <Style x:Key="Badge.Success" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.SuccessBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <Style x:Key="Badge.Danger" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.DangerBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Danger}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <Style x:Key="Badge.AI" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource AI.Bg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AI.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <!-- ═══════════════════════════════
             FILTER DROPDOWN BUTTON
        ═══════════════════════════════ -->
        <Style x:Key="Btn.Filter" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action -->
        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grade input box -->
        <Style x:Key="Input.Grade" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="22"/>
            <Setter Property="FontWeight"               Value="Bold"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness"          Value="2"/>
            <Setter Property="Padding"                  Value="12,8"/>
            <Setter Property="TextAlignment"            Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width"                    Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         PAGE BODY — no outer scroll; inner panes scroll independently
    ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- KPI row -->
            <RowDefinition Height="*"/>      <!-- Split pane -->
        </Grid.RowDefinitions>

        <!-- ─────────────────────────────────────────
             SECTION 1 — GRADING PIPELINE KPIs
        ───────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="32,24,32,0">

            <TextBlock Text="GRADING PIPELINE"
                       Style="{StaticResource T.SectionLabel}"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Total Submissions -->
                <Border Grid.Column="0" Style="{StaticResource Card.Kpi.Blue}">
                    <StackPanel>
                        <TextBlock Text="Total Submissions"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="44"
                                   Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock Text="This assessment"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: AI Auto-Graded (purple = AI) -->
                <Border Grid.Column="2" Style="{StaticResource Card.Kpi.Purple}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="AI Auto-Graded"
                                       Style="{StaticResource T.KpiLabel}"/>
                        </StackPanel>
                        <TextBlock Text="44"
                                   Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock Text="100% pre-scored by AI"
                                   FontSize="11"
                                   Foreground="{StaticResource AI.Text}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Pending Review -->
                <Border Grid.Column="4" Style="{StaticResource Card.Kpi.Amber}">
                    <StackPanel>
                        <TextBlock Text="Pending Review"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="12"
                                   Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock Text="Awaiting instructor sign-off"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Finalized -->
                <Border Grid.Column="6" Style="{StaticResource Card.Kpi.Green}">
                    <StackPanel>
                        <TextBlock Text="Finalized"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="32"
                                   Style="{StaticResource T.KpiNumber}"
                                   Foreground="{StaticResource Status.Success}"/>
                        <TextBlock Text="Grades locked"
                                   FontSize="11"
                                   Foreground="{StaticResource Status.Success}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </StackPanel>

        <!-- ─────────────────────────────────────────
             SECTION 2 — MASTER / DETAIL SPLIT PANE
        ───────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="32,0,32,32">
            <Grid.ColumnDefinitions>
                <!-- Left queue: 30% -->
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition Width="16"/>
                <!-- Right canvas: 70% -->
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════
                 LEFT — SUBMISSION QUEUE
            ══════════════════ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Queue header + filter -->
                        <RowDefinition Height="*"/>      <!-- Scrollable list -->
                    </Grid.RowDefinitions>

                    <!-- Queue header -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Submission Queue"
                                           Style="{StaticResource T.CardTitle}"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Badge.Pending}"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="12 Pending"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource Status.Warning}"/>
                                </Border>
                            </StackPanel>
                            <!-- Filter button -->
                            <Button Style="{StaticResource Btn.Filter}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Filter: Pending Review"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Queue list -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Queue Item 1: J. Doe — SELECTED (active) -->
                            <Border Style="{StaticResource Card.QueueItem.Active}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Background="{StaticResource Accent.PrimaryBg}"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="JD"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent.Primary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="J. Doe"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text.Primary}"/>
                                            <TextBlock Text="PC-04"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TYPE"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Text="Code (Java)"
                                                       FontSize="12" FontWeight="Medium"
                                                       Foreground="{StaticResource Text.Primary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="AI BASELINE"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Text="85 / 100"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent.Primary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Badge.Pending}"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0">
                                        <TextBlock Text="Pending Review"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Status.Warning}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Queue Item 2: A. Smith -->
                            <Border Style="{StaticResource Card.QueueItem}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Background="#E2E8F0"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="AS"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="A. Smith"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text.Primary}"/>
                                            <TextBlock Text="PC-07"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TYPE"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Text="Code (C)"
                                                       FontSize="12" FontWeight="Medium"
                                                       Foreground="{StaticResource Text.Primary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="AI BASELINE"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Text="40 / 100"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Status.Danger}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Badge.Danger}"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0">
                                        <TextBlock Text="Pending Review"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Status.Danger}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Queue Item 3: B. Wayne -->
                            <Border Style="{StaticResource Card.QueueItem}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Background="#E2E8F0"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="BW"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="B. Wayne"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text.Primary}"/>
                                            <TextBlock Text="PC-12"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TYPE"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Text="Essay"
                                                       FontSize="12" FontWeight="Medium"
                                                       Foreground="{StaticResource Text.Primary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="AI BASELINE"
                                                       Style="{StaticResource T.Label}"/>
                                            <TextBlock Text="95 / 100"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Status.Success}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Badge.Pending}"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0">
                                        <TextBlock Text="Pending Review"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Status.Warning}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

            <!-- ══════════════════
                 RIGHT — ACTIVE GRADING CANVAS
            ══════════════════ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Canvas header -->
                        <RowDefinition Height="*"/>      <!-- Scrollable content -->
                        <RowDefinition Height="Auto"/>   <!-- Grade + submit footer -->
                    </Grid.RowDefinitions>

                    <!-- Canvas header -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="24,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Active Grading Canvas"
                                           Style="{StaticResource T.CardTitle}"
                                           Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="J. Doe  ·  PC-04  ·  Code (Java)"
                                               FontSize="12"
                                               Foreground="{StaticResource Text.Muted}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge.AI}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="AI Pre-Scored"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource AI.Text}"/>
                                </Border>
                                <Border Background="{StaticResource Accent.PrimaryBg}"
                                        BorderBrush="{StaticResource Accent.Primary}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="Baseline: 85 / 100"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent.Primary}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable canvas content -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,20,24,0">
                        <StackPanel>

                            <!-- Assessment prompt -->
                            <TextBlock Text="ASSESSMENT PROMPT"
                                       Style="{StaticResource T.SectionLabel}"
                                       Margin="0,0,0,6"/>
                            <Border Background="{StaticResource Bg.Base}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="14,12" Margin="0,0,0,20">
                                <TextBlock Style="{StaticResource T.Body}"
                                           Text="Write a Java method that accepts a String array and returns a new array with the elements in reversed order. Your solution must handle null inputs and empty arrays gracefully."/>
                            </Border>

                            <!-- Student submission code block -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="STUDENT SUBMISSION"
                                           Style="{StaticResource T.SectionLabel}"
                                           VerticalAlignment="Center"/>
                                <Border Background="#F1F5F9"
                                        BorderBrush="{StaticResource Border.Medium}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="7,2" Margin="10,0,0,0">
                                    <TextBlock Text="Read-Only"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Secondary}"/>
                                </Border>
                            </StackPanel>
                            <Border Background="#1E293B"
                                    BorderBrush="#334155"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="16,14" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Line numbers + code simulation -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="1" FontFamily="Consolas" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBlock Text="2" FontFamily="Consolas" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBlock Text="3" FontFamily="Consolas" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBlock Text="4" FontFamily="Consolas" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBlock Text="5" FontFamily="Consolas" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBlock Text="6" FontFamily="Consolas" FontSize="12" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBlock Text="7" FontFamily="Consolas" FontSize="12" Foreground="#475569"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,0,0,2">
                                                <Run Foreground="#7DD3FC">public</Run>
                                                <Run Foreground="#F8FAFC"> String[] </Run>
                                                <Run Foreground="#86EFAC">reverse</Run>
                                                <Run Foreground="#F8FAFC">(String[] arr) {</Run>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,2">    // null check missing</TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,0,0,2">
                                                <Run Foreground="#F8FAFC">    </Run>
                                                <Run Foreground="#7DD3FC">int</Run>
                                                <Run Foreground="#F8FAFC"> n = arr.length;</Run>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,0,0,2">
                                                <Run Foreground="#F8FAFC">    String[] result = </Run>
                                                <Run Foreground="#7DD3FC">new</Run>
                                                <Run Foreground="#F8FAFC"> String[n];</Run>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,0,0,2">
                                                <Run Foreground="#7DD3FC">    for</Run>
                                                <Run Foreground="#F8FAFC"> (</Run>
                                                <Run Foreground="#7DD3FC">int</Run>
                                                <Run Foreground="#F8FAFC"> i = 0; i &lt; n; i++)</Run>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,0,0,2">
                                                <Run Foreground="#F8FAFC">        result[i] = arr[n - 1 - i];</Run>
                                            </TextBlock>
                                            <TextBlock FontFamily="Consolas" FontSize="12">
                                                <Run Foreground="#7DD3FC">    return</Run>
                                                <Run Foreground="#F8FAFC"> result; }</Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- AI Evaluation Justification -->
                            <TextBlock Text="AI EVALUATION JUSTIFICATION"
                                       Style="{StaticResource T.SectionLabel}"
                                       Margin="0,0,0,6"/>
                            <Border Background="{StaticResource AI.Bg}"
                                    BorderBrush="{StaticResource AI.Border}"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="6"
                                    Padding="16,14"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xE9D2;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AI.Border}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="AI-Generated Evaluation"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AI.Text}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource Bg.Surface}"
                                                BorderBrush="{StaticResource AI.Border}"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="Score: 85 / 100"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource AI.Text}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource T.Body}"
                                               Foreground="{StaticResource AI.Text}"
                                               Text="Logic is sound and the reversal algorithm is correct. However, the method does not handle a null input array, which would cause a NullPointerException at runtime. Rubric deduction of 15 points applied under the 'Edge Case Handling' criterion. Syntax and structure are otherwise clean."/>
                                </StackPanel>
                            </Border>

                            <!-- Rubric breakdown -->
                            <Border Background="{StaticResource Bg.Base}"
                                    BorderBrush="{StaticResource Border.Subtle}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="14,12" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="RUBRIC BREAKDOWN"
                                               Style="{StaticResource T.SectionLabel}"
                                               Margin="0,0,0,10"/>
                                    <!-- Rubric row 1 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Correctness of Logic"
                                                   FontSize="12" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="40 / 40"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Status.Success}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Rubric row 2 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Edge Case Handling"
                                                   FontSize="12" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="25 / 40"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Status.Warning}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Rubric row 3 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Code Style &amp; Syntax"
                                                   FontSize="12" Foreground="{StaticResource Text.Primary}"/>
                                        <TextBlock Grid.Column="1" Text="20 / 20"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Status.Success}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── GRADE + SUBMIT FOOTER (sticky bottom) ── -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Bg.Surface}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Grade input -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="FINAL INSTRUCTOR GRADE"
                                           Style="{StaticResource T.SectionLabel}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>
                                <TextBox Style="{StaticResource Input.Grade}"
                                         Text="80"/>
                                <TextBlock Text="/ 100"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                                <TextBlock Text="(AI suggested: 85)"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"/>
                            </StackPanel>

                            <!-- Submit button -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource Btn.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="White"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Submit &amp; Finalize Grade"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </Grid>
                    </Border>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
