<UserControl x:Class="ACPAMS.Views.Faculty.Tabs.GradingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ACPAMS.Views.Faculty.Tabs"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS  (unchanged from your original)
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Bg.Code"          Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Text.Code"        Color="#1E40AF"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>
        <SolidColorBrush x:Key="AI.Bg"            Color="#F5F3FF"/>
        <SolidColorBrush x:Key="AI.Border"        Color="#7C3AED"/>
        <SolidColorBrush x:Key="AI.Text"          Color="#5B21B6"/>

        <!-- Used by the AI assessment panel's Visibility bindings — this was
             missing entirely and is what caused the StaticResourceHolder crash. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- TYPOGRAPHY -->
        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.Label" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.Body" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight"   Value="20"/>
        </Style>

        <!-- CARD SURFACES -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <Style x:Key="Card.QueueItem" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- BADGES -->
        <Style x:Key="Badge.Success" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.SuccessBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <Style x:Key="Badge.Pending" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.WarningBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="7,2"/>
        </Style>

        <!-- Queue item — selected state via DataTrigger instead of two separate styles -->
        <Style x:Key="Card.QueueItem.Dynamic" TargetType="Border" BasedOn="{StaticResource Card.QueueItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    <Setter Property="Padding" Value="13,14"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-question points input -->
        <Style x:Key="Input.Points" TargetType="TextBox">
            <Setter Property="FontSize"                 Value="16"/>
            <Setter Property="FontWeight"               Value="Bold"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness"          Value="2"/>
            <Setter Property="Padding"                  Value="8,5"/>
            <Setter Property="TextAlignment"            Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width"                    Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─────────────────────────────────────────
             SECTION 1 — GRADING PIPELINE KPIs
        ───────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="32,24,32,0">

            <Button Click="BackButton_Click"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,14"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Back"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="GRADING PIPELINE"
                       Style="{StaticResource T.SectionLabel}"
                       Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Total Submissions -->
                <Border Grid.Column="0" Style="{StaticResource Card}"
                        BorderBrush="{StaticResource Accent.Primary}"
                        BorderThickness="3,1,1,1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Total Submissions" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalSubmissions}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="Across all sections"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: AI Auto-Graded -->
                <Border Grid.Column="2" Style="{StaticResource Card}"
                        BorderBrush="{StaticResource AI.Border}"
                        BorderThickness="3,1,1,1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="AI Auto-Graded" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding AiAutoGraded}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="AI grading not yet integrated"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Pending Review -->
                <Border Grid.Column="4" Style="{StaticResource Card}"
                        BorderBrush="{StaticResource Status.Warning}"
                        BorderThickness="3,1,1,1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Pending Review" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding PendingReview}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="Awaiting instructor sign-off"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Finalized -->
                <Border Grid.Column="6" Style="{StaticResource Card}"
                        BorderBrush="{StaticResource Status.Success}"
                        BorderThickness="3,1,1,1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Finalized" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Finalized}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource Status.Success}"/>
                        <TextBlock Text="Grades locked"
                                   FontSize="11"
                                   Foreground="{StaticResource Status.Success}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </StackPanel>

        <!-- MASTER / DETAIL SPLIT -->
        <Grid Grid.Row="1" Margin="32,0,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════ LEFT — SECTIONED SUBMISSION QUEUE ══════════════════ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="Submission Queue" Style="{StaticResource T.CardTitle}"/>
                    </Border>

                    <!-- Grouped by section: outer ItemsControl over SectionGroups,
                         inner ItemsControl over each group's Attempts -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SectionGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Section header -->
                                        <Border Background="{StaticResource Bg.TableHeader}"
                                                BorderBrush="{StaticResource Border.Subtle}"
                                                BorderThickness="0,0,0,1"
                                                Padding="16,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SectionName}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource Text.Secondary}"/>
                                                <TextBlock Text="{Binding Attempts.Count, StringFormat=' ({0})'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Text.Muted}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Attempts within this section -->
                                        <ItemsControl ItemsSource="{Binding Attempts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card.QueueItem.Dynamic}"
                                                            MouseLeftButtonUp="QueueItem_Clicked">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <Border Width="26" Height="26" CornerRadius="13"
                                                                        Background="{StaticResource Accent.PrimaryBg}"
                                                                        Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding StudentInitials}"
                                                                               FontSize="9" FontWeight="Bold"
                                                                               Foreground="{StaticResource Accent.Primary}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StudentName}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource Text.Primary}"/>
                                                                    <TextBlock Text="{Binding PcLabel}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource Text.Muted}"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Border HorizontalAlignment="Left" Margin="0,6,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Pending}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFullyGraded}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource Status.SuccessBg}"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Pending Review"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFullyGraded}" Value="True">
                                                                                    <Setter Property="Text" Value="Graded"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════════════════ RIGHT — ALL QUESTIONS FOR SELECTED ATTEMPT ══════════════════ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Numbered question list -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="24,20,24,0">
                        <ItemsControl ItemsSource="{Binding CurrentQuestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg.Base}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="16,14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <!-- Question number + type -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Background="{StaticResource Accent.Primary}"
                                                        CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                                                    <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                        <Run Text="Q"/><Run Text="{Binding QuestionNumber}"/>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding QuestionType}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Text.Muted}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Prompt -->
                                            <TextBlock Text="{Binding QuestionText}"
                                                       Style="{StaticResource T.Body}"
                                                       Margin="0,0,0,10"/>

                                            <!-- Student's answer -->
                                            <TextBlock Text="STUDENT ANSWER"
                                                       Style="{StaticResource T.SectionLabel}"
                                                       Margin="0,0,0,4"/>
                                            <Border Background="{StaticResource Bg.Surface}"
                                                    BorderBrush="{StaticResource Border.Medium}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="10,8" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding StudentAnswerText}"
                                                           Style="{StaticResource T.Body}"/>
                                            </Border>

                                            <!-- AI grading failed — shown instead of a score, not silently blank -->
                                            <Border Background="{StaticResource Status.DangerBg}"
                                                    BorderBrush="{StaticResource Status.Danger}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="10,8" Margin="0,0,0,10"
                                                    Visibility="{Binding AiGradingFailed, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE783;"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{StaticResource Status.Danger}"
                                                               Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                    <StackPanel>
                                                        <TextBlock Text="AI grading failed for this answer"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Status.Danger}"/>
                                                        <TextBlock Text="{Binding AiGradingError}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Status.Danger}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <TextBlock Text="Grade this manually below."
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource Text.Muted}"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- AI assessment — badge + overall feedback + per-criterion breakdown -->
                                            <Border BorderBrush="{StaticResource AI.Border}"
                                                    Background="{StaticResource AI.Bg}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="12,10" Margin="0,0,0,10"
                                                    Visibility="{Binding HasAiBreakdown, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="&#xE9D2;"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                   Foreground="{StaticResource AI.Text}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="AI ASSESSMENT"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource AI.Text}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                        <!-- Badge flips once the instructor edits & saves (GradedBy → "instructor") -->
                                                        <Border Background="{StaticResource Status.WarningBg}"
                                                                BorderBrush="{StaticResource Status.Warning}"
                                                                BorderThickness="1" CornerRadius="10"
                                                                Padding="7,1"
                                                                Visibility="{Binding IsAiSuggested, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="AI-Suggested — Pending Your Review"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Status.Warning}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding AiOverallFeedback}"
                                                               Style="{StaticResource T.Body}"
                                                               FontStyle="Italic"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,8"/>

                                                    <ItemsControl ItemsSource="{Binding AiCriteriaBreakdown}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource AI.Border}"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="0,6">
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding CriteriaName}"
                                                                                       FontSize="12" FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource Text.Primary}"/>
                                                                            <TextBlock Text=" — "
                                                                                       FontSize="12"
                                                                                       Foreground="{StaticResource Text.Muted}"/>
                                                                            <TextBlock Text="{Binding MatchedTier}"
                                                                                       FontSize="12" FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource AI.Text}"/>
                                                                            <TextBlock Text=" ("
                                                                                       FontSize="12"
                                                                                       Foreground="{StaticResource Text.Muted}"/>
                                                                            <TextBlock Text="{Binding AwardedScore}"
                                                                                       FontSize="12" FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource Text.Primary}"/>
                                                                            <TextBlock Text=" pts)"
                                                                                       FontSize="12"
                                                                                       Foreground="{StaticResource Text.Muted}"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Justification}"
                                                                                   FontSize="12"
                                                                                   Foreground="{StaticResource Text.Secondary}"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- Editable points -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="POINTS"
                                                           Style="{StaticResource T.SectionLabel}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <TextBox Style="{StaticResource Input.Points}"
                                                         Text="{Binding ObtainedPoints, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                                                <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                                                           FontSize="13" Foreground="{StaticResource Text.Secondary}">
                                                    <Run Text="/"/><Run Text="{Binding MaxPoints}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Save footer -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Bg.Surface}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <StackPanel HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Primary}"
                                    Content="Save Grades"
                                    Click="SaveGrades_Click"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Grid>

</UserControl>
