<UserControl x:Class="ACPAMS.Views.Faculty.Tabs.MonitoringTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ACPAMS.Converters"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Live"      Color="#2E7D32"/>
        <SolidColorBrush x:Key="Status.LiveBg"    Color="#F0FDF4"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>

        <!-- ═══════════════════════════════
             CONVERTERS
        ═══════════════════════════════ -->
        <converters:RiskLevelToColorConverter x:Key="RiskLevelToColorConverter"/>
        <converters:RiskLevelToForegroundConverter x:Key="RiskLevelToForegroundConverter"/>
        <converters:FlagSeverityToColorConverter x:Key="FlagSeverityToColorConverter"/>

        <!-- ═══════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════ -->

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="T.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell.Muted" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.Timestamp" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontFamily"        Value="Consolas"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════
             CARD SURFACE
        ═══════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <Style x:Key="Card.Kpi.Blue" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Kpi.Amber" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Kpi.Red" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Danger}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <Style x:Key="Card.Investigation" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Danger}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="24,20"/>
        </Style>

        <!-- ═══════════════════════════════
             BADGES
        ═══════════════════════════════ -->
        <Style x:Key="Badge.Success" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.SuccessBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Warning" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.WarningBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Danger" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.DangerBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Danger}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Blue" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Accent.PrimaryBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <!-- ═══════════════════════════════
             TABLE ROW
        ═══════════════════════════════ -->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="14,11"/>
        </Style>

        <!-- Clickable Student Row -->
        <Style x:Key="TableRow.Clickable" TargetType="Border" BasedOn="{StaticResource TableRow}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════
             ACTION BUTTONS
        ═══════════════════════════════ -->
        <Style x:Key="Btn.Danger" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Status.Danger}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#7F0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Outlined" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.IssueWarning" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Status.Danger}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Dismiss Single Flag Button Style ─── -->
        <Style x:Key="Btn.DismissFlag" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="24"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="ToolTip"         Value="Dismiss this flag"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         PAGE BODY
    ═══════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- ─────────────────────────────────────────
                 SECTION 1 — LIVE SESSION METRICS KPIs
            ───────────────────────────────────────── -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LIVE SESSION METRICS" Style="{StaticResource T.SectionLabel}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Status.LiveBg}" BorderBrush="{StaticResource Status.Live}" BorderThickness="1" CornerRadius="4" Padding="10,3" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Status.Live}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Monitoring Live" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Status.Live}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource Btn.Outlined}"
                        Click="BackToHome_Click"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Back to Home" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Active Stations -->
                <Border Grid.Column="0" Style="{StaticResource Card.Kpi.Blue}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Accent.Primary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Active Stations" Style="{StaticResource T.KpiLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="ActiveStationsKpi" Text="0" Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock Text="Students currently testing" FontSize="11" Foreground="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Total Flags -->
                <Border Grid.Column="2" Style="{StaticResource Card.Kpi.Amber}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Status.Warning}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Total Flags" Style="{StaticResource T.KpiLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalFlagsKpi" Text="0" Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock Text="Across all active stations" FontSize="11" Foreground="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: High Risk Flags -->
                <Border Grid.Column="4" Style="{StaticResource Card.Kpi.Red}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE730;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Status.Danger}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="High Risk Flags" Style="{StaticResource T.KpiLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="HighRiskKpi" Text="0" Style="{StaticResource T.KpiNumber}" Foreground="{StaticResource Status.Danger}"/>
                        <TextBlock Text="Require immediate review" FontSize="11" Foreground="{StaticResource Status.Danger}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ─────────────────────────────────────────
                 SECTION 2 — TRACKER + BEHAVIORAL FEED
            ───────────────────────────────────────── -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Live Assessment Tracker -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Live Assessment Tracker" Style="{StaticResource T.CardTitle}" VerticalAlignment="Center"/>
                                <Border x:Name="ActiveBadge" Background="{StaticResource Accent.PrimaryBg}" BorderBrush="{StaticResource Accent.Primary}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="0 Active" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent.Primary}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Bg.TableHeader}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="STUDENT" Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="1" Text="STATION" Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource T.TableHeader}"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="TrackerItemsControl" ItemsSource="{Binding ActiveStudents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow.Clickable}" MouseLeftButtonUp="StudentItem_Clicked" Tag="{Binding AttemptId}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Selection Indicator -->
                                            <Border Grid.ColumnSpan="3" Background="Transparent" BorderBrush="{StaticResource Accent.Primary}" BorderThickness="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Accent.PrimaryBg}"/>
                                                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="{Binding RiskLevel, Converter={StaticResource RiskLevelToColorConverter}}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StudentInitials}" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding StudentName}" Style="{StaticResource T.TableCell}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Station}" Style="{StaticResource T.TableCell.Muted}"/>

                                            <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Padding="8,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Status.SuccessBg}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RiskLevel}" Value="high">
                                                                <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RiskLevel}" Value="medium">
                                                                <Setter Property="Background" Value="{StaticResource Status.WarningBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Warning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding RiskLevel, Converter={StaticResource RiskLevelToColorConverter}}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Testing"/>
                                                                <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="high">
                                                                        <Setter Property="Text" Value="⚠ Flagged"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="medium">
                                                                        <Setter Property="Text" Value="⚠ Warning"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding FlagCount}" FontSize="10" FontWeight="Bold" Foreground="{Binding RiskLevel, Converter={StaticResource RiskLevelToColorConverter}}" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- RIGHT: Real-Time Behavioral Feed -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Real-Time Behavioral Feed" Style="{StaticResource T.CardTitle}" VerticalAlignment="Center"/>
                                <Border x:Name="FlagBadge" Background="{StaticResource Status.WarningBg}" BorderBrush="{StaticResource Status.Warning}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="0 Flags" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Status.Warning}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Bg.TableHeader}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="30"/>
                                    <!-- ADD THIS COLUMN for dismiss button -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TIME" Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="1" Text="STUDENT" Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="2" Text="ALERT TYPE" Style="{StaticResource T.TableHeader}"/>
                                <TextBlock Grid.Column="3" Text="RISK" Style="{StaticResource T.TableHeader}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="" Style="{StaticResource T.TableHeader}"/>
                                <!-- Empty header for dismiss button -->
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="FeedItemsControl" ItemsSource="{Binding RecentFlags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Background="{Binding Action, Converter={StaticResource FlagSeverityToColorConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="30"/>
                                                <!-- ADD THIS COLUMN -->
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" Style="{StaticResource T.Timestamp}"/>

                                            <TextBlock Grid.Column="1" Text="Student" Style="{StaticResource T.TableCell}"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE7B3;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Action}" Value="NoFaceDetected">
                                                                    <Setter Property="Text" Value="&#xE7B3;"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="AltTabAttempt">
                                                                    <Setter Property="Text" Value="&#xE72E;"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="WindowFocusLost">
                                                                    <Setter Property="Text" Value="&#xE72E;"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="ClipboardAttempt">
                                                                    <Setter Property="Text" Value="&#xE8C8;"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="MultipleFacesDetected">
                                                                    <Setter Property="Text" Value="&#xE7C1;"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Action}" Style="{StaticResource T.TableCell.Muted}" FontSize="12"/>
                                            </StackPanel>

                                            <Border Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10" Padding="8,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Status.SuccessBg}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Action}" Value="NoFaceDetected">
                                                                <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="AltTabAttempt">
                                                                <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="WindowFocusLost">
                                                                <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="MultipleFacesDetected">
                                                                <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Action}" Value="ClipboardAttempt">
                                                                <Setter Property="Background" Value="{StaticResource Status.SuccessBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="L"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Action}" Value="ClipboardAttempt">
                                                                    <Setter Property="Text" Value="L"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="NoFaceDetected">
                                                                    <Setter Property="Text" Value="H"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="AltTabAttempt">
                                                                    <Setter Property="Text" Value="H"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="WindowFocusLost">
                                                                    <Setter Property="Text" Value="H"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="MultipleFacesDetected">
                                                                    <Setter Property="Text" Value="H"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- ─── DISMISS SINGLE FLAG BUTTON ─── -->
                                            <Button Grid.Column="4" 
                                                    Style="{StaticResource Btn.DismissFlag}"
                                                    Tag="{Binding LogId}"
                                                    Click="DismissSingleFlag_Click"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource Text.Muted}"/>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </Grid>

            <!-- ─────────────────────────────────────────
                 SECTION 3 — FOCUSED INVESTIGATION PANE
            ───────────────────────────────────────── -->
            <TextBlock Text="FOCUSED INVESTIGATION &amp; ACTION PANE" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,10"/>

            <Border Style="{StaticResource Card.Investigation}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Student Info Panel -->
                    <Border Grid.Column="0" Background="{StaticResource Bg.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Height="180" VerticalAlignment="Top" Padding="12">
                        <StackPanel>
                            <TextBlock Text="STUDENT SNAPSHOT" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,8"/>
                            <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource Status.DangerBg}" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Name="SelectedStudentInitials" Text="?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Status.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="SelectedStudentName" Text="Select a student" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SelectedStudentInfo" Text="" FontSize="11" Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                            <Border x:Name="SelectedRiskBadge" Style="{StaticResource Badge.Success}" Margin="0,6,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="SelectedRiskText" Text="" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Event History Panel -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                        <TextBlock Text="EVENT HISTORY" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,8"/>

                        <!-- Event History List -->
                        <Border Background="{StaticResource Bg.Base}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="0" Height="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="EventHistoryItemsControl" ItemsSource="{Binding SelectedStudentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss}}" Style="{StaticResource T.Timestamp}"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE7B3;"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Action}" Value="NoFaceDetected">
                                                                            <Setter Property="Text" Value="&#xE7B3;"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="AltTabAttempt">
                                                                            <Setter Property="Text" Value="&#xE72E;"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="WindowFocusLost">
                                                                            <Setter Property="Text" Value="&#xE72E;"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="MultipleFacesDetected">
                                                                            <Setter Property="Text" Value="&#xE7C1;"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="ClipboardAttempt">
                                                                            <Setter Property="Text" Value="&#xE8C8;"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Action}" FontSize="12" Foreground="{StaticResource Text.Primary}"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Padding="6,2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource Status.SuccessBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Action}" Value="NoFaceDetected">
                                                                        <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Action}" Value="AltTabAttempt">
                                                                        <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Action}" Value="WindowFocusLost">
                                                                        <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Action}" Value="MultipleFacesDetected">
                                                                        <Setter Property="Background" Value="{StaticResource Status.DangerBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Danger}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Action}" Value="ClipboardAttempt">
                                                                        <Setter Property="Background" Value="{StaticResource Status.SuccessBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Status.Success}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="9" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="LOW"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Action}" Value="NoFaceDetected">
                                                                            <Setter Property="Text" Value="HIGH"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="AltTabAttempt">
                                                                            <Setter Property="Text" Value="HIGH"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="WindowFocusLost">
                                                                            <Setter Property="Text" Value="HIGH"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="MultipleFacesDetected">
                                                                            <Setter Property="Text" Value="HIGH"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Danger}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Action}" Value="ClipboardAttempt">
                                                                            <Setter Property="Text" Value="MEDIUM"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Status.Warning}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="IssueWarningBtn" Style="{StaticResource Btn.Danger}" Margin="0,0,12,0" Click="IssueWarningFromInvestigation_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Issue Kiosk Warning" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DismissFlagBtn" Style="{StaticResource Btn.Outlined}" Content="Dismiss All Flags" Click="DismissFlagFromInvestigation_Click"/>
                            <Button x:Name="ViewFullReportBtn" Style="{StaticResource Btn.Outlined}" Content="View Full Report" Margin="8,0,0,0" Click="ViewFullReport_Click"/>
                        </StackPanel>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ─────────────────────────────────────────
                 SECTION 4 — REFRESH BUTTON
            ───────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource Btn.Outlined}" Content="🔄 Refresh" Click="RefreshButton_Click" Padding="16,8"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>