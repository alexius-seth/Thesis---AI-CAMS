<UserControl x:Class="ACPAMS.Views.Faculty.Tabs.OverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F5F7"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.TableHeader"   Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Live"      Color="#2E7D32"/>
        <SolidColorBrush x:Key="Status.LiveBg"    Color="#F0FDF4"/>
        <SolidColorBrush x:Key="Status.Warning"   Color="#B45309"/>
        <SolidColorBrush x:Key="Status.WarningBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="Status.Danger"    Color="#C62828"/>
        <SolidColorBrush x:Key="Status.DangerBg"  Color="#FEF2F2"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Chart.Bar"        Color="#1976D2"/>
        <SolidColorBrush x:Key="Chart.BarBg"      Color="#DBEAFE"/>

        <!-- ═══════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════ -->

        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.KpiNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="T.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="T.TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.TableCell.Muted" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.WeaknessItem" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <!-- ═══════════════════════════════
             CARD SURFACE
        ═══════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <!-- KPI card — left accent stripe (blue) -->
        <Style x:Key="Card.Kpi" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush"     Value="{StaticResource Accent.Primary}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="Padding"         Value="18,16"/>
        </Style>

        <!-- ═══════════════════════════════
             STATUS BADGES
        ═══════════════════════════════ -->
        <Style x:Key="Badge.Success" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.SuccessBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Success}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Warning" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.WarningBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Danger" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Status.DangerBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Status.Danger}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <Style x:Key="Badge.Muted" TargetType="Border">
            <Setter Property="Background"      Value="#F1F5F9"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="8,3"/>
        </Style>

        <!-- ═══════════════════════════════
             TABLE ROW
        ═══════════════════════════════ -->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════
         PAGE BODY (scrollable)
    ═══════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40">

            <!-- ─────────────────────────────────────────
                 SECTION 1 — CLASS SUMMARY KPI ROW
            ───────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,10">
                <TextBlock Text="CLASS SUMMARY"
                           Style="{StaticResource T.SectionLabel}"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource Bg.Surface}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,3"
                        Margin="12,0,0,0">
                    <TextBlock Text="CS101 — MIDTERMS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent.Primary}"/>
                </Border>
            </StackPanel>

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Students Taking -->
                <Border Grid.Column="0" Style="{StaticResource Card.Kpi}">
                    <StackPanel>
                        <TextBlock Text="Students Taking"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="44"
                                   Style="{StaticResource T.KpiNumber}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="6" Height="6"
                                     Fill="{StaticResource Status.Live}"
                                     Margin="0,0,5,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="In progress"
                                       FontSize="11"
                                       Foreground="{StaticResource Status.Live}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Students Finished -->
                <Border Grid.Column="2" Style="{StaticResource Card.Kpi}">
                    <StackPanel>
                        <TextBlock Text="Students Finished"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="6"
                                   Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock Text="of 50 enrolled"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Class Pass Rate -->
                <Border Grid.Column="4" Style="{StaticResource Card.Kpi}">
                    <StackPanel>
                        <TextBlock Text="Class Pass Rate"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="83%"
                                   Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock Text="Based on finished submissions"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Average Score -->
                <Border Grid.Column="6" Style="{StaticResource Card.Kpi}">
                    <StackPanel>
                        <TextBlock Text="Average Score"
                                   Style="{StaticResource T.KpiLabel}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="88"
                                   Style="{StaticResource T.KpiNumber}"/>
                        <TextBlock Text="out of 100"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ─────────────────────────────────────────
                 SECTION 2 — ASSESSMENT COMPLETION TABLE
            ───────────────────────────────────────── -->
            <TextBlock Text="ASSESSMENT COMPLETION STATUS"
                       Style="{StaticResource T.SectionLabel}"
                       Margin="0,0,0,10"/>

            <Border Style="{StaticResource Card}"
                    Padding="0"
                    Margin="0,0,0,28">
                <StackPanel>

                    <!-- Table Header -->
                    <Border Background="{StaticResource Bg.TableHeader}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="STUDENT"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="1" Text="PROGRAM"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="2" Text="RISK INDEX"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="3" Text="AUTO SCORE"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="4" Text="VER. SCORE"
                                       Style="{StaticResource T.TableHeader}"/>
                            <TextBlock Grid.Column="5" Text="STATUS"
                                       Style="{StaticResource T.TableHeader}"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: J. Doe — Pending -->
                    <Border Style="{StaticResource TableRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="#E2E8F0" Margin="0,0,8,0">
                                    <TextBlock Text="JD"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Text.Secondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="J. Doe"
                                           Style="{StaticResource T.TableCell}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="BSCS"
                                       Style="{StaticResource T.TableCell.Muted}"/>

                            <Border Grid.Column="2" Style="{StaticResource Badge.Success}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Low"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Status.Success}"/>
                            </Border>

                            <TextBlock Grid.Column="3" Text="85 / 100"
                                       Style="{StaticResource T.TableCell}"/>

                            <TextBlock Grid.Column="4" Text="—"
                                       Style="{StaticResource T.TableCell.Muted}"/>

                            <Border Grid.Column="5" Style="{StaticResource Badge.Warning}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Pending Review"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Status.Warning}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 2: A. Smith — Finalized -->
                    <Border Style="{StaticResource TableRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="#E2E8F0" Margin="0,0,8,0">
                                    <TextBlock Text="AS"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Text.Secondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="A. Smith"
                                           Style="{StaticResource T.TableCell}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="BSIT"
                                       Style="{StaticResource T.TableCell.Muted}"/>

                            <Border Grid.Column="2" Style="{StaticResource Badge.Danger}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="High"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Status.Danger}"/>
                            </Border>

                            <TextBlock Grid.Column="3" Text="90 / 100"
                                       Style="{StaticResource T.TableCell}"/>

                            <TextBlock Grid.Column="4" Text="88 / 100"
                                       Style="{StaticResource T.TableCell}"/>

                            <Border Grid.Column="5" Style="{StaticResource Badge.Success}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Finalized"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Status.Success}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 3: placeholder — still taking -->
                    <Border Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="#E2E8F0" Margin="0,0,8,0">
                                    <TextBlock Text="MR"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Text.Secondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="M. Reyes"
                                           Style="{StaticResource T.TableCell}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="BSCS"
                                       Style="{StaticResource T.TableCell.Muted}"/>

                            <Border Grid.Column="2" Style="{StaticResource Badge.Muted}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="—"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Secondary}"/>
                            </Border>

                            <TextBlock Grid.Column="3" Text="—"
                                       Style="{StaticResource T.TableCell.Muted}"/>

                            <TextBlock Grid.Column="4" Text="—"
                                       Style="{StaticResource T.TableCell.Muted}"/>

                            <Border Grid.Column="5" Style="{StaticResource Badge.Muted}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource Accent.Primary}"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="In Progress"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent.Primary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ─────────────────────────────────────────
                 SECTION 3 — AGGREGATE PERFORMANCE METRICS
            ───────────────────────────────────────── -->
            <TextBlock Text="AGGREGATE PERFORMANCE METRICS"
                       Style="{StaticResource T.SectionLabel}"
                       Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Score Distribution -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="Score Distribution"
                                   Style="{StaticResource T.CardTitle}"
                                   Margin="0,0,0,18"/>

                        <!-- Bar: 90–100 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="90 – 100"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Height="22" CornerRadius="3"
                                    Background="{StaticResource Chart.BarBg}"
                                    VerticalAlignment="Center">
                                <Border HorizontalAlignment="Left"
                                        Width="210"
                                        Height="22" CornerRadius="3"
                                        Background="{StaticResource Chart.Bar}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="21"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Bar: 80–89 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="80 – 89"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Height="22" CornerRadius="3"
                                    Background="{StaticResource Chart.BarBg}"
                                    VerticalAlignment="Center">
                                <Border HorizontalAlignment="Left"
                                        Width="140"
                                        Height="22" CornerRadius="3"
                                        Background="{StaticResource Chart.Bar}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="14"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Bar: 70–79 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="70 – 79"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Height="22" CornerRadius="3"
                                    Background="{StaticResource Chart.BarBg}"
                                    VerticalAlignment="Center">
                                <Border HorizontalAlignment="Left"
                                        Width="60"
                                        Height="22" CornerRadius="3"
                                        Background="{StaticResource Chart.Bar}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="6"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Bar: below 70 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Below 70"
                                       FontSize="12"
                                       Foreground="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Height="22" CornerRadius="3"
                                    Background="{StaticResource Chart.BarBg}"
                                    VerticalAlignment="Center">
                                <Border HorizontalAlignment="Left"
                                        Width="20"
                                        Height="22" CornerRadius="3"
                                        Background="#EF5350"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="2"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Status.Danger}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- RIGHT: Top Identified Weaknesses -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="Top Identified Weaknesses"
                                       Style="{StaticResource T.CardTitle}"/>
                            <Border Background="{StaticResource Accent.PrimaryBg}"
                                    BorderBrush="{StaticResource Accent.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="AI Generated"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent.Primary}"/>
                            </Border>
                        </StackPanel>

                        <!-- Weakness 1 -->
                        <Border BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="{StaticResource Status.DangerBg}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="1"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Status.Danger}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Pointer Allocation"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="C Programming"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="{StaticResource Status.DangerBg}"
                                        BorderBrush="{StaticResource Status.Danger}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="6,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="38% fail"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Status.Danger}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Weakness 2 -->
                        <Border BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Padding="0,0,0,12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="22" Height="22"
                                        CornerRadius="11"
                                        Background="{StaticResource Status.WarningBg}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="2"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Status.Warning}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Exception Handling"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text.Primary}"/>
                                    <TextBlock Text="Java"
                                               FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="{StaticResource Status.WarningBg}"
                                        BorderBrush="{StaticResource Status.Warning}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="6,3"
