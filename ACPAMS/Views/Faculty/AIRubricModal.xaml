<Window x:Class="ACPAMS.Views.Faculty.AIRubricModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure AI Rubric"
        Width="780" Height="680"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ═══════════════════════════════
             DESIGN TOKENS (matches system)
        ═══════════════════════════════ -->
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Canvas"        Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="AI.Text"          Color="#5B21B6"/>
        <SolidColorBrush x:Key="AI.Bg"            Color="#F5F3FF"/>
        <SolidColorBrush x:Key="AI.Border"        Color="#7C3AED"/>
        <SolidColorBrush x:Key="AI.HeaderBg"      Color="#EDE9FE"/>

        <!-- Rubric tier colors — signature design element -->
        <SolidColorBrush x:Key="Tier.Excellent.Bg"     Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Tier.Excellent.Border" Color="#15803D"/>
        <SolidColorBrush x:Key="Tier.Excellent.Text"   Color="#14532D"/>
        <SolidColorBrush x:Key="Tier.Good.Bg"          Color="#DBEAFE"/>
        <SolidColorBrush x:Key="Tier.Good.Border"      Color="#1976D2"/>
        <SolidColorBrush x:Key="Tier.Good.Text"        Color="#1E3A5F"/>
        <SolidColorBrush x:Key="Tier.Poor.Bg"          Color="#FEE2E2"/>
        <SolidColorBrush x:Key="Tier.Poor.Border"      Color="#C62828"/>
        <SolidColorBrush x:Key="Tier.Poor.Text"        Color="#7F1D1D"/>

        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="Overlay.Bg"       Color="#1A202C"/>

        <!-- ═══════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════ -->
        <Style x:Key="T.SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}"/>
        </Style>

        <Style x:Key="T.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ═══════════════════════════════
             INPUTS
        ═══════════════════════════════ -->
        <Style x:Key="Input.Text" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn"            Value="True"/>
            <Setter Property="TextWrapping"             Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cell input — flat, no border until focused -->
        <Style x:Key="Input.Cell" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn"            Value="True"/>
            <Setter Property="TextWrapping"             Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="CellBg" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="CellBg" Property="Background"
                                        Value="{StaticResource Bg.Surface}"/>
                                <Setter TargetName="CellBg" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Criteria cell — slightly bolder -->
        <Style x:Key="Input.CriteriaCell" TargetType="TextBox"
               BasedOn="{StaticResource Input.Cell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <!-- ═══════════════════════════════
             BUTTONS
        ═══════════════════════════════ -->
        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Outlined" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Ghost" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scope radio toggle card -->
        <Style x:Key="Btn.ScopeToggle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Bg.Base}"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.ScopeToggle.Active" TargetType="Button"
               BasedOn="{StaticResource Btn.ScopeToggle}">
            <Setter Property="Background"  Value="{StaticResource Accent.PrimaryBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"  Value="{StaticResource Accent.Primary}"/>
        </Style>

        <!-- Close button -->
        <Style x:Key="Btn.Close" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton reset — visual handled by scope toggle buttons above -->
        <Style TargetType="RadioButton">
            <Setter Property="Margin"     Value="0"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════
         SCRIM OVERLAY — semi-transparent backdrop
    ═══════════════════════════════════════════════ -->
    <Grid>
        <Border Background="{StaticResource Overlay.Bg}" Opacity="0.45"/>

        <!-- ═══════════════════════════════════════════
             MODAL CARD
        ═══════════════════════════════════════════ -->
        <Border Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1"
                CornerRadius="10"
                Width="740"
                MaxHeight="640"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="#1A202C" Opacity="0.18"
                                  BlurRadius="32" ShadowDepth="8"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Modal header -->
                    <RowDefinition Height="*"/>     <!-- Scrollable body -->
                    <RowDefinition Height="Auto"/>  <!-- Footer actions -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════
                     MODAL HEADER
                ══════════════════════════ -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="24,16,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- AI badge eyebrow -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="{StaticResource AI.Bg}"
                                        BorderBrush="{StaticResource AI.Border}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="7,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{StaticResource AI.Border}"
                                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="AI Auto-Grading"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource AI.Text}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Configure AI Rubric"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       Margin="0,0,0,2"/>
                            <!-- Context line — back-end populates this from question context -->
                            <TextBlock FontSize="12" Foreground="{StaticResource Text.Muted}">
                                <Run Text="Scope for:"/>
                                <Run Text=" Test II — Coding (Java)"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource Text.Secondary}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Close button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource Btn.Close}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Text.Secondary}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ══════════════════════════
                     SCROLLABLE BODY
                ══════════════════════════ -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource Bg.Canvas}">
                    <StackPanel Margin="24,20,24,8">

                        <!-- SECTION 1: SCOPE -->
                        <TextBlock Text="RUBRIC SCOPE"
                                   Style="{StaticResource T.SectionLabel}"
                                   Margin="0,0,0,10"/>
                        <Border Background="{StaticResource Bg.Surface}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16,14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Apply this rubric to:"
                                           Style="{StaticResource T.FieldLabel}"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Single Question — unselected -->
                                    <Button Style="{StaticResource Btn.ScopeToggle}"
                                            Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14"
                                                     Stroke="{StaticResource Border.Medium}"
                                                     Fill="Transparent"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="This question only"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Entire Section — selected -->
                                    <Button Style="{StaticResource Btn.ScopeToggle.Active}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="14" Height="14"
                                                  Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse Width="14" Height="14"
                                                         Stroke="{StaticResource Accent.Primary}"
                                                         Fill="Transparent"/>
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{StaticResource Accent.Primary}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="Entire test section"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent.Primary}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           Text="Selecting 'Entire test section' applies this rubric as the default for all questions in Test II."/>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: AI PROMPT -->
                        <TextBlock Text="AI ENGINE INSTRUCTIONS"
                                   Style="{StaticResource T.SectionLabel}"
                                   Margin="0,0,0,10"/>
                        <Border Background="{StaticResource Bg.Surface}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16,14" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE9D2;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{StaticResource AI.Border}"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource T.FieldLabel}"
                                               Text="Grading Instructions / AI Prompt"
                                               Margin="0"/>
                                </StackPanel>
                                <TextBox Style="{StaticResource Input.Text}"
                                         Height="80"
                                         Text="Evaluate strictly on logical correctness and algorithmic efficiency. Ignore minor syntax warnings or stylistic differences. Partial credit is allowed for correct approach with implementation errors."/>
                                <TextBlock Margin="0,6,0,0" FontSize="11"
                                           Foreground="{StaticResource Text.Muted}"
                                           Text="These instructions are sent verbatim to the AI grading engine as part of the evaluation context."/>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: RUBRIC MATRIX -->
                        <TextBlock Text="RUBRIC MATRIX"
                                   Style="{StaticResource T.SectionLabel}"
                                   Margin="0,0,0,10"/>
                        <Border Background="{StaticResource Bg.Surface}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="8"
                                Margin="0,0,0,8">
                            <StackPanel>

                                <!-- Matrix hint -->
                                <Border BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="0,0,0,1" Padding="16,10">
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource Text.Muted}"
                                               Text="Click any cell to edit. Column headers define each scoring tier. Point values per tier are set in the header row."/>
                                </Border>

                                <!-- ── MATRIX TABLE ── -->
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>   <!-- Criteria -->
                                        <ColumnDefinition Width="*"/>     <!-- Excellent -->
                                        <ColumnDefinition Width="*"/>     <!-- Good -->
                                        <ColumnDefinition Width="*"/>     <!-- Poor -->
                                        <ColumnDefinition Width="36"/>    <!-- Delete row -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- Column headers -->
                                        <RowDefinition Height="Auto"/>  <!-- Row 1 -->
                                        <RowDefinition Height="Auto"/>  <!-- Row 2 -->
                                        <RowDefinition Height="Auto"/>  <!-- Row 3 -->
                                    </Grid.RowDefinitions>

                                    <!-- ── HEADER ROW ── -->
                                    <!-- Criteria header -->
                                    <Border Grid.Row="0" Grid.Column="0"
                                            Background="{StaticResource Bg.Base}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1" Padding="12,10">
                                        <TextBlock Text="Criteria"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Text.Secondary}"/>
                                    </Border>

                                    <!-- Excellent header — green -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="{StaticResource Tier.Excellent.Bg}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1" Padding="12,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,2">
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        Background="{StaticResource Tier.Excellent.Border}"
                                                        Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Excellent"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource Tier.Excellent.Text}"/>
                                            </StackPanel>
                                            <TextBlock Text="3 pts"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Tier.Excellent.Border}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Good header — blue -->
                                    <Border Grid.Row="0" Grid.Column="2"
                                            Background="{StaticResource Tier.Good.Bg}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1" Padding="12,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,2">
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        Background="{StaticResource Tier.Good.Border}"
                                                        Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Good"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource Tier.Good.Text}"/>
                                            </StackPanel>
                                            <TextBlock Text="2 pts"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Tier.Good.Border}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Poor header — red -->
                                    <Border Grid.Row="0" Grid.Column="3"
                                            Background="{StaticResource Tier.Poor.Bg}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1" Padding="12,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,2">
                                                <Border Width="8" Height="8" CornerRadius="4"
                                                        Background="{StaticResource Tier.Poor.Border}"
                                                        Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Poor"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource Tier.Poor.Text}"/>
                                            </StackPanel>
                                            <TextBlock Text="1 pt"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Tier.Poor.Border}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Delete column header (empty) -->
                                    <Border Grid.Row="0" Grid.Column="4"
                                            Background="{StaticResource Bg.Base}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,0,1"/>

                                    <!-- ── DATA ROW 1: Efficiency ── -->
                                    <Border Grid.Row="1" Grid.Column="0"
                                            Background="{StaticResource Bg.Base}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1">
                                        <TextBox Style="{StaticResource Input.CriteriaCell}"
                                                 MinHeight="52"
                                                 Text="Efficiency"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="O(n) time complexity or better"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="O(n²) complexity; runs correctly"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="3"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="Fails to run or infinite loop"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="4"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,0,1"
                                            Background="{StaticResource Bg.Base}">
                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="28" Height="28">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="#CBD5E1"/>
                                        </Button>
                                    </Border>

                                    <!-- ── DATA ROW 2: Naming Convention ── -->
                                    <Border Grid.Row="2" Grid.Column="0"
                                            Background="{StaticResource Bg.Base}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1">
                                        <TextBox Style="{StaticResource Input.CriteriaCell}"
                                                 MinHeight="52"
                                                 Text="Naming Convention"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="camelCase used consistently throughout"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="2"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="Mostly correct with some inconsistencies"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="3"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,1">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="Unreadable or single-letter names"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="4"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,0,1"
                                            Background="{StaticResource Bg.Base}">
                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="28" Height="28">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="#CBD5E1"/>
                                        </Button>
                                    </Border>

                                    <!-- ── DATA ROW 3: Edge Case Handling ── -->
                                    <Border Grid.Row="3" Grid.Column="0"
                                            Background="{StaticResource Bg.Base}"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,0">
                                        <TextBox Style="{StaticResource Input.CriteriaCell}"
                                                 MinHeight="52"
                                                 Text="Edge Case Handling"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="1"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,0">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="Handles null, empty, and negative inputs correctly"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="2"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,0">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="Handles some but not all edge cases"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="3"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,1,0">
                                        <TextBox Style="{StaticResource Input.Cell}"
                                                 MinHeight="52"
                                                 Text="No edge case handling; crashes on null"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="4"
                                            Background="{StaticResource Bg.Base}">
                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="28" Height="28">
                                            <TextBlock Text="&#xE74D;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="#CBD5E1"/>
                                        </Button>
                                    </Border>

                                </Grid>

                                <!-- Add Row / Add Column -->
                                <Border BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="0,1,0,0" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Margin="0,0,5,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Accent.Primary}"/>
                                                <TextBlock Text="Add Row"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Ghost}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Margin="0,0,5,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Accent.Primary}"/>
                                                <TextBlock Text="Add Column"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>

                        <!-- Total possible score summary -->
                        <Border Background="{StaticResource Accent.PrimaryBg}"
                                BorderBrush="{StaticResource Accent.Primary}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="14,10" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource Accent.Primary}"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource Accent.Primary}">
                                    <Run Text="Maximum rubric score:"/>
                                    <Run Text=" 9 pts" FontWeight="Bold"/>
                                    <Run Text="  (3 criteria × 3 pts each) — AI will normalize to the question's assigned points."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 4: REFERENCE MATERIALS -->
                        <TextBlock Text="REFERENCE MATERIALS (OPTIONAL)"
                                   Style="{StaticResource T.SectionLabel}"
                                   Margin="0,0,0,10"/>
                        <Border Background="{StaticResource Bg.Surface}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1" CornerRadius="8"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Drop zone -->
                                <Grid Margin="14" MinHeight="110">
                                    <!-- Dashed border via Rectangle StrokeDashArray (WPF-safe) -->
                                    <Rectangle RadiusX="6" RadiusY="6"
                                               Stroke="#CBD5E1" StrokeThickness="1.5"
                                               StrokeDashArray="4,3"
                                               Fill="{StaticResource Bg.Canvas}"/>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,20">
                                        <!-- Upload icon -->
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{StaticResource Accent.PrimaryBg}"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10">
                                            <TextBlock Text="&#xE896;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                       Foreground="{StaticResource Accent.Primary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   Text="Drag &amp; drop your rubric file here"/>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,4,0,10"
                                                   Text="Supports PDF, PPTX, DOCX, PNG — max 10 MB"/>
                                        <Button Style="{StaticResource Btn.Ghost}"
                                                HorizontalAlignment="Center"
                                                Foreground="{StaticResource Accent.Primary}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEC50;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Browse files"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Uploaded file chip (shown after upload — static sample) -->
                                <Border Margin="14,0,14,14"
                                        Background="{StaticResource Status.SuccessBg}"
                                        BorderBrush="{StaticResource Status.Success}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xEA90;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{StaticResource Status.Success}"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="CS101_Rubric_Coding.pdf"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text.Primary}"/>
                                            <TextBlock Text="248 KB · Uploaded"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Status.Success}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource Btn.Ghost}"
                                                Padding="4" Foreground="#94A3B8">
                                            <TextBlock Text="&#xE711;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════════════════════
                     FOOTER ACTIONS
                ══════════════════════════ -->
                <Border Grid.Row="2"
                        Background="{StaticResource Bg.Surface}"
                        BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: rubric status note -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource Text.Muted}"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Rubric will be sent to the AI engine on each submission for this section."
                                       FontSize="11" Foreground="{StaticResource Text.Muted}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right: Cancel + Save -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Outlined}"
                                    Content="Cancel" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource Btn.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72D;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="White"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Save &amp; Attach Rubric"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
