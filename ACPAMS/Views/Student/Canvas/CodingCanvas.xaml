<UserControl x:Class="ACPAMS.Views.Student.Canvas.CodingCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             Background="#F8FAFC"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Bg.Code"          Color="#1E293B"/>
        <SolidColorBrush x:Key="Bg.CodeHeader"    Color="#0F172A"/>
        <SolidColorBrush x:Key="Bg.Output"        Color="#0D1117"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="QType.Coding"     Color="#15803D"/>
        <SolidColorBrush x:Key="QType.CodingBg"   Color="#DCFCE7"/>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Ghost" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown-style language picker button -->
        <Style x:Key="Btn.LangSelect" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Bg.Base}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="3*"/>
            <!-- IDE editor — takes 3x space -->
            <RowDefinition Height="*"/>
            <!-- Output panel — takes 1x space -->
            <RowDefinition Height="Auto"/>
            <!-- Run button -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: question badge + language selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{StaticResource QType.CodingBg}"
                            BorderBrush="{StaticResource QType.Coding}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="8,3" Margin="0,0,12,0">
                        <TextBlock Text="Coding" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource QType.Coding}"/>
                    </Border>
                    <TextBlock Text="Language:" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Real language ComboBox -->
                    <ComboBox x:Name="LanguageSelector"
                              Width="110" Height="30"
                              FontSize="12" FontWeight="SemiBold"
                              SelectionChanged="LanguageSelector_SelectionChanged">
                        <ComboBoxItem Content="Java"   Tag="Java"/>
                        <ComboBoxItem Content="Python" Tag="Python"/>
                        <ComboBoxItem Content="C"      Tag="C"/>
                    </ComboBox>
                </StackPanel>

                <!-- Right: View Question button -->
                <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}"
                        Click="ViewQuestionBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A4;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Margin="0,0,6,0"
                                   Foreground="{StaticResource Accent.Primary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="View Question" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Question text strip — collapsed by default, toggled by View Question -->
        <Border x:Name="QuestionStrip"
                Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="20,52,20,16"
                Visibility="Collapsed"
                Panel.ZIndex="5">
            <Grid>
                <TextBlock x:Name="QuestionText"
                           TextWrapping="Wrap" FontSize="14" LineHeight="22"
                           Foreground="{StaticResource Text.Primary}"
                           Margin="0,0,40,0"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseQuestionBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── EMBEDDED IDE ── -->
        <Border Grid.Row="1"
                Background="{StaticResource Bg.Code}"
                BorderBrush="#334155"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- IDE chrome bar -->
                    <RowDefinition Height="*"/>
                    <!-- Code area -->
                </Grid.RowDefinitions>

                <!-- IDE chrome bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource Bg.CodeHeader}"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Traffic lights -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Width="11" Height="11" CornerRadius="6"
                                    Background="#EF4444" Margin="0,0,6,0"/>
                            <Border Width="11" Height="11" CornerRadius="6"
                                    Background="#F59E0B" Margin="0,0,6,0"/>
                            <Border Width="11" Height="11" CornerRadius="6"
                                    Background="#22C55E"/>
                        </StackPanel>
                        <!-- File tab -->
                        <Border Grid.Column="1"
                                Background="#1E293B" CornerRadius="4"
                                Padding="12,4" Margin="12,0,0,0"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#64748B"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FileNameText"
                                           Text="Main.java"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                        <!-- Line/Col indicator -->
                        <TextBlock x:Name="LineColText"
                                   Grid.Column="2"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="#475569" Text="Ln 1, Col 1"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- AvalonEdit gives real syntax highlighting + built-in
                     line numbers, replacing the manual TextBox + line
                     number ScrollViewer approach. Foreground/line-number
                     colors match the VS Code Dark+ palette used in the
                     custom .xshd highlighting definitions. -->
                <avalonEdit:TextEditor
                    x:Name="CodeEditor"
                    Grid.Row="1"
                    Margin="0,12,0,12"
                    FontFamily="Consolas"
                    FontSize="13"
                    ShowLineNumbers="True"
                    Background="{StaticResource Bg.Code}"
                    Foreground="#D4D4D4"
                    LineNumbersForeground="#5A6374"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    TextChanged="CodeEditor_TextChanged"/>
            </Grid>
        </Border>

        <!-- Output panel -->
        <Border x:Name="OutputPanel"
        Grid.Row="2"
        Background="{StaticResource Bg.Output}"
        BorderBrush="#1E293B"
        BorderThickness="0,2,0,0"
        MinHeight="80" MaxHeight="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                   Text="OUTPUT"
                   FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                   Foreground="#475569" Margin="14,10,14,4"/>

                <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Margin="14,0,14,10">
                    <StackPanel>
                        <TextBlock x:Name="OutputCommandText"
                           FontFamily="Consolas" FontSize="13">
                    <Run Foreground="#22C55E">$</Run>
                    <Run Foreground="#94A3B8" Text=" Click Run Code to execute"/>
                        </TextBlock>
                        <TextBlock x:Name="OutputResultText"
                           FontFamily="Consolas" FontSize="13"
                           Foreground="#E2E8F0" Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text=""/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        
        <!-- Run Code button -->
        <Border Grid.Row="3"
                Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Button Style="{StaticResource Btn.Primary}"
                    HorizontalAlignment="Left"
                    Click="RunCodeBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="White"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Run Code" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>

    </Grid>
</UserControl>
