<UserControl x:Class="ACPAMS.Views.Student.Canvas.TextInputCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="QType.Ident"      Color="#64748B"/>

        <Style x:Key="Input.Answer" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="14,12"/>
            <Setter Property="AcceptsReturn"            Value="True"/>
            <Setter Property="TextWrapping"             Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                                <Setter TargetName="Root" Property="BorderThickness"
                                        Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,20">

            <!-- Question header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Background="{StaticResource Bg.Base}"
                        BorderBrush="{StaticResource QType.Ident}"
                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                        Margin="0,0,10,0">
                    <TextBlock x:Name="TypeBadgeText" Text="Identification" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource QType.Ident}"/>
                </Border>
                <Border Background="{StaticResource Accent.PrimaryBg}"
                        BorderBrush="{StaticResource Accent.Primary}"
                        BorderThickness="1" CornerRadius="4" Padding="8,3">
                    <TextBlock x:Name="PointsText" Text="5 pts" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Accent.Primary}"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="QuestionNumberText" Text="Question 1 of 5"
                       FontSize="11" Foreground="{StaticResource Text.Muted}"
                       Margin="0,0,0,10"/>

            <!-- Divider -->
            <Border Height="1" Background="{StaticResource Border.Subtle}"
                    Margin="0,0,0,16"/>

            <!-- Question text -->
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,24"
                       x:Name="QuestionText"
                       FontSize="16" LineHeight="26"
                       Foreground="{StaticResource Text.Primary}"/>

            <!-- Answer input -->
            <TextBlock Text="YOUR ANSWER"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource Text.Muted}"
                       Margin="0,0,0,8"/>
            <TextBox x:Name="AnswerBox" Style="{StaticResource Input.Answer}"
                     Height="200"
                     Text=""/>

            <!-- Word count hint -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,6,0,0">
                <TextBlock x:Name="WordCountText" Text="0 words" FontSize="11"
                           Foreground="{StaticResource Text.Muted}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
