<UserControl x:Class="ACPAMS.Views.Student.Canvas.OptionSelectorCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Bg.Base"          Color="#F4F5F7"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="QType.MCQ"        Color="#1976D2"/>

        <!-- Option card — unselected -->
        <Style x:Key="Btn.Option" TargetType="Button">
            <Setter Property="Background"                 Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"                Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="Padding"                    Value="16,14"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin"                     Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource Accent.PrimaryBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Option card — selected -->
        <Style x:Key="Btn.Option.Selected" TargetType="Button"
               BasedOn="{StaticResource Btn.Option}">
            <Setter Property="Background"  Value="{StaticResource Accent.PrimaryBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource Accent.PrimaryBg}"
                                BorderBrush="{StaticResource Accent.Primary}"
                                BorderThickness="2" CornerRadius="8"
                                Padding="16,14">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,20">

            <!-- Question header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Background="{StaticResource Accent.PrimaryBg}"
                        BorderBrush="{StaticResource QType.MCQ}"
                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                        Margin="0,0,10,0">
                    <TextBlock Text="Multiple Choice" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource QType.MCQ}"/>
                </Border>
                <Border Background="{StaticResource Accent.PrimaryBg}"
                        BorderBrush="{StaticResource Accent.Primary}"
                        BorderThickness="1" CornerRadius="4" Padding="8,3">
                    <TextBlock Text="3 pts" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Accent.Primary}"/>
                </Border>
            </StackPanel>

            <TextBlock Text="Question 3 of 10"
                       FontSize="11" Foreground="{StaticResource Text.Muted}"
                       Margin="0,0,0,10"/>

            <Border Height="1" Background="{StaticResource Border.Subtle}"
                    Margin="0,0,0,16"/>

            <!-- Question text -->
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,28"
                       FontSize="16" LineHeight="26"
                       Foreground="{StaticResource Text.Primary}"
                       Text="Which of the following sorting algorithms has the best average-case time complexity?"/>

            <!-- Options -->
            <TextBlock Text="SELECT ONE ANSWER"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource Text.Muted}"
                       Margin="0,0,0,12"/>

            <!-- Option A — unselected -->
            <Button Style="{StaticResource Btn.Option}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Radio circle -->
                    <Ellipse Grid.Column="0" Width="18" Height="18"
                             Stroke="{StaticResource Border.Medium}"
                             Fill="Transparent" Margin="0,0,14,0"
                             VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,0,0,2" Text="A"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Text.Primary}"
                                   Text="Bubble Sort"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Option B — unselected -->
            <Button Style="{StaticResource Btn.Option}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="18" Height="18"
                             Stroke="{StaticResource Border.Medium}"
                             Fill="Transparent" Margin="0,0,14,0"
                             VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,0,0,2" Text="B"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Text.Primary}"
                                   Text="Insertion Sort"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Option C — SELECTED -->
            <Button Style="{StaticResource Btn.Option.Selected}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Filled radio -->
                    <Grid Grid.Column="0" Width="18" Height="18"
                          Margin="0,0,14,0" VerticalAlignment="Center">
                        <Ellipse Width="18" Height="18"
                                 Stroke="{StaticResource Accent.Primary}" Fill="Transparent"/>
                        <Ellipse Width="9" Height="9"
                                 Fill="{StaticResource Accent.Primary}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Accent.Primary}"
                                   Margin="0,0,0,2" Text="C"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent.Primary}"
                                   Text="Merge Sort"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Option D — unselected -->
            <Button Style="{StaticResource Btn.Option}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="18" Height="18"
                             Stroke="{StaticResource Border.Medium}"
                             Fill="Transparent" Margin="0,0,14,0"
                             VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Muted}"
                                   Margin="0,0,0,2" Text="D"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource Text.Primary}"
                                   Text="Selection Sort"/>
                    </StackPanel>
                </Grid>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
