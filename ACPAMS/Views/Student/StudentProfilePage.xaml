<UserControl x:Class="ACPAMS.Views.Student.StudentProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EEF2F7"
      FontFamily="Segoe UI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Success.Bg"       Color="#ECFDF5"/>
        <SolidColorBrush x:Key="Success.Border"   Color="#6EE7B7"/>
        <SolidColorBrush x:Key="Success.Text"     Color="#065F46"/>

        <Style x:Key="Input.Readonly" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="#F8FAFC"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"               Value="True"/>
        </Style>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Secondary" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Text.Secondary}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Back" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#EEF2F7">
        <Border Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1" CornerRadius="12"
                Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                Margin="0,20">
            <Border.Effect>
                <DropShadowEffect Color="#94A3B8" Opacity="0.18" BlurRadius="32" ShadowDepth="6"/>
            </Border.Effect>

            <StackPanel Margin="32,24,32,28">

                <!-- Header with Back Button -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Btn.Back}" Click="BackBtn_Click" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Text.Secondary}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Back" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Student Profile" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="Manage your student account settings" FontSize="11" Foreground="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Border.Subtle}" Margin="0,0,0,16"/>

                <!-- Inline Success Banner -->
                <Border x:Name="SuccessCard" Background="{StaticResource Success.Bg}" BorderBrush="{StaticResource Success.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource Success.Text}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SuccessMessageText" FontSize="12" Foreground="{StaticResource Success.Text}"
                                   Text="Year level updated successfully!" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Student ID (Read-only) -->
                <TextBlock Text="Student ID" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                <Border Background="#F8FAFC" BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1" CornerRadius="6" Height="38" Margin="0,0,0,12">
                    <TextBox x:Name="StudentIdBox" Style="{StaticResource Input.Readonly}" FontFamily="Consolas"/>
                </Border>

                <!-- Full Name (Read-only) -->
                <TextBlock Text="Full Name" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                <Border Background="#F8FAFC" BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1" CornerRadius="6" Height="38" Margin="0,0,0,12">
                    <TextBox x:Name="FullNameBox" Style="{StaticResource Input.Readonly}"/>
                </Border>

                <!-- Program (Read-only) -->
                <TextBlock Text="Program" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                <Border Background="#F8FAFC" BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1" CornerRadius="6" Height="38" Margin="0,0,0,12">
                    <TextBox x:Name="ProgramBox" Style="{StaticResource Input.Readonly}"/>
                </Border>

                <!-- Year Level (Editable) -->
                <TextBlock Text="Year Level" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                <Border Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Medium}"
                        BorderThickness="1" CornerRadius="6" Height="38" Margin="0,0,0,20">
                    <ComboBox x:Name="YearLevelBox" Background="Transparent" BorderThickness="0"
                              Padding="10,0" VerticalContentAlignment="Center"
                              FontFamily="Segoe UI" FontSize="13">
                        <ComboBoxItem Content="1st Year"/>
                        <ComboBoxItem Content="2nd Year"/>
                        <ComboBoxItem Content="3rd Year"/>
                        <ComboBoxItem Content="4th Year"/>
                    </ComboBox>
                </Border>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource Btn.Secondary}" Content="Cancel" Click="BackBtn_Click"/>
                    <Button Grid.Column="2" x:Name="SaveBtn" Style="{StaticResource Btn.Primary}" Content="Save Changes" Click="SaveBtn_Click"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
