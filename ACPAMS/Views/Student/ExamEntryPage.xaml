<Window x:Class="ACPAMS.Views.Student.ExamEntryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACPAMS — Enter Exam Code"
        Width="480" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#EEF2F7"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg.Window"        Color="#EEF2F7"/>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Border.Medium"    Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent.Primary"   Color="#1976D2"/>
        <SolidColorBrush x:Key="Accent.PrimaryBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#15803D"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>

        <!-- Exam code input — monospace, prominent -->
        <Style x:Key="Input.ExamCode" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="Consolas"/>
            <Setter Property="FontSize"                 Value="16"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Foreground"               Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background"               Value="{StaticResource Bg.Surface}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource Border.Medium}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="14,12"/>
            <Setter Property="Height"                   Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{StaticResource Accent.Primary}"/>
                                <Setter TargetName="Root" Property="BorderThickness"
                                        Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn.Primary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent.Primary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg.Window}">
        <Border Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1" CornerRadius="12"
                Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#94A3B8" Opacity="0.18"
                                  BlurRadius="32" ShadowDepth="6"/>
            </Border.Effect>

            <StackPanel Margin="36,32,36,32">

                <!-- Brand mark -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="36" Height="36" Background="#1A202C"
                            CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ACPAMS" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Greeting — back-end binds student first name -->
                <TextBlock FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Text.Primary}"
                           Margin="0,0,0,4">
                    <Run Text="Welcome, "/>
                    <Run x:Name="StudentNameRun"
                         Text="Jane"
                         Foreground="{StaticResource Accent.Primary}"/>
                    <Run Text="!"/>
                </TextBlock>
                <TextBlock Text="Please enter the exam code provided by your instructor."
                           FontSize="13" Foreground="{StaticResource Text.Muted}"
                           TextWrapping="Wrap" Margin="0,0,0,24"/>

                <!-- Exam code field -->
                <TextBlock Text="Examination Code" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Secondary}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="ExamCodeBox"
                         Style="{StaticResource Input.ExamCode}"
                         Margin="0,0,0,20"/>

                <!-- Proceed button -->
                <Button Style="{StaticResource Btn.Primary}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="White"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Proceed to Exam" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource Border.Subtle}"
                        Margin="0,0,0,20"/>

                <!-- Good luck note -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="{StaticResource Text.Muted}"
                               Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Good luck with your examination!"
                               FontSize="13" FontStyle="Italic"
                               Foreground="{StaticResource Text.Muted}"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
