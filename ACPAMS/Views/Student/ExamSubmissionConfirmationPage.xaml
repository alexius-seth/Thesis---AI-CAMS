<UserControl x:Class="ACPAMS.Views.Student.ExamSubmissionConfirmationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF2F7"
             FontFamily="Segoe UI"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border.Subtle"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Text.Primary"     Color="#1A202C"/>
        <SolidColorBrush x:Key="Text.Secondary"   Color="#64748B"/>
        <SolidColorBrush x:Key="Text.Muted"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="Status.Success"   Color="#16A34A"/>
        <SolidColorBrush x:Key="Status.SuccessBg" Color="#DCFCE7"/>
    </UserControl.Resources>

    <Grid Background="#EEF2F7">
        <Border Background="{StaticResource Bg.Surface}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="1" CornerRadius="12"
                Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#94A3B8" Opacity="0.18" BlurRadius="32" ShadowDepth="6"/>
            </Border.Effect>

            <StackPanel Margin="36,36,36,36" HorizontalAlignment="Stretch">
                <Border Width="64" Height="64" Background="{StaticResource Status.SuccessBg}"
                        CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="✓" FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource Status.Success}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Exam Submitted Successfully"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Text.Primary}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Your answers have been submitted successfully."
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Status.Success}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Text="Your responses have been recorded and saved."
                           FontSize="13" Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Text="Thank you for completing the examination."
                           FontSize="13" Foreground="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,24"/>

                <Border Background="#F8FAFC" BorderBrush="{StaticResource Border.Subtle}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⏱" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CountdownText"
                                   Text="Redirecting to login in 5 seconds..."
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
