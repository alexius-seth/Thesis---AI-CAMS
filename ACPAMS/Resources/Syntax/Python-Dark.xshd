<?xml version="1.0"?>
<SyntaxDefinition name="Python" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <Color name="Comment"      foreground="#6A9955" />
  <Color name="String"       foreground="#CE9178" />
  <Color name="Number"       foreground="#B5CEA8" />
  <Color name="Keyword"      foreground="#569CD6" fontWeight="bold" />
  <Color name="ControlFlow"  foreground="#C586C0" fontWeight="bold" />
  <Color name="Type"         foreground="#4EC9B0" />
  <Color name="Method"       foreground="#DCDCAA" />
  <Color name="Decorator"    foreground="#DCDCAA" />
  <Color name="SelfParam"    foreground="#9CDCFE" fontStyle="italic" />

  <RuleSet>
    <Span color="Comment" begin="#" />

    <!-- Triple-quoted strings (docstrings) -->
    <Span color="String" multiline="true">
      <Begin>"""</Begin>
      <End>"""</End>
    </Span>
    <Span color="String" multiline="true">
      <Begin>'''</Begin>
      <End>'''</End>
    </Span>

    <Span color="String">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>

    <Rule color="Decorator">
      @\w+
    </Rule>

    <Rule color="Number">
      \b0[xX][0-9a-fA-F]+|\b\d+(\.\d+)?([eE][+-]?\d+)?[jJ]?\b
    </Rule>

    <Rule color="SelfParam">
      \bself\b
    </Rule>

    <!-- Function/method calls: word immediately followed by ( -->
    <Rule color="Method">
      \b[a-zA-Z_]\w*(?=\s*\()
    </Rule>

    <Keywords color="ControlFlow">
      <Word>if</Word>
      <Word>elif</Word>
      <Word>else</Word>
      <Word>for</Word>
      <Word>while</Word>
      <Word>break</Word>
      <Word>continue</Word>
      <Word>return</Word>
      <Word>yield</Word>
      <Word>try</Word>
      <Word>except</Word>
      <Word>finally</Word>
      <Word>raise</Word>
      <Word>with</Word>
      <Word>pass</Word>
      <Word>assert</Word>
    </Keywords>

    <Keywords color="Type">
      <Word>int</Word>
      <Word>float</Word>
      <Word>str</Word>
      <Word>bool</Word>
      <Word>list</Word>
      <Word>dict</Word>
      <Word>set</Word>
      <Word>tuple</Word>
      <Word>bytes</Word>
      <Word>object</Word>
      <Word>type</Word>
    </Keywords>

    <Keywords color="Keyword">
      <Word>def</Word>
      <Word>class</Word>
      <Word>import</Word>
      <Word>from</Word>
      <Word>as</Word>
      <Word>lambda</Word>
      <Word>global</Word>
      <Word>nonlocal</Word>
      <Word>in</Word>
      <Word>is</Word>
      <Word>not</Word>
      <Word>and</Word>
      <Word>or</Word>
      <Word>None</Word>
      <Word>True</Word>
      <Word>False</Word>
      <Word>async</Word>
      <Word>await</Word>
      <Word>del</Word>
    </Keywords>

  </RuleSet>
</SyntaxDefinition>
